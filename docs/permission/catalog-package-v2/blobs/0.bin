    "/v1/bot/docs/{docId}/ppt/media/{attachId}": {
      "get": {
        "operationId": "docs.ppt.media.get",
        "summary": "Download one PPT media attachment's bytes (reader or higher, html_ppt only)",
        "description": "Returns the stored bytes of a document-owned ppt-media: attachment (image, audio or video) with Content-Disposition: attachment and the stored MIME type. Pass --output <path> to save the bytes. With --metadata 1 the backend instead returns a {data:{mime,sizeBytes}} JSON envelope. The target must be an html_ppt document (otherwise UNSUPPORTED_DOCUMENT_TYPE); unknown or foreign attachIds return NOT_FOUND. Authorization is re-checked after the object read, and a permission change in between fails with FORBIDDEN. Errors use the PPT {error} envelope.",
        "x-octo-risk": "read",
        "x-octo-binary-response": true,
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "attachId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "attachId returned by the PPT media upload or attachments ingest (ref ppt-media:<attachId>)"
          },
          {
            "name": "metadata",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "set to 1 to return {data:{mime,sizeBytes}} JSON instead of the media bytes"
          }
        ],
        "responses": {
          "200": {
            "description": "Media bytes (Content-Type is the stored media MIME type)",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/invites/{inviteToken}/accept": {
      "post": {
        "operationId": "docs.invites.accept",
        "summary": "Accept a document link invite as the bot itself",
        "description": "Grants the calling bot the invite's role on the invited document through the same accept transaction as the human flow (doc_member row with source=invite). The bot route does not restrict the document to the bot's own Space. Invalid, revoked, expired or exhausted invites, and invites whose document is missing or deleted, all return 410 invite_invalid. The bot route passes no home Space, so the 404 not_found branch of the shared accept transaction is never reached here.",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          {
            "name": "inviteToken",
            "in": "path",
            "required": true,
