    "/docs-html/v1/docs/{doc_id}/source": {
      "get": {
        "operationId": "html.source",
        "summary": "Read stored HTML and its version together (needs reader)",
        "description": "Read the latest published source by default, or select a fixed version. Returns slug, version and full stored HTML from the same read, without the viewer overlay. Retain data.html with data.version, edit that HTML, then publish with version set to the saved version plus one. On version_conflict, read again and reapply the edit; never only increase version and resend stale HTML. Requires octo-docs-html MR !34 to be deployed. Rollout is backend first: deploy and verify octo-docs-html#34 on every HTML-serving instance before releasing this CLI workflow. A route-level 404 while html get can read the same reference means the source endpoint is unavailable, not that the document is missing; stop and check deployment/routing. Do not infer the source version from metadata, create a replacement document, or fall back to versionless publishing.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "description": "Document reference returned as data.slug: canonical doc_id for a new document, or the retained legacy slug for an old document.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "description": "Positive published version to read; omit for latest.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored source and its matching version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "slug",
                    "version",
                    "html"
                  ],
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "html": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs-html/v1/docs/{doc_id}/versions/{version}/source": {
      "get": {
        "operationId": "html.version.source",
        "summary": "Download one version's stored HTML source as plain text (needs reader)",
        "description": "Return the exact stored bytes of one published version as text/plain (served inert, never as an active page), with ETag and X-Document-Version response headers. Pass --output to save the bytes; use html source for the JSON {slug, version, html} form. Any capability above none on the document is enough, including a share-code reader; the document is hidden as 404 otherwise. Bot bearer tokens are honored only when the octo-docs-html deployment sets BOT_AUTH_ENABLED=true (default false) and OCTO_SERVER_BASE_URL is configured; otherwise a bot token is not recognized and the call fails like an unauthenticated one. A bot's capability on the document comes from the bot itself (document creator or member) or from its owner (owner is the creator or a document admin).",
