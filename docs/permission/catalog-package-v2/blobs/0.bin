        "responses": {
          "200": {
            "description": "Renamed"
          }
        }
      },
      "delete": {
        "operationId": "docs.delete",
        "summary": "Delete a document (forbidden for bots, including owner/admin)",
        "description": "Bots must not invoke this operation, even for documents they created or own/administer. The docs-backend bot-deletion policy returns HTTP 403 bot_delete_forbidden, including already-deleted retries. Do not retry, change uid/owner/Space/credentials, or switch to HTML/raw API routes. Ask a human with document admin permission to delete it in Octo. Bot creation, editing, and separately permitted subresource operations are unchanged.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "403": {
            "description": "Bot document deletion is forbidden, including owner/admin and already-deleted retries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": ["bot_delete_forbidden"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/export": {
      "get": {
        "operationId": "docs.scene.export",
        "summary": "Export a whiteboard's live scene as PNG, SVG, or portable Excalidraw (needs reader)",
        "description": "Exports the LIVE scene of a doc_type 'board'. `--image-format png` (default) and `svg` render on the server; `excalidraw` is assembled locally with referenced attachments embedded for round-trip import and requires --output/-o on the CLI; over MCP the file is returned inline (bounded like any binary result). For PNG/SVG, without --output the command reports response metadata only. A non-board target returns 409 unsupported_doc_type; an unrecognised format returns 400 invalid_format.",
        "x-octo-risk": "read",
        "x-octo-risk-note": "read reflects the server-side effect: this is a GET that renders and returns the live scene as an image without mutating any doc state. The optional --output/-o writes to a local, user-chosen path (client side, analogous to curl -o) and does not change the API risk class.",
        "x-octo-binary-response": true,
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "x-octo-flag": "image-format",
            "schema": {
              "type": "string",
              "enum": [
                "png",
                "svg",
                "excalidraw"
              ],
              "default": "png"
            },
            "description": "image format (one of: png, svg, excalidraw); default png. Exposed as --image-format so it does not shadow the global --format output flag."
          }
        ],
        "responses": {
          "200": {
            "description": "The rendered board image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "invalid_format"
          },
          "409": {
            "description": "unsupported_doc_type / board_snapshot_invalid"
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/content": {
      "get": {
        "operationId": "docs.content.get",
        "summary": "Read a document's live body + its base version (needs reader)",
        "description": "Reads the LIVE ProseMirror body of a doc_type 'doc' plus the base-version token that pins the read. Pass that token to `docs content edit` as --base-version so the optimistic-concurrency guard can prove the body did not change between read and write. board / whiteboard bodies are a different Y.Doc shape and return 409 unsupported_doc_type here.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Live body + base version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "doc": {
                      "type": "object",
                      "description": "the live body as ProseMirror document JSON"
                    },
                    "schemaVersion": {
                      "type": "integer",
                      "description": "ProseMirror schema version the body was decoded with"
                    },
                    "baseVersion": {
                      "type": "string",
                      "description": "opaque base64 base-version token; pass to `docs content edit --base-version`"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "docs.content.edit",
        "summary": "Apply an incremental block-op edit to a document body (needs writer)",
        "description": "Applies a batch of incremental block ops to a doc_type 'doc' body under a mandatory optimistic-concurrency guard. Pass the base-version token from `docs content get` via --base-version (sent as the If-Match header); the server rejects with 412 base_version_stale if the live body moved since that read. The ops batch is a structured array, so pass it as JSON through --data. Only doc_type 'doc' is accepted (board / whiteboard return 409 unsupported_doc_type). Gates: op count over the max → 413 too_many_ops, a single op's content too large → 413 op_content_too_large, block-path too deep → 400 path_too_deep, missing base version or malformed shape → 400 invalid_body, bad anchor / invalid ops → 422.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "x-octo-flag": "base-version",
            "schema": {
              "type": "string"
            },
            "description": "base-version token from 'docs content get' (sent as the If-Match header for optimistic concurrency; required)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ops"
                ],
                "properties": {
                  "ops": {
                    "type": "array",
                    "description": "ordered batch of incremental block edit ops. Each op is one of: insert {\"type\":\"insert\",\"at\":{\"path\":[i,...],\"position\":\"before|after|inside_start|inside_end\"},\"content\":[<ProseMirror block nodes>],\"expect\":{\"type\":\"<nodeType>\"}?}; replace {\"type\":\"replace\",\"range\":{\"from\":{\"path\":[...]},\"to\":{\"path\":[...]}},\"content\":[...],\"expect\":?}; delete {\"type\":\"delete\",\"range\":{\"from\":{\"path\":[...]},\"to\":{\"path\":[...]}},\"expect\":?}. `path` is child indices from the doc root; range endpoints must share a parent. Pass via --data.",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Edit applied; carries the new base version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer",
                      "description": "encoded size of the doc after the edit"
                    },
                    "baseVersion": {
                      "type": "string",
                      "description": "new base-version token for the next edit"
                    },
                    "newDocVersionSeq": {
                      "type": "integer",
                      "description": "sequence of the auto safety snapshot taken before the edit"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/sheets": {
      "get": {
        "operationId": "docs.sheet.list",
        "summary": "List worksheet IDs and names without downloading cells (needs reader)",
        "description": "Returns the worksheet directory in tab order: sheetId (the persistent logicalId), name, order, rowCount and columnCount. Does not return cells or a baseVersion. Use this to discover a worksheet before docs sheet get --sheet-id or --sheet-name. An old workbook without sheetList exposes its implicit default / Sheet1 worksheet. Counts describe declared grid size, not populated cells. Requires the worksheet-directory backend; do not fall back to downloading the entire workbook when this endpoint is unavailable.",
        "x-octo-risk": "read",
        "x-octo-strict-response-schema": true,
        "parameters": [
          { "name": "docId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Worksheet directory, without cell content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["docId", "items"],
                  "properties": {
                    "docId": { "type": "string" },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["sheetId", "name", "order", "rowCount", "columnCount"],
                        "properties": {
                          "sheetId": { "type": "string", "description": "Persistent worksheet logicalId; prefer this over a mutable display name for subsequent reads." },
                          "name": { "type": "string" },
                          "order": { "type": "number" },
                          "rowCount": { "type": "integer" },
                          "columnCount": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/sheet": {
      "get": {
        "operationId": "docs.sheet.get",
        "summary": "Read a spreadsheet's live cells, worksheet resources, and base version (needs reader)",
        "description": "Reads the LIVE flat cell map of a doc_type 'sheet' (keys `sheetId!row:col`, values {v,f,s,p,t}), column-width / row-height overrides (sheetDims), hyperlinks (sheetHyperLinks), merged ranges (sheetMerges), sheet tabs (sheetList), freeze panes (sheetFreeze), shared filters (sheetFilters), data-validation/dropdown rules (sheetDataValidations), and the base-version token that pins the read. Pass that token to `docs sheet edit` as --base-version so the optimistic-concurrency guard can prove the sheet did not change between read and write. Sorting is a raw coordinate rewrite, not a spreadsheet-native sort: reorder the complete selected row block, carry each cell's complete {v,f,s,p,t} shape to its destination, and use null for destinations that become empty. The server stores `f` verbatim and does not re-anchor relative formula references; rewrite them for the destination or do not sort that range. Any state keyed by or containing coordinates stays at its old coordinates, including row dims, data-validation ranges, hyperlinks, merges, drawings, and cell-comment anchors; freeze panes and filter ranges/columns also remain fixed. Remap every affected resource for which you have an authoritative readable/writable surface, or do not sort the range. `sheetDims` is one workbook-level map whose keys may be sheet-qualified: `${logicalId}:c<idx>` / `${logicalId}:r<idx>` targets one tab, while bare `c<idx>` / `r<idx>` addresses the legacy default sheet; reads return keys exactly as stored. Rows hidden by an active shared filter are still returned and a full rectangle rewrite includes them. To sort only visible rows, evaluate `sheetFilters` criteria first and build a sparse permutation that leaves hidden row coordinates unchanged; clearing the filter does not preserve the visible subset. doc / board / whiteboard bodies are a different Y.Doc shape and return 409 unsupported_doc_type here. A whole-sheet read over the 1 MB byte cap returns 413 sheet_too_large; pass --limit and follow nextCursor via --cursor. In paged mode every page is bounded by both --limit and the byte cap; sheetDims, sheetHyperLinks, sheetMerges, sheetList, sheetFreeze, sheetFilters, sheetDataValidations, and sheetConditionalFormats are returned on the first page only. When checkbox metadata exceeds the size or inspection budget, 413 includes baseVersion and repairDataValidationKey in the CLI error detail; delete that exact internal key with a validation-only PATCH and retry until the read succeeds. A --cursor whose snapshot moved returns 409 sheet_changed; a malformed --cursor returns 400 invalid_cursor; a non-positive --limit returns 400 invalid_limit. Also returns sheetConditionalFormats for conditional-format rule management. Use docs sheet list to discover persistent worksheet IDs/names, then choose exactly one of --sheet-id or --sheet-name to read only that worksheet. The backend filters cells and associated metadata before pagination and byte limits. Scoped responses carry sheetId; compact cursors retain that scope on subsequent requests, including cursor-only continuation. Missing or ambiguous names never fall back to all worksheets. The original baseVersion write token is unchanged.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "max cells per page; opts into paged reads. Bounded by the server byte cap regardless. Omit for a whole-sheet read."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "opaque nextCursor from the previous page; also opts into paged reads. New compact cursors bind the document and selected worksheet; cursor-only continuation preserves that scope. Repeating an equivalent selector is allowed, changing scope is rejected. A cursor whose snapshot moved returns 409 sheet_changed."
          },
          {
            "name": "sheetId",
            "in": "query",
            "x-octo-flag": "sheet-id",
            "schema": { "type": "string", "minLength": 1, "maxLength": 64 },
            "description": "read only this persistent worksheet logicalId, discovered via docs sheet list. Mutually exclusive with --sheet-name. Filters cells and associated metadata before pagination and byte limits. Omit both selectors for the whole workbook. Requires worksheet-scoped read backend support."
          },
          {
            "name": "sheetName",
            "in": "query",
            "x-octo-flag": "sheet-name",
            "schema": { "type": "string", "minLength": 1 },
            "description": "read only the worksheet with this exact display name. Mutually exclusive with --sheet-id. Missing names return sheet_not_found; duplicates return ambiguous_sheet_name with candidate IDs. Never guesses or falls back to all worksheets."
          }
        ],
        "responses": {
          "200": {
            "description": "Live cells + dims + base version (paged when --limit/--cursor is set)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "sheetId": {
                      "type": "string",
                      "description": "resolved logicalId on worksheet-scoped reads and their continuation pages; absent on whole-workbook reads"
                    },
                    "sheetCells": {
                      "type": "object",
                      "description": "flat cell map keyed `sheetId!row:col`; each value is {v?,f?,s?,p?,t?}. Rows are 0-based and may be 0..9999; columns are 0-based and may be 0..99. A page slice in paged mode. Shrinking rowCount or columnCount retains cells beyond the visible boundary for undo/regrowth, so renderers and exporters should ignore rows >= the effective rowCount and columns >= the effective columnCount."
                    },
                    "sheetDims": {
                      "type": "object",
                      "description": "column-width / row-height overrides in one workbook-level map. Keys `${logicalId}:c<idx>` / `${logicalId}:r<idx>` target a specific tab; bare `c<idx>` / `r<idx>` address the legacy default sheet. Reads return keys exactly as stored. Returned on the first page only in paged mode."
                    },
                    "sheetHyperLinks": {
                      "type": "object",
                      "description": "cell hyperlinks keyed `${sheetId}!${linkId}`; each value is {id,row,column,payload,display?}. Returned on the first page only in paged mode."
                    },
                    "sheetMerges": {
                      "type": "object",
                      "description": "merged cell ranges keyed `${logicalId}:sr:sc:er:ec` (0-based startRow:startCol:endRow:endCol); each value is true. Returned on the first page only in paged mode."
                    },
                    "sheetList": {
                      "type": "object",
                      "description": "sheet tabs / pages keyed by logicalId; each value is {name,order,rowCount?,columnCount?}. rowCount is 1..10000 and columnCount is 1..100. The current backend stores explicit counts when it creates a new sheet, defaulting to 200 rows by 20 columns (A-T); missing stored counts therefore identify a pre-existing legacy 1000-row by 100-column sheet. The first tab's logicalId is 'default'. Returned on the first page only in paged mode."
                    },
                    "sheetFreeze": {
                      "type": "object",
                      "description": "freeze panes keyed by logicalId; each value is {startRow,startColumn,xSplit,ySplit}. An unfrozen axis reads back with startRow/startColumn -1 even when the write used 0. Returned on the first page only in paged mode."
                    },
                    "sheetFilters": {
                      "type": "object",
                      "description": "shared auto-filter state keyed by logicalId; each value is {ref,filterColumns?:[{\"colId\":<absolute 0-based column>,\"filters\":{\"filters\":[<raw values>]}}],enabledColumns?:[<absolute 0-based column>]}. ref.startRow is the header row and stays visible; criteria apply to rows below it. enabledColumns is non-empty when present, contains only columns inside ref, and identifies the exact columns with visible filter buttons; every filterColumns colId also appears in enabledColumns. It is deduplicated and sorted on readback. For example, ref G:M plus enabledColumns:[6,12] enables only G and M, not H-L. This controls filter-button visibility only, not read or write access. Omitted enabledColumns identifies a legacy snapshot where every column in ref is enabled. An empty filterColumns array is omitted on readback. Returned on the first page only in paged mode."
                    },
                    "sheetDataValidations": {
                      "type": "object",
                      "description": "data-validation arrays keyed by logicalId; each array can contain every returned validation family, including `list`, `listMultiple`, and `checkbox`. This public shape is not the internal flat `${logicalId}!${uid}` Y.Map. Dropdown formula1 is the serialized option list and formula2 is the comma-separated option-color list. Returned on the first page only in paged mode."
                    },
                    "baseVersion": {
                      "type": "string",
                      "description": "opaque base64 base-version token; pass to `docs sheet edit --base-version`"
                    },
                    "hasMore": {
                      "type": "boolean",
                      "description": "paged mode: more cells remain after this page"
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "paged mode: opaque cursor for the next page (null when hasMore is false); pass back via --cursor"
                    },
                    "sheetConditionalFormats": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object"
                      },
                      "description": "Compact conditional-format rules keyed by logicalId!cfId. Each value is {priority,rule:{cfId,stopIfTrue,ranges,rule}}; the inner rule uses Univer highlightCell, colorScale, dataBar or iconSet. Never expand a rule into per-cell styles. Requires the paired conditional-format API backend. Returned on the first page only in paged mode."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "docs.sheet.edit",
        "summary": "Apply a batch sheet edit — cells, layout, filters, validation, and dropdowns (needs writer)",
        "description": "Applies one atomic spreadsheet batch under a mandatory optimistic-concurrency guard. Pass the base-version token from `docs sheet get` via --base-version (sent as If-Match); stale writes return 412 base_version_stale. Existing surfaces are cells, dims, drawings, hyperlinks, merges, and sheets. P0 worksheet resources are: freeze `{logicalId:{startRow,startColumn,xSplit,ySplit}|null}`, filters `{logicalId:{ref:{startRow,startColumn,endRow,endColumn},filterColumns?:[columns],enabledColumns?:[absoluteColumnIds]}|null}`, and dataValidations `{logicalId:[rules]|null}`. The public dataValidations and sheetDataValidations shapes are per-sheet arrays for every validation family, including list, listMultiple, and checkbox; do not send the internal flat `${logicalId}!${uid}` Y.Map shape except for the server-directed deletion-only repair described below. The server requires each rule uid to be unique within the sheet, 1–128 characters, free of `!` and control characters, plus at least one non-empty ranges entry. Checkbox ranges must not overlap another checkbox rule after the complete edit; list and listMultiple overlaps are accepted by the backend and should be sent only when intentional. For a working colored `list` or `listMultiple` dropdown, also send type, formula1 (JSON-serialized option labels), formula2 (the same number of comma-separated colors), showDropDown, and renderMode; omit operator. A listMultiple cell stores its selected labels as a JSON-array string, while a list cell stores the label directly. dataValidations is replace-style per logical sheet: read sheetDataValidations first and resend every rule to keep, but do not write if the deployed read surface omits any validation family on that sheet. null removes a freeze/filter/resource entry, and null or [] removes all validation rules for that sheet. An empty filterColumns array is omitted on readback. When enabledColumns is present it must be a non-empty list of absolute 0-based columns inside ref and select exactly which columns show filter buttons; every filterColumns colId must also appear in enabledColumns. A mismatch or enabledColumns:[] is rejected with 422 sheet_cell_invalid. The server deduplicates and sorts enabledColumns. For example, ref G:M with enabledColumns:[6,12] enables only G and M, not H-L. This controls filter-button visibility only, not read or write access; use protected ranges for access control. Filters are replace-style per logical sheet: read sheetFilters first and resend the complete filter object, including enabledColumns, when changing criteria. Omitting enabledColumns invokes legacy all-columns-in-ref behavior and silently widens the visible controls. An unfrozen freeze axis accepts startRow/startColumn 0 but normalizes it to -1. Sorting is a raw coordinate rewrite, not a spreadsheet-native sort: reorder the complete selected row block, carry each cell's complete {v,f,s,p,t} shape to its destination, and use null for destinations that become empty. The server stores `f` verbatim and does not re-anchor relative formula references; rewrite them for the destination or do not sort that range. Any state keyed by or containing coordinates stays at its old coordinates, including row dims, data-validation ranges, hyperlinks, merges, drawings, and cell-comment anchors; freeze panes and filter ranges/columns also remain fixed. Remap every affected resource for which you have an authoritative readable/writable surface, or do not sort the range. `sheetDims` is one workbook-level map whose keys may be sheet-qualified: `${logicalId}:c<idx>` / `${logicalId}:r<idx>` targets one tab, while bare `c<idx>` / `r<idx>` addresses the legacy default sheet; reads return keys exactly as stored. Bare and prefixed keys for the default sheet are separate entries; when migrating a legacy key, read sheetDims and clear the bare twin in the same batch, for example `{\"c0\":null,\"default:c0\":200}`. Rows hidden by an active shared filter still participate in a full rectangle rewrite. To sort only visible rows, evaluate `sheetFilters` criteria first and build a sparse permutation that leaves hidden row coordinates unchanged; clearing the filter does not preserve the visible subset. Any one surface may be the only non-empty batch member, but at least one surface must be non-empty. Only doc_type 'sheet' is accepted. Gates: validation-rule count over the max → 413 too_many_data_validations; cell/dim/drawing count over the max → 413 too_many_cells; worksheet-resource key count over the max → 413 too_many_sheet_resources; a single cell's payload too large → 413 cell_too_large; missing base version, malformed shape, or all batches empty → 400 invalid_body; a cell/dim/drawing/hyperlink/merge/tab/freeze/filter/data-validation violating its contract or key shape → 422 sheet_cell_invalid; writes intersecting a protected range → 403 protected_range. If 413 sheet_too_large includes baseVersion and repairDataValidationKey, submit only `{\"dataValidations\":{\"<repairDataValidationKey>\":null}}` with that base version, then retry. The backend accepts this flat-key form only when it deletes checkbox-shaped stored metadata and strictly reduces that metadata; do not invent a flat key. conditionalFormats is a sparse logicalId!cfId map of complete rule upserts or null deletions. Rules are removed with a deleted worksheet. Row/column structural edits on a sheet with conditional formatting are refused until rule relocation is supported.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "x-octo-flag": "base-version",
            "schema": {
              "type": "string"
            },
            "description": "base-version token from 'docs sheet get' (sent as the If-Match header for optimistic concurrency; required)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cells": {
                    "type": "object",
                    "description": "batch of cell ops keyed by cell key `sheetId!row:col` (e.g. `default!0:0`). Rows are 0-based and may be 0..9999; columns are 0-based and may be 0..99. Each value is either {\"v\":<string|number|boolean|null>,\"f\":\"<formula>\"?,\"s\":<style object>?,\"p\":<rich-text object>?,\"t\":<number>?} to set the cell, or null to delete it. At least one of v/f/s/p/t must be present on a set. A non-null write at a row index >= rowCount or column index >= columnCount grows that sheet atomically, capped at 10000 rows and 100 columns; a write past either cap is rejected with 422 sheet_cell_invalid. Pass via --data."
                  },
                  "dims": {
                    "type": "object",
                    "description": "batch of column-width / row-height ops in one workbook-level map. Use `${logicalId}:c<idx>` / `${logicalId}:r<idx>` to target a specific tab; bare `c<idx>` / `r<idx>` address the legacy default sheet. Bare and prefixed default-sheet keys are separate stored entries: read sheetDims first and clear the bare twin while migrating, for example `{\"c0\":null,\"default:c0\":200}`. Each value is a positive pixel number to set, or null to delete that dim. Optional. Pass via --data."
                  },
                  "drawings": {
                    "type": "object",
                    "description": "batch of floating-image ops keyed `${sheetId}!${drawingId}` (e.g. `default!img1`). Each value is a serialized Univer ISheetImage — {drawingId (== the key's id), drawingType:0, imageSourceType:\"BASE64\", source:\"data:image/png;base64,…\", transform:{left,top,width,height,angle,flipX,flipY,skewX,skewY}, sheetTransform:{from:{column,row,columnOffset,rowOffset},to:{…}}, axisAlignSheetTransform} — or null to delete it. The image bytes ride inline in `source`. A MATH FORMULA is written here too, as a float-DOM drawing: {drawingId, drawingType:8, componentKey:\"octo-math-formula\", data:{latex,id,fontSize}, transform, sheetTransform} (latex in data.latex; data.id == drawingId). Optional. Pass via --data."
                  },
                  "hyperlinks": {
                    "type": "object",
                    "description": "batch of cell-hyperlink ops keyed `${sheetId}!${linkId}` (e.g. `default!lnk1`). Each value is {id (== the key's linkId), row, column (0-based cell anchor), payload:\"<url>\" (http/https/mailto or an internal #jump), display?:\"<label>\"} to set, or null to delete. The link lives outside cell data and points at a cell by row/column; put the cell's visible text in that cell's `v`. Optional. Pass via --data."
                  },
                  "merges": {
                    "type": "object",
                    "description": "batch of merged-cell-range ops keyed `${logicalId}:sr:sc:er:ec` (0-based startRow:startCol:endRow:endCol, e.g. `default:0:0:1:2` merges the A1:C2 block). Value true to merge that range, or null to un-merge it. Optional. Pass via --data."
                  },
                  "sheets": {
                    "type": "object",
                    "description": "batch of sheet-TAB (page) ops keyed by logicalId. Value {name,order,rowCount?,columnCount?} to create / rename / reorder / resize a tab, or null to delete it; name and order are required on every non-null entry, and deleting a tab also removes its validation rules. rowCount is an integer 1..10000 and columnCount is an integer 1..100. The backend stores explicit counts for new tabs, defaulting to 200 rows by 20 columns (A-T); pre-existing legacy tabs without stored counts remain 1000 by 100. On an existing tab, omitting either count preserves that dimension, but a resize payload must still resend name and order. Read the current tabs from `docs sheet get`'s sheetList; the first tab's logicalId is 'default'. To ADD a sheet: set a NEW logicalId here AND write that sheet's cells with keys `${logicalId}!row:col`. Optional. Pass via --data."
                  },
                  "freeze": {
                    "type": "object",
                    "description": "batch of freeze-pane configs keyed by logicalId. Value {startRow,startColumn,xSplit,ySplit}; startRow/startColumn are the first scrollable row/column and normally equal ySplit/xSplit when freezing the first N rows/columns. Use -1 for the start coordinate of an unfrozen axis; 0 is accepted there but normalizes to -1 on readback. null unfreezes that sheet. Optional. Pass via --data."
                  },
                  "filters": {
                    "type": "object",
                    "description": "batch of replace-style shared auto-filter snapshots keyed by logicalId. Value {ref:{startRow,startColumn,endRow,endColumn},filterColumns?:[{\"colId\":<absolute 0-based column>,\"filters\":{\"filters\":[<raw values>]}}],enabledColumns?:[<absolute 0-based column>]}. ref.startRow is the header row and stays visible; criteria apply to rows below it. colId is not an offset from ref.startColumn. Sending filterColumns:[] keeps the range but omits filterColumns on readback. When enabledColumns is present it must be non-empty, contain only columns inside ref, and select exactly which columns show filter buttons; every filterColumns colId must also appear in enabledColumns. A mismatch or enabledColumns:[] is rejected with 422 sheet_cell_invalid. The server deduplicates and sorts enabledColumns. For example, ref G:M plus enabledColumns:[6,12] enables only G and M, not H-L. This controls filter-button visibility only, not read or write access; use protected ranges for access control. Read sheetFilters first and resend the complete filter object, including enabledColumns, when changing criteria. Omitting enabledColumns invokes legacy all-columns-in-ref behavior and silently widens the visible controls. null removes the filter and all controls. Optional. Pass via --data."
                  },
                  "dataValidations": {
                    "type": "object",
                    "description": "replace-style data-validation arrays keyed by logicalId. This public REST shape covers every validation family, including list, listMultiple, and checkbox; do not use the internal flat `${logicalId}!${uid}` Y.Map shape except when the server returns repairDataValidationKey and explicitly requests one deletion-only repair. The server requires each rule to have a uid unique within that sheet (1–128 characters, no `!` or control characters) and at least one non-empty ranges:[{startRow,startColumn,endRow,endColumn}] entry. Checkbox ranges must not overlap another checkbox rule after the complete edit; list and listMultiple overlaps are accepted by the backend and should be sent only when intentional. It replaces that sheet's entire rule set, so read sheetDataValidations first and resend every rule to keep; do not write if the deployed read surface omits any validation family. Checkbox formula1/formula2 are optional distinct literal strings that default to \"1\"/\"0\", and the server normalizes allowBlank to true. For a working colored dropdown, use type 'list' or 'listMultiple', formula1 as a JSON string array of labels, formula2 as the same number of comma-separated colors, showDropDown:true, renderMode:2, and no operator. These dropdown fields are recommended rendering inputs, not additional server-required fields. A listMultiple cell stores selected labels in v as a JSON-array string; a list cell stores the label directly. The server strips operator from otherwise-valid list rules. null or [] removes all rules for the sheet. Optional. Pass via --data."
                  },
                  "conditionalFormats": {
                    "type": "object",
                    "additionalProperties": {
                      "type": ["object", "null"]
                    },
                    "description": "Compact conditional-format rules keyed by logicalId!cfId. Each value is {priority,rule:{cfId,stopIfTrue,ranges,rule}}; the inner rule uses Univer highlightCell, colorScale, dataBar or iconSet. Never expand a rule into per-cell styles. Requires the paired conditional-format API backend. Sparse upserts: send a complete value to create/update one rule, null to delete it; unrelated rules survive. Read a fresh baseVersion first. Maximum 1000 rules/1 MiB per workbook and 64 KiB per rule. Protected worksheets are checked server-side. Pass via --data."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Edit applied; carries the new base version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer",
                      "description": "encoded size of the sheet after the edit"
                    },
                    "baseVersion": {
                      "type": "string",
                      "description": "new base-version token for the next edit"
                    },
                    "newDocVersionSeq": {
                      "type": "integer",
                      "description": "sequence of the auto safety snapshot taken before the edit"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/sheet/rows/insert": {
      "post": {
        "operationId": "docs.sheet.rows.insert",
        "x-octo-strict-request-schema": true,
        "summary": "Insert rows after an existing spreadsheet row (needs writer)",
        "description": "Inserts count blank rows immediately after the zero-based afterRow in one logical worksheet. The server atomically shifts cells, row dimensions, hyperlinks, merged ranges, drawing anchors, freeze/filter ranges, data-validation ranges, live comment anchors, and protection ranges, then increments sheetList.rowCount. Pass the baseVersion from docs sheet get through --base-version; stale writes return 412 base_version_stale. afterRow is an absolute stored row index within the worksheet's current rowCount, not an ordinal among filter-visible rows. count must be 1..9999 and the resulting sheet cannot exceed 10000 rows. The operation refuses a workbook containing cell formulas with 409 sheet_formula_unsupported because the server cannot safely reproduce Univer formula-reference re-anchoring. Other failures include 403 protected_range, 404 sheet_not_found, 422 sheet_row_out_of_bounds or sheet_row_limit_exceeded, and the normal sheet/document size gates. A worksheet with conditional-format rules is rejected with 409 sheet_conditional_format_unsupported until server-side rule relocation is supported. Never delete the rules automatically to bypass this refusal. Remove the rules explicitly first, or use the frontend.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "x-octo-flag": "base-version",
            "schema": {
              "type": "string"
            },
            "description": "base-version token from docs sheet get (sent as If-Match; required)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "logicalId",
                  "afterRow",
                  "count"
                ],
                "properties": {
                  "logicalId": {
                    "type": "string",
                    "x-octo-flag": "logical-id",
                    "description": "logical worksheet id, normally default for the first tab"
                  },
                  "afterRow": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999,
                    "x-octo-flag": "after-row",
                    "description": "zero-based existing row after which blank rows are inserted"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9999,
                    "x-octo-flag": "count",
                    "description": "number of blank rows to insert; resulting rowCount must remain at most 10000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inserted row count, resulting rowCount, and fresh base version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": { "type": "string" },
                    "logicalId": { "type": "string" },
                    "afterRow": { "type": "integer" },
                    "insertedRows": { "type": "integer" },
                    "rowCount": { "type": "integer" },
                    "bytes": { "type": "integer" },
                    "baseVersion": { "type": "string" },
                    "newDocVersionSeq": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/sheet/rows/delete": {
      "post": {
        "operationId": "docs.sheet.rows.delete",
        "x-octo-strict-request-schema": true,
        "summary": "Delete spreadsheet rows (needs writer)",
        "description": "Deletes count rows beginning at zero-based startRow in one logical worksheet. startRow is an absolute stored row index, not an ordinal among filter-visible rows. The server atomically removes resources anchored wholly inside the deleted rows, shifts later resources upward, shrinks intersecting ranges, and decrements sheetList.rowCount. Pass the baseVersion from docs sheet get through --base-version. At least one row must remain. Formula-bearing workbooks return 409 sheet_formula_unsupported; other failures include 403 protected_range, 404 sheet_not_found, and 422 sheet_row_out_of_bounds. A worksheet with conditional-format rules is rejected with 409 sheet_conditional_format_unsupported until server-side rule relocation is supported. Never delete the rules automatically to bypass this refusal. Remove the rules explicitly first, or use the frontend.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "x-octo-flag": "base-version",
            "schema": { "type": "string" },
            "description": "base-version token from docs sheet get (sent as If-Match; required)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["logicalId", "startRow", "count"],
                "properties": {
                  "logicalId": {
                    "type": "string",
                    "x-octo-flag": "logical-id",
                    "description": "logical worksheet id, normally default for the first tab"
                  },
                  "startRow": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999,
                    "x-octo-flag": "start-row",
                    "description": "zero-based first row to delete"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9999,
                    "x-octo-flag": "count",
                    "description": "number of contiguous rows to delete; at least one row must remain"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deleted row count, resulting rowCount, and fresh base version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": { "type": "string" },
                    "logicalId": { "type": "string" },
                    "startRow": { "type": "integer" },
                    "deletedRows": { "type": "integer" },
                    "rowCount": { "type": "integer" },
                    "bytes": { "type": "integer" },
                    "baseVersion": { "type": "string" },
                    "newDocVersionSeq": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/sheet/columns/insert": {
