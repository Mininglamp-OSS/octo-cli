    "/v1/bot/docs/{docId}/forward-grant/batch": {
      "post": {
        "operationId": "docs.forward-grant.batch",
        "summary": "Grant (never downgrade) reader/commenter/writer access to many uids at once (needs admin)",
        "description": "Max-merge grant for up to 1000 targets. The whole request is validated first (non-empty array, at most 1000 entries, unique non-empty uid, role reader|commenter|writer); any violation is a 400 with zero writes. Identities are resolved in one batch with the bot's own token (502 identity_unavailable if the lookup fails). Grants are then applied in order without rollback: per-item status is ok, user_not_found or grant_failed, and ok is true only when failed is 0.",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "grants"
                ],
                "properties": {
                  "grants": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1000,
                    "description": "grant targets (1-1000, unique uid)",
                    "items": {
                      "type": "object",
                      "required": [
                        "uid",
                        "role"
                      ],
                      "properties": {
                        "uid": {
                          "type": "string",
                          "minLength": 1,
                          "description": "target user uid"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "reader",
                            "commenter",
                            "writer"
                          ],
                          "description": "role to grant (grant-only, never downgrades)"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-target grant results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "granted": {
                      "type": "integer"
                    },
                    "failed": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "uid": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "ok",
                              "user_not_found",
                              "grant_failed"
                            ]
                          },
                          "role": {
                            "type": "string"
                          },
                          "changed": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/access-requests": {
      "post": {
        "operationId": "docs.access-requests.create",
        "summary": "Ask the document admins for access as the bot itself (no document role needed)",
        "description": "The document must be in the bot's Space (else 404 not_found); an archived document returns 409 conflict. requestedRole defaults to reader; html documents accept reader|commenter only, other documents reader|commenter|writer. If the bot already holds the requested role the response is 200 {status:already_granted, role}. Omit botUids for a bot caller: bot ownership is resolved from a human session, so any supplied bot uid is rejected with 403 bot_not_owned_in_space.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestedRole": {
                    "type": "string",
                    "enum": [
                      "reader",
                      "commenter",
                      "writer"
                    ],
                    "default": "reader",
                    "description": "role requested; html documents accept reader or commenter only"
                  },
                  "reason": {
                    "type": "string",
                    "description": "optional reason shown to approvers (truncated to 512 characters)"
                  },
                  "botUids": {
                    "type": "array",
                    "maxItems": 50,
                    "description": "Space bots owned by a human requester; not usable by a bot caller",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pending request created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "requestId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "Requested role already held",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "docs.access-requests.list",
        "summary": "List a document's access requests by status (needs admin)",
        "description": "Defaults to pending requests; status=approved or status=denied selects decided ones.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "denied"
              ],
              "default": "pending"
            },
            "description": "request status filter"
          }
        ],
        "responses": {
          "200": {
            "description": "Access requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "requestId": {
                            "type": "string"
                          },
                          "uid": {
                            "type": "string"
                          },
                          "principalSpaceId": {
                            "type": "string"
                          },
                          "requestedRole": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "botUids": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "createdAt": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/access-requests/{requestId}/approve": {
      "post": {
        "operationId": "docs.access-requests.approve",
        "summary": "Approve a pending access request and grant the requester a role (needs admin)",
        "description": "Atomically consumes the pending request (409 not_pending if it was already decided; 404 not_found for an unknown request), grants the human role, then grants the selected carried bots. humanRole defaults to the requested role (legacy alias: role); botRole defaults to role, then humanRole. html documents may grant reader|commenter|admin; other documents reader|commenter|writer|admin (400 role_not_grantable_for_document_type). botUids must be a subset of the bots carried by the request (400 bot_not_in_request).",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "humanRole": {
                    "type": "string",
                    "enum": [
                      "reader",
                      "commenter",
                      "writer",
                      "admin"
                    ],
                    "description": "role granted to the requester (defaults to the requested role)"
                  },
                  "botRole": {
                    "type": "string",
                    "enum": [
                      "reader",
                      "commenter",
                      "writer",
                      "admin"
                    ],
                    "description": "role granted to the selected bots (defaults to role, then humanRole)"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "reader",
                      "commenter",
                      "writer",
                      "admin"
                    ],
                    "description": "legacy unified role for both the requester and bots"
                  },
                  "botUids": {
                    "type": "array",
                    "description": "subset of the request's carried bot uids to grant (defaults to all carried bots)",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Approved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "role": {
                      "type": "string"
                    },
                    "botGrantResult": {
                      "type": "object",
                      "properties": {
                        "succeeded": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "failed": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "uid": {
                                "type": "string"
                              },
                              "reason": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/access-requests/{requestId}/deny": {
      "post": {
        "operationId": "docs.access-requests.deny",
        "summary": "Deny a pending access request (needs admin)",
        "description": "No request body. 404 not_found for an unknown request; 409 not_pending if it was already decided.",
