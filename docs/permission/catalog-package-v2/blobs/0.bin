    "/fleet/api/v1/capabilities/install": {
      "post": {
        "summary": "Install a capability definition",
        "description": "Atomically materialize a versioned capability definition as skills, one expert, or an expert team in the workspace. Requires workspace membership; runtime bindings must name runtimes in the workspace that the caller may use (private runtimes need their owner or a workspace admin). Skill-only definitions need no bindings. The body is decoded strictly (unknown fields are rejected) and limited to 32 MiB. Replaying an identical Idempotency-Key and body within 24 hours returns the original result. Task credentials are rejected; issued Loop credentials need the capability.install action. This route always uses the public contract.",
        "tags": [
          "capabilities"
        ],
        "operationId": "capability.install",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapabilityInstallationRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "description": "RATE_LIMITED - capability installation rate exceeded the configured limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "409": {
            "description": "DUPLICATE - the Idempotency-Key was reused with a different request, an expert name already exists, or a caller-owned same-name skill has different content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE - the body exceeds 32 MiB or a definition limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE - Content-Type must be application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "UPSTREAM_UNAVAILABLE - a required verifier or identity store is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "200": {
            "description": "Capability resources were created, or the original result was replayed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CapabilityInstallation"
                    }
                  }
                }
              }
            }
          }
        },
        "x-octo-risk": "write"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceIDHeader"
        }
      ]
    },
