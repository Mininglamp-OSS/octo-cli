    "/v1/bot/docs/{docId}/import/excalidraw": {
      "post": {
        "operationId": "docs.scene.import",
        "summary": "Import an Excalidraw scene into a whiteboard (needs writer)",
        "description": "Board documents only (409 unsupported_doc_type). Send the .excalidraw JSON envelope as the body, for example --data @board.excalidraw. mode=merge (default) keeps existing elements; mode=replace overwrites the board after the backend takes a safety snapshot. Embedded files are validated, sanitized and stored as attachments, and element/file ids are remapped (elementIdMap, fileIdMap). The body is limited by DOCX_IMPORT_MAX_UPLOAD_BYTES (default 200 MiB) and the board element limits.",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "merge",
                "replace"
              ],
              "default": "merge"
            },
            "description": "merge preserves existing elements; replace overwrites the board"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "version",
                  "elements",
                  "files"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "excalidraw"
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "enum": [
                      2
                    ]
                  },
                  "elements": {
                    "type": "array",
                    "description": "Excalidraw elements; each needs a non-empty string id",
                    "items": {
                      "type": "object"
                    }
                  },
                  "files": {
                    "type": "object",
                    "description": "Excalidraw files map keyed by file id; each entry carries a dataURL"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string"
                    },
                    "importedElements": {
                      "type": "integer"
                    },
                    "importedFiles": {
                      "type": "integer"
                    },
                    "elementIdMap": {
                      "type": "object"
                    },
                    "fileIdMap": {
                      "type": "object"
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "baseVersion": {
                      "type": "string"
                    },
                    "newDocVersionSeq": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
{
  "openapi": "3.1.0",
  "info": {
    "title": "Octo Drive API",
    "version": "1.0.0",
    "description": "Drive spaces, file tree, blob upload/download, online-document mounts, shares, invites and IM transfer. The same business surface is served under a bot mount and a user-API-key mount; the CLI picks one from the active credential's token kind (x-octo-mount-by-token-kind), so every command works unchanged as a bot (bf_/app_) or as a real person (uk_)."
  },
  "x-octo-service": "drive",
  "x-octo-base-url": "OCTO_API_BASE_URL",
  "x-octo-space-header": false,
  "x-octo-allowed-token-kinds": ["user_key", "user_bot", "app_bot"],
  "x-octo-mount-by-token-kind": {
    "user_key": "/v1/user/drive",
    "user_bot": "/v1/bot/drive",
    "app_bot": "/v1/bot/drive"
  },
  "paths": {
    "/v1/bot/drive/spaces": {
      "post": {
        "operationId": "drive.space.create",
        "summary": "Create a shared drive space in the caller's Octo Space",
        "x-octo-risk": "write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 255, "description": "shared space display name (UTF-8, 255 bytes max)" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Space" } } } }
        }
      },
      "get": {
        "operationId": "drive.space.list",
        "summary": "List drive spaces the caller can access",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "page_index", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "1-based page number; currently only shapes the response page envelope" },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "page size; the backend still returns the full list" }
        ],
        "responses": {
          "200": {
            "description": "Spaces",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "spaces": { "type": "array", "items": { "$ref": "#/components/schemas/Space" } },
                    "page": { "$ref": "#/components/schemas/Page" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/spaces/personal": {
      "post": {
        "operationId": "drive.space.ensure-personal",
        "summary": "Get or create the caller's personal drive space (idempotent)",
        "x-octo-risk": "write",
        "responses": {
          "200": { "description": "Personal space", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Space" } } } }
        }
      }
    },
    "/v1/bot/drive/spaces/{space_id}": {
      "get": {
        "operationId": "drive.space.get",
        "summary": "Read one drive space",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "drive space id (personal:<octo-space>:<uid> or shared:<uuid>)" }
        ],
        "responses": {
          "200": { "description": "Space", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Space" } } } }
        }
      },
      "put": {
        "operationId": "drive.space.rename",
        "summary": "Rename a drive space (admin+)",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "drive space id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string", "maxLength": 255, "description": "new space name" } }
              }
            }
          }
        },
        "responses": { "204": { "description": "Renamed" } }
      },
      "delete": {
        "operationId": "drive.space.delete",
        "summary": "Soft-delete a drive space (admin+)",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "drive space id" }
        ],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/v1/bot/drive/spaces/{space_id}/members": {
      "get": {
        "operationId": "drive.member.list",
        "summary": "List drive space members and their roles",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "drive space id" }
        ],
        "responses": {
          "200": {
            "description": "Members",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "members": { "type": "array", "items": { "$ref": "#/components/schemas/Member" } } }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "drive.member.add",
        "summary": "Add a member to a drive space (admin+)",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "drive space id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uid", "role"],
                "properties": {
                  "uid": { "type": "string", "description": "target user or bot uid" },
                  "role": { "$ref": "#/components/schemas/Role" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Added", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Member" } } } }
        }
      }
    },
    "/v1/bot/drive/spaces/{space_id}/members/{uid}": {
      "put": {
        "operationId": "drive.member.set-role",
        "summary": "Change a member's role (admin+)",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "drive space id" },
          { "name": "uid", "in": "path", "required": true, "schema": { "type": "string" }, "description": "target member uid" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["role"],
                "properties": { "role": { "$ref": "#/components/schemas/Role" } }
              }
            }
          }
        },
        "responses": { "204": { "description": "Updated" } }
      },
      "delete": {
        "operationId": "drive.member.remove",
        "summary": "Remove a member from a drive space (admin+)",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "drive space id" },
          { "name": "uid", "in": "path", "required": true, "schema": { "type": "string" }, "description": "target member uid" }
        ],
        "responses": { "204": { "description": "Removed" } }
      }
    },
    "/v1/bot/drive/browse": {
      "get": {
        "operationId": "drive.browse",
        "summary": "List folders, mounted documents and blobs in one directory",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["entries[].id", "entries[].parent_id"],
        "parameters": [
          { "name": "space_id", "in": "query", "required": true, "schema": { "type": "string" }, "description": "drive space id" },
          { "name": "parent_id", "in": "query", "schema": { "type": "integer", "format": "uint64", "default": 0 }, "description": "parent folder id; 0 is the space root" },
          { "name": "type", "in": "query", "schema": { "type": "string", "default": "all", "enum": ["all", "doc", "blob", "folder"] }, "description": "node-type filter" },
          { "name": "source", "in": "query", "schema": { "type": "string", "default": "all", "enum": ["all", "user-upload", "im-transfer", "user-mount", "docs-sync"] }, "description": "origin filter" },
          { "name": "page_index", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "1-based page number for the response page envelope" },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "page size for the response page envelope" }
        ],
        "responses": {
          "200": {
            "description": "Directory listing. entries is the complete result set; page is an envelope, not a database page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entries": { "type": "array", "items": { "$ref": "#/components/schemas/DriveEntry" } },
                    "page": { "$ref": "#/components/schemas/Page" },
                    "filter": {
                      "type": "object",
                      "properties": {
                        "type": { "type": "string" },
                        "source": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/search": {
      "post": {
        "operationId": "drive.search",
        "summary": "Full-text search files, folders and mounted documents across the caller's drive spaces",
        "description": "Full-text search over the caller's visible drive. Matches file/folder names and blob/doc bodies (OCR/extracted text) via OpenSearch, gated by the spaces the caller is a member of. Same command for a real person (uk_, routed to /v1/user/drive/search) and a bot (bf_/app_, routed to /v1/bot/drive/search); results are always scoped to what the active identity's uid can see, so a bot only sees spaces it was added to. Scalar request fields use flags; advanced filtering is a nested `filters` object in the request JSON supplied with --data, not a separate --filters flag. Requires the drive search backend (OpenSearch) to be configured on the server, otherwise it returns 503 unavailable.",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["items[].file_id", "items[].parent_id"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["q"],
                "properties": {
                  "q": { "type": "string", "description": "full-text query; matches names (weighted higher) and blob/doc bodies. Required and non-empty." },
                  "scope": { "type": "string", "enum": ["all", "space"], "default": "all", "description": "search radius: all visible spaces (default) or one space (requires --space-id)" },
                  "space_id": { "type": "string", "description": "drive space id to restrict to; required when --scope=space, ignored otherwise" },
                  "page_index": { "type": "integer", "default": 0, "description": "0-based page number" },
                  "page_size": { "type": "integer", "default": 20, "description": "page size (server caps to its max, default max 50)" },
                  "filters": {
                    "type": "object",
                    "description": "Advanced search filters, nested under filters in the request JSON passed with --data. Example: --data '{\"filters\":{\"types\":[\"blob\"],\"owner_scope\":\"me\"}}'.",
                    "properties": {
                      "types": { "type": "array", "description": "Include only these node types; absent or empty means no type restriction.", "items": { "type": "string", "enum": ["folder", "doc", "blob"] } },
                      "owner_scope": { "type": ["string", "null"], "enum": ["", "me", "others", null], "description": "Filter by whether the caller owns the item; omitted, empty, or null means no ownership restriction." },
                      "updated_after": { "type": "string", "format": "date-time", "description": "Match items updated at or after this RFC3339 timestamp." },
                      "size_min": { "type": ["integer", "null"], "format": "uint64", "description": "Minimum size in bytes; null means no lower bound. Must not exceed size_max when both are supplied." },
                      "size_max": { "type": ["integer", "null"], "format": "uint64", "description": "Maximum size in bytes; null means no upper bound. Must be at least size_min when both are supplied." }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results. total is a lower-bound estimate of the union across the name and body indexes; truncated=true means the visible-doc set or an index page hit an internal cap and some body hits may be missing.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResult" }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/folders": {
      "post": {
        "operationId": "drive.folder.create",
        "summary": "Create a folder",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["id", "parent_id"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["space_id", "name"],
                "properties": {
                  "space_id": { "type": "string", "description": "drive space id" },
                  "parent_id": { "type": "integer", "format": "uint64", "default": 0, "description": "parent folder id; 0 is the space root" },
                  "name": { "type": "string", "description": "folder name" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DriveEntry" } } } }
        }
      }
    },
    "/v1/bot/drive/folders/{space_id}/{parent_id}": {
      "get": {
        "operationId": "drive.folder.list",
        "summary": "List the direct children of one folder",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["files[].id", "files[].parent_id"],
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "drive space id" },
          { "name": "parent_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "parent folder id; 0 is the space root" }
        ],
        "responses": {
          "200": {
            "description": "Children",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "files": { "type": "array", "items": { "$ref": "#/components/schemas/DriveEntry" } } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/folders/{folder_id}/rename": {
      "patch": {
        "operationId": "drive.folder.rename",
        "summary": "Rename a folder",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "folder_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "folder node id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string", "description": "new folder name" } }
              }
            }
          }
        },
        "responses": { "204": { "description": "Renamed" } }
      }
    },
    "/v1/bot/drive/folders/{folder_id}/move": {
      "patch": {
        "operationId": "drive.folder.move",
        "summary": "Move a folder to another parent",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "folder_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "folder node id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["parent_id"],
                "properties": {
                  "parent_id": { "type": "integer", "format": "uint64", "description": "new parent folder id; 0 is the space root" },
                  "target_space_id": { "type": "string", "description": "optional destination Drive space id; omitted keeps the current space" },
                  "on_conflict": { "type": "string", "description": "Accepted for wire compatibility but currently ignored by the backend; duplicate sibling names are allowed and no automatic rename is performed." }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Moved" } }
      }
    },
    "/v1/bot/drive/folders/{folder_id}": {
      "delete": {
        "operationId": "drive.folder.delete",
        "summary": "Soft-delete a folder and its subtree",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          { "name": "folder_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "folder node id" }
        ],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/v1/bot/drive/files/{file_id}": {
      "get": {
        "operationId": "drive.file.get",
        "summary": "Read one file-tree node by its unified drive file id",
        "description": "Returns the node regardless of kind. type decides the branch: blob (object storage), doc (online document; ref_id is the doc id and doc_space_id its real Octo Space) or folder.",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["id", "parent_id"],
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "unified drive file id from browse / folder / upload / doc mount / im-transfer" }
        ],
        "responses": {
          "200": { "description": "Node", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DriveEntry" } } } }
        }
      }
    },
    "/v1/bot/drive/files/{file_id}/move": {
      "post": {
        "operationId": "drive.file.move",
        "summary": "Move any file-tree node to another parent",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "node id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["parent_id"],
                "properties": {
                  "parent_id": { "type": "integer", "format": "uint64", "description": "new parent folder id; 0 is the space root" },
                  "target_space_id": { "type": "string", "description": "optional destination Drive space id; omitted keeps the current space" },
                  "on_conflict": { "type": "string", "description": "Accepted for wire compatibility but currently ignored by the backend; duplicate sibling names are allowed and no automatic rename is performed." }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Moved" } }
      }
    },
    "/v1/bot/drive/files/{file_id}/copy": {
      "post": {
        "operationId": "drive.file.copy",
        "summary": "Copy a file or a whole folder subtree",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["root.id", "root.parent_id"],
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "source node id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["parent_id"],
                "properties": {
                  "parent_id": { "type": "integer", "format": "uint64", "description": "destination parent folder id" },
                  "name": { "type": "string", "description": "name for the copied root node; defaults to the source name" },
                  "target_space_id": { "type": "string", "description": "optional destination Drive space id; omitted keeps the current space" },
                  "on_conflict": { "type": "string", "description": "Accepted for wire compatibility but currently ignored by the backend; duplicate sibling names are allowed and no automatic rename is performed." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Copied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "root": { "$ref": "#/components/schemas/FileNode" },
                    "total_rows": { "type": "integer", "description": "number of rows copied, including descendants" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/files/{file_id}/rename": {
      "post": {
        "operationId": "drive.file.rename",
        "summary": "Rename any file-tree node",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "node id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string", "description": "new name" } }
              }
            }
          }
        },
        "responses": { "204": { "description": "Renamed" } }
      }
    },
    "/v1/bot/drive/blobs": {
      "post": {
        "operationId": "drive.blob.create",
        "summary": "Register an existing object-storage key as a blob (low-level)",
        "description": "Compatibility endpoint for objects already in storage. New uploads should use `drive upload file`, which runs prepare → PUT → confirm. The backend VERIFIES the object: an object_path storage does not hold is rejected with invalid_argument, and a `size` that conflicts with the stored object's is rejected too. A row created here carries no persisted download URL, so `share download` on it reports not_found — use `drive upload file` when you need a shareable blob.",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["id", "parent_id"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["space_id", "name", "object_path", "size", "content_type"],
                "properties": {
                  "space_id": { "type": "string", "description": "drive space id" },
                  "parent_id": { "type": "integer", "format": "uint64", "default": 0, "description": "parent folder id" },
                  "name": { "type": "string", "description": "file name" },
                  "object_path": { "type": "string", "description": "object-storage key (not a URL). Must already be in storage — the backend probes it and rejects a key it cannot find" },
                  "size": { "type": "integer", "format": "uint64", "description": "exact byte count; the backend compares it against the stored object and rejects a mismatch when storage discloses a length. 0 is a stated value, not an omission — pass the real count" },
                  "content_type": { "type": "string", "description": "MIME type" },
                  "source": { "type": "string", "default": "user-upload", "enum": ["user-upload", "im-transfer"], "description": "origin tag" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Blob" } } } }
        }
      },
      "get": {
        "operationId": "drive.blob.list",
        "summary": "List blobs in one directory",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["blobs[].id", "blobs[].parent_id"],
        "parameters": [
          { "name": "space_id", "in": "query", "required": true, "schema": { "type": "string" }, "description": "drive space id" },
          { "name": "parent_id", "in": "query", "schema": { "type": "integer", "format": "uint64", "default": 0 }, "description": "parent folder id" }
        ],
        "responses": {
          "200": {
            "description": "Blobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "blobs": { "type": "array", "items": { "$ref": "#/components/schemas/Blob" } } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/blobs/{blob_id}": {
      "get": {
        "operationId": "drive.blob.get",
        "summary": "Read one blob's metadata",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["id", "parent_id"],
        "parameters": [
          { "name": "blob_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "blob node id" }
        ],
        "responses": {
          "200": { "description": "Blob", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Blob" } } } }
        }
      },
      "delete": {
        "operationId": "drive.blob.delete",
        "summary": "Soft-delete a blob",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          { "name": "blob_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "blob node id" }
        ],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/v1/bot/drive/files/prepare-upload": {
      "post": {
        "operationId": "drive.upload.prepare",
        "summary": "Create a pending file and get presigned PUT parameters (low-level)",
        "description": "Step 1 of 3. `drive upload file` runs the whole sequence; use this only when driving the PUT yourself. The PUT must echo content_type (and content_disposition when present) and send exactly max_file_size bytes, with no Authorization header.",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["file_id"],
        "parameters": [
          { "name": "X-Drive-Upload-Capabilities", "in": "header", "required": false, "x-octo-flag": "upload-capabilities", "schema": { "type": "string" }, "description": "set to multipart-v1 to declare multipart upload support; required only when the server selects multipart for an eligible large file" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["space_id", "name", "size", "content_type"],
                "properties": {
                  "space_id": { "type": "string", "description": "destination drive space id" },
                  "parent_id": { "type": "integer", "format": "uint64", "default": 0, "description": "destination folder id" },
                  "name": { "type": "string", "description": "file name in the drive" },
                  "size": { "type": "integer", "format": "uint64", "description": "exact byte count; signed into the presigned URL" },
                  "content_type": { "type": "string", "description": "MIME type; must be echoed on the PUT" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Prepared", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PrepareUpload" } } } }
        }
      }
    },
    "/v1/bot/drive/files/{file_id}/confirm-upload": {
      "post": {
        "operationId": "drive.upload.confirm",
        "summary": "Confirm a pending upload after the object PUT succeeded (low-level)",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["id", "parent_id"],
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "file_id returned by prepare" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actual_size": { "type": "integer", "format": "uint64", "description": "bytes actually uploaded; must match the prepared size when supplied" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Confirmed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Blob" } } } }
        }
      }
    },
    "/v1/bot/drive/files/{file_id}/cancel-upload": {
      "post": {
        "operationId": "drive.upload.cancel",
        "summary": "Cancel a pending upload (idempotent, low-level)",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "pending file_id" }
        ],
        "responses": { "204": { "description": "Cancelled; repeating the call also succeeds" } }
      }
    },
    "/v1/bot/drive/files/{file_id}/upload/parts-presign": {
      "post": {
        "operationId": "drive.upload.parts_presign",
        "summary": "Get presigned URLs for a batch of multipart upload parts (low-level)",
        "description": "Request at most 20 one-based part numbers at a time. Each URL is short-lived and intended only for the corresponding object-storage PUT; never log it or include it in error messages. The optional response part_size is for re-signing alignment only: use the part_size from prepare-upload as the authoritative value.",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "pending multipart drive file id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["upload_id", "part_numbers"],
                "properties": {
                  "upload_id": { "type": "string", "description": "multipart upload id returned by prepare-upload; this is not a credential" },
                  "part_numbers": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": { "type": "integer", "format": "uint64", "minimum": 1, "maximum": 10000 },
                    "description": "one-based part numbers to sign, with at most 20 entries per request"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned parts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["parts"],
                  "properties": {
                    "parts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["part_number", "url", "expires_at"],
                        "properties": {
                          "part_number": { "type": "integer", "format": "uint64", "description": "one-based part number" },
                          "url": { "type": "string", "x-octo-secret": true, "description": "short-lived presigned PUT URL; never log it or include it in error output" },
                          "expires_at": { "type": "string", "description": "per-part expiry; the only client signal that this part URL must be re-signed" }
                        }
                      }
                    },
                    "part_size": { "type": "integer", "format": "uint64", "description": "optional server part size in bytes for re-sign alignment; the server has already converted KiB to bytes, so the client slices by bytes directly and must not convert again; prepare-upload remains authoritative" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/files/{file_id}/upload/complete": {
      "post": {
        "operationId": "drive.upload.complete",
        "summary": "Complete and verify a multipart upload (idempotent, low-level)",
        "description": "Submit the uploaded parts in ascending part_number order. Repeating this operation for the same upload_id is idempotent. The response size is the object size verified by the server after completing the upload.",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["file.id", "file.parent_id"],
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "pending multipart drive file id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["upload_id", "parts"],
                "properties": {
                  "upload_id": { "type": "string", "description": "multipart upload id returned by prepare-upload; this is not a credential" },
                  "parts": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "required": ["part_number", "etag"],
                      "properties": {
                        "part_number": { "type": "integer", "format": "uint64", "minimum": 1, "maximum": 10000, "description": "one-based part number, ordered ascending for complete" },
                        "etag": { "type": "string", "description": "object-storage ETag returned by the part PUT" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed and verified; repeating the call for the same upload_id also succeeds",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["file", "size"],
                  "properties": {
                    "file": { "$ref": "#/components/schemas/Blob" },
                    "size": { "type": "integer", "format": "uint64", "description": "object size verified by the server after completion" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/files/{file_id}/upload/abort": {
      "post": {
        "operationId": "drive.upload.abort",
        "summary": "Abort an incomplete multipart upload (idempotent, low-level)",
        "description": "Repeating this operation for the same upload_id is idempotent. If completion already won, the server returns upload_session_not_active; do not retry the same upload_id.",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "pending multipart drive file id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["upload_id"],
                "properties": {
                  "upload_id": { "type": "string", "description": "multipart upload id returned by prepare-upload; this is not a credential" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aborted; repeating the call for the same upload_id also succeeds",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": {
                    "ok": { "type": "boolean", "description": "true when the incomplete multipart upload is not active" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/files/{file_id}/download": {
      "get": {
        "operationId": "drive.download.url",
        "summary": "Get a short-lived signed download URL for a blob (low-level)",
        "description": "Returns the URL only. `drive download file` fetches the bytes with a credential-free client and writes them atomically.",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "confirmed blob node id" }
        ],
        "responses": {
          "200": { "description": "Signed URL", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DownloadURL" } } } }
        }
      }
    },
    "/v1/bot/drive/docs": {
      "post": {
        "operationId": "drive.doc.mount",
        "summary": "Mount an accessible online document into the drive",
        "description": "The title and the document's real Octo Space are read server-side from the document metadata by doc_id; a client-supplied doc_title is ignored.",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["id", "parent_id"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["space_id", "doc_id"],
                "properties": {
                  "space_id": { "type": "string", "description": "destination drive space id" },
                  "parent_id": { "type": "integer", "format": "uint64", "default": 0, "description": "destination folder id" },
                  "doc_id": { "type": "string", "description": "document id from drive doc candidates" },
                  "source": { "type": "string", "default": "user-mount", "enum": ["user-mount", "docs-sync"], "description": "origin tag; octo-drive's allowedMountSources accepts both (user-upload / im-transfer are Type-2 only and are rejected)" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Mounted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocRef" } } } }
        }
      },
      "get": {
        "operationId": "drive.doc.list",
        "summary": "List mounted online documents in one directory",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["docs[].id", "docs[].parent_id"],
        "parameters": [
          { "name": "space_id", "in": "query", "required": true, "schema": { "type": "string" }, "description": "drive space id" },
          { "name": "parent_id", "in": "query", "schema": { "type": "integer", "format": "uint64", "default": 0 }, "description": "parent folder id" }
        ],
        "responses": {
          "200": {
            "description": "Mounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "docs": { "type": "array", "items": { "$ref": "#/components/schemas/DocRef" } } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/docs/{file_id}": {
      "delete": {
        "operationId": "drive.doc.unmount",
        "summary": "Remove a document mount; the document itself is untouched",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "mount node id (NOT the doc id)" }
        ],
        "responses": { "204": { "description": "Unmounted" } }
      }
    },
    "/v1/bot/drive/mountable-docs": {
      "get": {
        "operationId": "drive.doc.candidates",
        "summary": "List documents the caller may mount that are not yet mounted here",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "space_id", "in": "query", "required": true, "schema": { "type": "string" }, "description": "destination drive space id" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "1-based page number (a real database page)" },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 50 }, "description": "page size" }
        ],
        "responses": {
          "200": {
            "description": "Candidates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/MountableDoc" } },
                    "page": { "$ref": "#/components/schemas/Page" },
                    "total": { "type": "integer", "description": "total candidate count" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/shares": {
      "post": {
        "operationId": "drive.share.blob-create",
        "summary": "Create a blob share token (low-level)",
        "description": "Prefer `drive share create`, which detects blob vs document and returns a ready-to-hand-over share_url. This is the raw token API for automation that manages passwords, expiry, or revocation directly; the CLI leaf takes <file-id> positionally.",
        "x-octo-risk": "write",
        "x-octo-response-fields": { "id": ["share_id", "share_token"], "file_id": ["drive_file_id"] },
        "x-octo-lossless-id-fields": ["drive_file_id"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["file_id"],
                "properties": {
                  "file_id": { "type": "integer", "format": "uint64", "description": "confirmed blob node id" },
                  "permission": { "type": "string", "default": "view", "enum": ["view", "download"], "description": "what the receiver may do. When the field is omitted the backend stores view (preview only; share download then fails with permission_denied). The hand-written `drive share blob-create` command always sends --permission, which defaults to download." },
                  "expires_in_seconds": { "type": "integer", "default": 0, "minimum": 0, "description": "0 uses the backend default (7 days); negative values are rejected" },
                  "password": { "type": "string", "maxLength": 72, "x-octo-secret": true, "description": "optional share password; hand it over out of band, never in the URL" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Share" } } } }
        }
      },
      "get": {
        "operationId": "drive.share.list",
        "summary": "List the shares the caller created",
        "x-octo-risk": "read",
        "x-octo-response-fields": { "shares[].id": ["share_id", "share_token"], "shares[].file_id": ["drive_file_id"] },
        "x-octo-lossless-id-fields": ["shares[].drive_file_id"],
        "responses": {
          "200": {
            "description": "Shares",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "shares": { "type": "array", "items": { "$ref": "#/components/schemas/Share" } } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/shares/{share_id}": {
      "delete": {
        "operationId": "drive.share.revoke",
        "summary": "Revoke a share; access and download stop working immediately",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          { "name": "share_id", "in": "path", "required": true, "schema": { "type": "string" }, "x-octo-flag": "share-id", "x-octo-secret": true, "description": "share_id from share create / share list. Marked x-octo-secret because the backend returns one opaque id that is both the management handle and the access token, so this value is credential-equivalent today; masking it costs only a masked id in output if a future rotation splits the two. base64url ids may start with \"-\", which cobra would read as a flag: pass --share-id <id>, or put the value after a \"--\" separator" }
        ],
        "responses": { "204": { "description": "Revoked" } }
      }
    },
    "/v1/bot/drive/shares/{share_token}/access": {
      "post": {
        "operationId": "drive.share.access",
        "summary": "Resolve a blob share by its token (low-level; requires a verified identity)",
        "description": "The CLI leaf `drive share access` takes the whole share URL and parses this token out of it. Authentication is always required — there is no anonymous share surface.",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["file_id", "existing_copies[].file_id"],
        "parameters": [
          { "name": "share_token", "in": "path", "required": true, "schema": { "type": "string" }, "x-octo-secret": true, "description": "share token parsed out of the share URL" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "password": { "type": "string", "x-octo-secret": true, "description": "share password when the share is password-protected" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Share target", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ShareAccess" } } } }
        }
      }
    },
    "/v1/bot/drive/shares/{share_token}/download": {
      "post": {
        "operationId": "drive.share.download",
        "summary": "Get the object URL for a shared blob (low-level; requires a verified identity)",
        "description": "The CLI leaf `drive share download` takes the whole share URL, calls this endpoint, then writes the bytes to disk. Authentication is always required — there is no anonymous share surface.",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "share_token", "in": "path", "required": true, "schema": { "type": "string" }, "x-octo-secret": true, "description": "share token parsed out of the share URL" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "password": { "type": "string", "x-octo-secret": true, "description": "share password when the share is password-protected" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Object URL", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ShareDownload" } } } }
        }
      }
    },
    "/v1/bot/drive/spaces/{space_id}/invites": {
      "post": {
        "operationId": "drive.invite.create",
        "summary": "Create a shared-space invite (admin+)",
