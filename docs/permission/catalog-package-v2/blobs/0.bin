                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invite" } } } }
        }
      },
      "get": {
        "operationId": "drive.invite.list",
        "summary": "List a space's live invites (admin+)",
        "x-octo-risk": "read",
        "x-octo-response-fields": { "invites[].id": ["invite_id"], "invites[].space_id": ["drive_space_id"], "invites[].token": ["invite_token"] },
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "shared drive space id" }
        ],
        "responses": {
          "200": {
            "description": "Invites",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "invites": { "type": "array", "items": { "$ref": "#/components/schemas/Invite" } } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/spaces/{space_id}/invites/{invite_id}": {
      "delete": {
        "operationId": "drive.invite.revoke",
        "summary": "Revoke an invite (admin+)",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "shared drive space id" },
          { "name": "invite_id", "in": "path", "required": true, "schema": { "type": "string" }, "x-octo-flag": "invite-id", "description": "invite_id (NOT the invite_token). base64url ids may start with \"-\": pass --invite-id <id>, or put the value after a \"--\" separator" }
        ],
        "responses": { "204": { "description": "Revoked" } }
      }
    },
    "/v1/bot/drive/invites/{invite_token}/accept": {
      "post": {
        "operationId": "drive.invite.accept",
        "summary": "Accept an invite as the current identity (idempotent)",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "invite_token", "in": "path", "required": true, "schema": { "type": "string" }, "x-octo-secret": true, "x-octo-flag": "invite-token", "description": "invite_token from invite create / invite list. base64url tokens may start with \"-\": pass --invite-token <token>, or put the value after a \"--\" separator" }
        ],
        "responses": {
          "200": {
            "description": "Accepted; already_member=true means the identity was already in the space",
