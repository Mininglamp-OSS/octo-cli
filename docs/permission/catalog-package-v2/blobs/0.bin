              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/market/api/v1/plugins/install": {
      "post": {
        "operationId": "plugin.install",
        "summary": "Install an expert / expert_team plugin into a Loop workspace",
        "description": "Provide plugin_id, workspace_id, and runtime_id as flags or in --data. Optional custom_env is a string map supplied through --data; its values are masked in request diagnostics, including --dry-run and --verbose output.",
        "x-octo-risk": "write",
        "x-octo-retry": "never",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "plugin_id": {
                    "type": "string"
                  },
                  "workspace_id": {
                    "type": "string"
                  },
                  "runtime_id": {
                    "type": "string"
                  },
                  "custom_env": {
                    "type": "object",
                    "description": "Environment variable names mapped to sensitive values for the Loop installation.",
                    "additionalProperties": { "type": "string" },
                    "x-octo-secret": true
                  }
                },
                "required": [
                  "plugin_id",
                  "workspace_id",
                  "runtime_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/market/api/v1/plugins/import": {
      "post": {
        "operationId": "plugin.import",
        "summary": "Import a skill plugin from a completed parse task",
        "description": "Finalize a skill upload: pass the parse_task_id from the upload+parse pipeline. Creating requires a non-empty plugin_name and an omitted plugin_id; updating requires plugin_id. Unlike plugin.upsert, this path is NOT a full replace: on update an omitted plugin_name, name, description, category_id, visibility or icon falls back to the existing row rather than clearing it.",
        "x-octo-risk": "write",
        "x-octo-retry": "never",
        "x-octo-body-variants-hint": "all imports require a non-empty --parse-task-id; creating a skill requires a non-empty --plugin-name display name and must omit --plugin-id entirely (blank or null still counts as supplied); updating requires a non-empty --plugin-id and may omit --plugin-name to preserve the current display name, but a supplied --plugin-name must be non-empty",
        "x-octo-body-variants": [
          {
            "name": "create",
            "required": [
              "parse_task_id",
              "plugin_name"
            ],
            "forbidden": [
              "plugin_id"
            ]
          },
          {
            "name": "update-preserve-display-name",
            "required": [
              "parse_task_id",
              "plugin_id"
            ],
            "forbidden": [
              "plugin_name"
            ]
          },
          {
            "name": "update-rename",
            "required": [
              "parse_task_id",
              "plugin_id",
              "plugin_name"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "parse_task_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "plugin_id": {
                    "type": "string",
                    "description": "Set to update an existing skill plugin; omit to create"
                  },
                  "plugin_name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Human-facing marketplace display name written to the plugin_name column and to manifest_json.plugin_name. Distinct from the skill machine name, not a synonym. On create, always supply it explicitly; leaving it empty makes the backend inherit name and exposes the machine slug in the catalog. On update, omit it to preserve the current display name unless the user explicitly requested a rename; when supplied, the value must be non-empty and a different value renames the catalog card."
                  },
                  "name": {
                    "type": "string",
                    "description": "Stable skill machine name written to manifest_json.name and to the SKILL.md frontmatter, normally read from the uploaded package's root SKILL.md. Distinct from plugin_name, not a synonym. On create an omitted value is derived from the uploaded package. On update an omitted value falls back to the existing row."
                  },
                  "description": {
                    "type": "string",
                    "description": "Marketplace description. On update, omission preserves the existing value; on create, the parsed description is used when present."
                  },
                  "category_id": {
                    "type": "string",
                    "description": "Marketplace category ID. On update, omission preserves the existing category."
                  },
                  "tags": {
                    "type": "array",
                    "description": "Marketplace tags; when omitted, tags from the parsed package are used if present.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "space",
                      "private"
                    ]
                  },
                  "icon": {
                    "type": "string",
                    "description": "Optional icon URL for the Skill listing. Use a persistent URL, not a temporary presigned upload URL."
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^\\d{1,9}\\.\\d{1,9}\\.\\d{1,9}$",
                    "description": "MAJOR.MINOR.PATCH version label; cannot move backward"
                  },
                  "changelog": {
                    "type": "string",
                    "description": "Optional release notes stored with the imported version."
                  }
                },
                "required": [
                  "parse_task_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
