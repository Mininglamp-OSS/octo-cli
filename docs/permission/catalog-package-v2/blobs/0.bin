                        "type": "integer",
                        "minimum": 0
                      },
                      "endColumn": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "preview": {
                    "type": "boolean",
                    "default": true,
                    "description": "Defaults to true: return planned cells and counts without writing. Explicitly pass --preview=false to apply with the same base-version."
                  },
                  "header": {
                    "type": "boolean",
                    "default": false,
                    "description": "Keep the first selected row out of duplicate comparisons."
                  },
                  "caseSensitive": {
                    "type": "boolean",
                    "x-octo-flag": "case-sensitive",
