                  "range"
                ],
                "properties": {
                  "logicalId": {
                    "type": "string",
                    "x-octo-flag": "logical-id",
                    "description": "Required logical worksheet ID from docs sheet get."
                  },
                  "range": {
                    "type": "object",
                    "description": "Zero-based source rectangle spanning every column of each record to compact together. Deduplication compares all selected columns; unselected columns do not move. Pass the structured range via --data.",
                    "required": [
                      "startRow",
                      "startColumn",
                      "endRow",
                      "endColumn"
                    ],
                    "properties": {
