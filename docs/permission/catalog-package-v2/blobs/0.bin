                      "type": "boolean"
                    },
                    "baseVersion": {
                      "type": "string"
                    },
                    "range": {
                      "type": "object",
                      "description": "Zero-based affected rectangle of the planned or applied output.",
                      "required": [
                        "startRow",
                        "startColumn",
                        "endRow",
                        "endColumn"
                      ],
                      "properties": {
                        "startRow": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "startColumn": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "endRow": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "endColumn": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "rows": {
                      "type": "integer"
                    },
                    "columns": {
                      "type": "integer"
                    },
                    "removedRows": {
                      "type": "integer"
                    },
                    "overwrittenCells": {
                      "type": "integer"
                    },
                    "cells": {
                      "type": "object",
                      "description": "Planned replacement cells, returned in preview mode only, keyed by logicalId!row:column (zero-based). Values are complete cell objects, or null to clear the cell."
                    },
                    "bytes": {
                      "type": "integer"
