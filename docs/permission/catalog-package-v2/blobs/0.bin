    "/fleet/api/v1/workspaces/{workspace_id}/members": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceIDHeader"
        }
      ],
      "get": {
        "summary": "List Octo Project members",
        "description": "Read workspace members through Fleet. For Octo Project workspaces Fleet verifies the caller's Project access, including its configured verified Bot-owner fallback, then forwards the internally authenticated Server member-list response. The caller remains the Bot. Supply the Project UUID positionally or with --workspace-id. Use page/page_size pagination; CLI JSON exposes the member array as .data[] but does not expose the upstream X-Total-Count header, so continue until a page is shorter than page_size. Legacy limit/offset flags are translated when offset is a multiple of the page size. Legacy workspaces retain their native Fleet member array.",
        "tags": [
          "workspaces"
        ],
        "operationId": "workspace.member.list",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "description": "Octo Project UUID, shared with the Loop workspace identity.",
            "x-octo-flag": "workspace-id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "One-based member page number.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Maximum Project members returned per page (1-200).",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Compatibility alias for --page-size; translated before the request.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Compatibility offset; must be a multiple of the effective page size (default 50) and cannot be combined with --page. The CLI sends that page size with the translated page.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "200": {
            "description": "Member array forwarded by Fleet after authorization. Project member total is in X-Total-Count.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "uid": {
                        "type": "string",
                        "description": "Opaque, case-sensitive Project member ID. Use --assignee-member-id for direct assignment."
                      },
                      "name": {
                        "type": "string"
                      },
                      "role": {
                        "type": "integer",
                        "enum": [
                          0,
                          1,
                          2
                        ],
                        "description": "Project role: 0 common member, 1 admin, 2 owner."
                      },
                      "robot": {
                        "type": "integer",
                        "enum": [
                          0,
                          1
                        ],
                        "description": "0 for a person, 1 for a Bot. Bot seats remain visible in member listings."
                      },
                      "id": {
                        "type": "string",
                        "description": "Legacy workspace membership ID."
                      },
                      "user_id": {
                        "type": "string",
                        "description": "Native Workspace member user UUID, used as assignee_id when assigning that member."
                      },
                      "octo_uid": {
                        "type": "string",
                        "description": "Optional linked identity for a native Workspace member; assignment uses user_id."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-octo-risk": "read"
      },
      "post": {
        "summary": "Add workspace member",
        "description": "Add a member to a legacy workspace. Requires the workspace owner or admin role; project workspaces return 409. The request mode is chosen by its fields: principal_type and principal_id add a same-Space Octo user or bot directly (the principal must be on the Space roster and its type must match; requires Octo authentication and returns 200), while email creates a pending email invitation (returns 201). Email and principal fields cannot be combined. When sent, X-Workspace-ID must equal workspace_id.",
        "tags": [
          "workspaces"
        ],
        "operationId": "workspace.member.add",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "principal_type": {
                    "type": "string",
                    "enum": [
                      "user",
                      "bot"
                    ],
                    "description": "Principal mode: Octo principal type; must match the Space roster entry."
                  },
                  "principal_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Principal mode: Octo uid of the user or bot."
                  },
                  "email": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Invitation mode: invitee email address."
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "member"
                    ],
                    "default": "member",
                    "description": "Member role; owner is rejected. Defaults to member."
                  }
                },
                "oneOf": [
                  {
                    "title": "Principal member",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "principal_type",
                      "principal_id"
                    ],
                    "properties": {
                      "principal_type": {
                        "type": "string",
                        "enum": [
                          "user",
                          "bot"
                        ]
                      },
                      "principal_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "admin",
                          "member"
                        ],
                        "default": "member",
                        "description": "Member role; owner is rejected. Defaults to member."
                      }
                    }
                  },
                  {
                    "title": "Email invitation",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "email"
                    ],
                    "properties": {
                      "email": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "admin",
                          "member"
                        ],
                        "default": "member",
                        "description": "Member role; owner is rejected. Defaults to member."
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "409": {
            "description": "CONFLICT - the workspace is a project workspace whose membership is managed by octo-server, the user is already a member, an invitation is already pending, or the Octo identity exists with a different principal type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE - Octo integration is not configured or the Space roster lookup failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "200": {
            "description": "Principal member added (principal mode); body is the member without a data envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "workspace_id",
                    "user_id",
                    "role",
                    "principal_type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "workspace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "role": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "avatar_url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "principal_type": {
                      "type": "string",
                      "enum": [
                        "user",
                        "bot"
                      ]
                    },
                    "octo_uid": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Invitation created (email mode); body is the invitation without a data envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "workspace_id",
                    "inviter_id",
                    "invitee_email",
                    "role",
                    "status",
                    "expires_at"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "workspace_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "inviter_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "invitee_email": {
                      "type": "string"
                    },
                    "invitee_user_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "role": {
                      "type": "string"
