    "/v1/bot/docs/recent": {
      "get": {
        "operationId": "docs.recent.list",
        "summary": "List documents the bot recently viewed (keyset-paginated, newest first)",
        "description": "Scoped to the bot uid and its server-resolved Space; deleted, archived or no-longer-permitted documents drop out at query time. Returns {total, items, nextCursor}; pass --cursor with the returned nextCursor for the next page, or --page-all to follow it. A malformed cursor returns 400 invalid_cursor.",
        "x-octo-risk": "read",
        "x-octo-pagination": {
          "cursorParam": "cursor",
          "itemsField": "items",
          "cursorField": "nextCursor",
          "inferHasMore": true,
          "rejectCursorRepeats": true
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "title keyword filter"
          },
          {
            "name": "creator",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "repeatable owner uid filter"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "doc",
                  "sheet",
                  "board",
                  "html",
                  "html_ppt"
                ]
              }
            },
            "description": "repeatable document kind filter"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "opaque nextCursor from the previous page"
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "description": "items per page (clamped to 1-100, default 20)"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of recently viewed documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "docId": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "ownerId": {
                            "type": "string"
                          },
                          "isExternal": {
                            "type": "boolean"
                          },
                          "docType": {
                            "type": "string"
                          },
                          "octoDocSlug": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string"
                          },
                          "updatedBy": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "uid": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          "viewedAt": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/recent/creators": {
      "get": {
        "operationId": "docs.recent.creators",
        "summary": "List distinct creators of the bot's recently viewed documents",
        "description": "Same scope and permission filtering as docs recent list, filtered by q but not by creator. Display names are resolved server-side; an unresolved uid falls back to the uid as its name.",
