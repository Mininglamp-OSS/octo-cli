            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "html.comment.reanchor",
        "summary": "Move a comment's anchor (own comment, or manage)",
        "description": "Re-anchor a comment or reply (id in the JSON body) to new text or an element, recorded at the given version; this also resets the thread's applied status. Requires comment capability on the document (hidden 404 otherwise); the caller must be the comment's author unless it holds manage capability, else 403 not_author. Duplicate JSON keys are rejected. Bot bearer tokens are honored only when the octo-docs-html deployment sets BOT_AUTH_ENABLED=true (default false) and OCTO_SERVER_BASE_URL is configured; otherwise a bot token is not recognized and the call fails like an unauthenticated one. A bot's capability on the document comes from the bot itself (document creator or member) or from its owner (owner is the creator or a document admin).",
        "x-octo-risk": "write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slug",
                  "id",
                  "anchor"
                ],
                "properties": {
                  "slug": {
                    "type": "string",
                    "description": "Document reference: canonical doc_id for a new document, or the retained legacy slug for an old document. The wire name remains slug for server compatibility."
                  },
                  "id": {
                    "type": "string",
                    "description": "Comment or reply id to re-anchor."
                  },
                  "anchor": {
                    "type": "object",
                    "description": "New anchor. kind is text, element or lost; text anchors use text/context_before/context_after, element anchors use aid/selector/label.",
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "context_before": {
                        "type": "string"
                      },
                      "context_after": {
                        "type": "string"
                      },
                      "aid": {
                        "type": "string"
                      },
                      "selector": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      },
                      "fingerprint": {
                        "type": "object"
                      },
                      "fallback": {
                        "type": "object"
                      }
                    }
                  },
                  "version": {
                    "type": "string",
                    "description": "Document version the mutation applies to: a positive integer (as text, optionally prefixed with v) or latest. Omitted or 0 means version 1; a version above the current latest is rejected."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated comment snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "html.comment.rm",
        "summary": "Delete one comment, or wipe every comment with all=1",
        "description": "With id: soft-delete one comment or reply; requires comment capability (hidden 404 otherwise) and the caller must be its author unless it holds edit capability (403 not_author). With all=1: permanently remove every comment on the document; requires manage capability (hidden 404 otherwise) and ignores id. Returns {ok:true} or {ok:true, deleted:n}. Bot bearer tokens are honored only when the octo-docs-html deployment sets BOT_AUTH_ENABLED=true (default false) and OCTO_SERVER_BASE_URL is configured; otherwise a bot token is not recognized and the call fails like an unauthenticated one. A bot's capability on the document comes from the bot itself (document creator or member) or from its owner (owner is the creator or a document admin).",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "required": true,
            "description": "Document reference: canonical doc_id for a new document, or the retained legacy slug for an old document. The wire name remains slug for server compatibility.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Comment or reply id to delete; required unless all=1.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "all",
            "in": "query",
            "description": "Exactly 1 wipes every comment on the document (manage capability); any other value is ignored.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "description": "Version at which the deletion is recorded; omit for latest.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "deleted": {
                      "type": "integer",
                      "description": "Number of comments removed (all=1 only)."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
