    "/v1/bot/docs/{docId}/ppt/media": {
      "post": {
        "operationId": "docs.ppt.media.upload",
        "summary": "Upload one local media file into a PPT document (writer, html_ppt only)",
        "description": "Sends the file bytes as the raw request body (not multipart). X-Media-Type is required and must be one of image/svg+xml, image/png, image/jpeg, image/webp, image/gif, image/avif, image/bmp, video/mp4, video/webm, video/ogg, video/quicktime, audio/mpeg, audio/mp4, audio/webm, audio/ogg, audio/wav, audio/x-wav, audio/flac (anything else is 400 unsupported_media_type). The limit is the smaller of the attachment size limit and 50 MiB; SVG is limited to 1 MiB and sanitized. Requires writer on an html_ppt document; authorization is re-checked after the object upload. Reference the result in the deck as ppt-media:<attachId>.",
        "x-octo-risk": "write",
        "x-octo-raw-body": true,
        "x-octo-raw-body-max-bytes": 52428800,
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Media-Type",
            "in": "header",
            "required": true,
            "x-octo-flag": "media-type",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "media MIME type of the file (see the operation description for the allowed list)"
          },
          {
            "name": "X-File-Name",
            "in": "header",
            "required": false,
            "x-octo-flag": "file-name",
            "schema": {
              "type": "string",
              "maxLength": 1024
            },
            "description": "optional file name, URI-encoded (encodeURIComponent); the backend keeps the last path segment and sanitizes it"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored media reference",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "ref": {
                          "type": "string"
                        },
                        "attachId": {
                          "type": "string"
                        },
                        "mime": {
                          "type": "string"
                        },
                        "sizeBytes": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/attachments/svg": {
      "post": {
        "operationId": "docs.attachments.svg-upload",
        "summary": "Upload an SVG image as a document attachment (writer)",
        "description": "Sends the SVG markup as the raw request body (image/svg+xml, not multipart). The backend sanitizes the SVG and refuses bodies over 1 MiB (413 size_too_large), empty bodies (400 invalid_svg) and markup the sanitizer rejects (400). Requires writer on the document. 502 upload_failed when object storage refuses the write.",
