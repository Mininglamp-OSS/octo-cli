  "components": {
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Loop credential or supported long-lived Octo server credential."
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "One-based page number.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "description": "Number of resources per page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "TaskStatus": {
        "name": "status",
        "in": "query",
        "description": "One status or a comma-separated status union. The plural statuses parameter takes precedence when non-empty.",
        "schema": {
          "type": "string"
        }
      },
      "TaskStatuses": {
        "name": "statuses",
        "in": "query",
        "description": "Comma-separated status union; when non-empty this takes precedence over status.",
        "schema": {
          "type": "string"
        }
      },
      "TaskPriority": {
        "name": "priority",
        "in": "query",
        "description": "One priority or a comma-separated priority union. The plural priorities parameter takes precedence when non-empty.",
        "schema": {
          "type": "string"
        }
      },
      "TaskPriorities": {
        "name": "priorities",
        "in": "query",
        "description": "Comma-separated priority union; when non-empty this takes precedence over priority.",
        "schema": {
          "type": "string"
        }
      },
      "TaskAssigneeTypes": {
        "name": "assignee_types",
        "in": "query",
        "description": "Comma-separated assignee actor types: member, expert, or expert_team.",
        "schema": {
          "type": "string"
        }
      },
      "TaskAssigneeID": {
        "name": "assignee_id",
        "in": "query",
        "description": "Exact expert, expert-team, or native Workspace member user UUID. Project members use --assignee-member-id.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "TaskAssigneeIDs": {
        "name": "assignee_ids",
        "in": "query",
        "description": "Comma-separated expert, expert-team, or native Workspace member user UUIDs; matching assignees form a union. Project members use --assignee-member-ids.",
        "schema": {
          "type": "string"
        }
      },
      "TaskAssigneeOctoUID": {
        "name": "assignee_octo_uid",
        "in": "query",
        "x-octo-flag": "assignee-member-id",
        "description": "Exact Project member ID from the member list. Mutually exclusive with assignee ID and member-ID list filters.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "TaskAssigneeOctoUIDs": {
        "name": "assignee_octo_uids",
        "in": "query",
        "x-octo-flag": "assignee-member-ids",
        "description": "Comma-separated exact Project member IDs, at most 100. Mutually exclusive with assignee ID and single member-ID filters.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "TaskAssigneeFilters": {
        "name": "assignee_filters",
        "in": "query",
        "description": "Comma-separated typed assignees in public form <member|expert|expert_team>:<UUID>.",
        "schema": {
          "type": "string"
        }
      },
      "TaskCreatorID": {
        "name": "creator_id",
        "in": "query",
        "description": "Exact task creator UUID. Project member creators use --creator-member-id.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "TaskCreatorIDs": {
        "name": "creator_ids",
        "in": "query",
        "description": "Comma-separated task creator UUIDs; matching creators form a union. Project member creators use --creator-member-ids.",
        "schema": {
          "type": "string"
        }
      },
      "TaskCreatorOctoUID": {
        "name": "creator_octo_uid",
        "in": "query",
        "x-octo-flag": "creator-member-id",
        "description": "Exact Project member ID of the task creator. Mutually exclusive with creator ID and member-ID list filters.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "TaskCreatorOctoUIDs": {
        "name": "creator_octo_uids",
        "in": "query",
        "x-octo-flag": "creator-member-ids",
        "description": "Comma-separated exact Project member IDs of task creators, at most 100. Mutually exclusive with creator ID and single member-ID filters.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "TaskCreatorFilters": {
        "name": "creator_filters",
        "in": "query",
        "description": "Comma-separated typed creators in public form <member|expert|expert_team>:<UUID>.",
        "schema": {
          "type": "string"
        }
      },
      "TaskLabelIDs": {
        "name": "label_ids",
        "in": "query",
        "description": "Comma-separated label UUIDs; tasks with any selected label match.",
        "schema": {
          "type": "string"
        }
      },
      "TaskIncludeNoAssignee": {
        "name": "include_no_assignee",
        "in": "query",
        "description": "Include unassigned tasks in the assignee filter.",
        "schema": {
          "type": "boolean"
        }
      },
      "TaskInvolvesUserID": {
        "name": "involves_user_id",
        "in": "query",
        "description": "Filter to tasks involving this workspace user through an expert or expert-team assignment.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "TaskMetadata": {
        "name": "metadata",
        "in": "query",
        "description": "Flat JSON object of metadata key/value primitives used for containment matching.",
        "schema": {
          "type": "string"
        }
      },
      "TaskDateField": {
        "name": "date_field",
        "in": "query",
        "description": "Timestamp field selected by the date range; supply with date_start and date_end.",
        "schema": {
          "type": "string",
          "enum": [
            "created_at",
            "updated_at"
          ]
        }
      },
      "TaskDateStart": {
        "name": "date_start",
        "in": "query",
        "description": "Inclusive RFC3339 timestamp starting the selected date range; supply all three date filters together.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "TaskDateEnd": {
        "name": "date_end",
        "in": "query",
        "description": "Exclusive RFC3339 timestamp ending the selected date range; supply all three date filters together.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "TaskOpenOnly": {
        "name": "open_only",
        "in": "query",
        "description": "When true, exclude tasks in done or cancelled status.",
        "schema": {
          "type": "boolean"
        }
      },
      "TaskScheduled": {
        "name": "scheduled",
        "in": "query",
        "description": "When true, include only tasks with a start date or due date.",
        "schema": {
          "type": "boolean"
        }
      },
      "TaskSort": {
        "name": "sort",
        "in": "query",
        "description": "Sort tasks by position, title, created_at, start_date, due_date, or priority; defaults to position.",
        "schema": {
          "type": "string",
          "enum": [
            "position",
            "title",
            "created_at",
            "start_date",
            "due_date",
            "priority"
          ]
        }
      },
      "TaskDirection": {
        "name": "direction",
        "in": "query",
        "description": "Sort direction asc or desc (case-insensitive); ignored for position sorting.",
        "schema": {
          "type": "string"
        }
      },
      "TaskGroupBy": {
        "name": "group_by",
        "in": "query",
        "description": "Grouping dimension; only assignee is supported and is the default.",
