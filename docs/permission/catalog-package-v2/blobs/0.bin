              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "space_id": { "type": "string" },
                    "role": { "type": "string" },
                    "already_member": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/blobs/transfer-from-im": {
      "post": {
        "operationId": "drive.im-transfer.create",
        "summary": "Save an IM attachment into the drive (idempotent)",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["id", "parent_id"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["im_group_no", "im_channel_type", "im_msg_id", "target_space_id"],
                "properties": {
                  "im_group_no": { "type": "string", "description": "group/channel id from octo-cli message search files" },
                  "im_channel_type": { "type": "integer", "enum": [1, 2, 5], "description": "channel kind of the source message: 1=DM, 2=group, 5=thread. Required, and it must be the kind the message actually came from, for two reasons. (1) It picks the upstream message-read route: 1 uses the person/DM route, while 2 and 5 share the group route (group vs sub-thread is chosen by the composite group_no, not by this field), so 1 vs 2/5 resolves a different message or nothing. (2) It is stored as the first segment of the row's source_key (channelType#channelID#msgID), which blobs/im-transferred/batch matches on — a wrong value makes that already-transferred lookup miss the row. It is NOT the transfer idempotency key: that is (target space, type=blob, object path), so a wrong value cannot produce a duplicate file." },
                  "im_msg_id": { "type": "string", "description": "message id as a string — never a JSON number, which would lose precision" },
                  "target_space_id": { "type": "string", "description": "destination drive space id" },
                  "target_parent_id": { "type": "integer", "format": "uint64", "default": 0, "description": "destination folder id" },
                  "name_override": { "type": "string", "description": "replaces the attachment's original name" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Transferred", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransferResult" } } } },
          "200": { "description": "Idempotent replay — a pre-existing row is returned with idempotent=true" }
        }
      }
    },
    "/v1/bot/drive/hello": {
      "get": {
        "operationId": "drive.hello",
        "summary": "Probe the drive mount and report the verified caller identity",
        "description": "Connectivity and identity check. Only the mount's auth middleware runs (verify-bot for bf_/app_ on /v1/bot/drive, verify-api-key for uk_ on /v1/user/drive); no drive data is read. app_ tokens are rejected by verify-bot with 401.",
        "x-octo-risk": "read",
        "responses": {
          "200": {
            "description": "Identity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "description": "fixed greeting naming the mount" },
                    "uid": { "type": "string", "description": "verified caller uid (the bot uid on the bot mount)" },
                    "space_id": { "type": "string", "description": "Octo Space bound to the credential during verification (NOT a drive space id)" },
                    "is_bot": { "type": "boolean", "description": "user-API-key mount only" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/files/{file_id}/ancestors": {
      "get": {
        "operationId": "drive.file.ancestors",
        "summary": "List the folder path from the space root to a node's parent",
        "description": "Root-first chain of folders above the node; the node itself is not included and a root-level node returns an empty list. Any live member of the node's drive space may read it. A pending or unknown node returns not_found. The walk stops early (partial chain) when a parent is missing, not a folder, or in another space.",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["ancestors[].id"],
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "drive node id" }
        ],
        "responses": {
          "200": {
            "description": "Ancestors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ancestors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "description": "folder node id, decimal string" },
                          "name": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/files/{file_id}/doc-alive": {
      "get": {
        "operationId": "drive.file.doc-alive",
        "summary": "Check whether a mounted document still exists in the docs backend",
        "description": "Read-only probe for a type=doc node; it never changes the drive entry. Any live member of the node's drive space may call it. A non-doc node reports source_doc_missing. A docs backend failure is returned as an internal error rather than a missing status.",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "mount node id (the drive file id, NOT the doc id)" }
        ],
        "responses": {
          "200": {
            "description": "Document status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "alive": { "type": "boolean", "description": "true only when status is alive" },
                    "status": { "type": "string", "enum": ["alive", "source_doc_deleted", "source_doc_archived", "source_doc_missing"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/docs/mount": {
      "post": {
        "operationId": "drive.doc.mount-by-role",
        "summary": "Mount an online document after checking the caller's docs-backend admin role",
        "description": "Same request and response as `drive doc mount` (POST /docs), but the document-side check asks docs-backend for the caller's role rank and requires admin. The principal Octo Space for that check is taken from the X-Space-Id header verbatim (this route has no space gate, so the header is not verified against the credential); an empty header fails closed. The caller also needs editor or higher in the destination drive space. A document already mounted in the same drive space returns conflict.",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["id", "parent_id"],
        "parameters": [
          { "name": "X-Space-Id", "in": "header", "required": true, "x-octo-flag": "octo-space-id", "schema": { "type": "string", "minLength": 1 }, "description": "the caller's Octo Space id used as the principal for the docs-backend role check (NOT the drive space id)" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["space_id", "doc_id"],
                "properties": {
                  "space_id": { "type": "string", "description": "destination drive space id" },
                  "parent_id": { "type": "integer", "format": "uint64", "default": 0, "description": "destination folder id" },
                  "doc_id": { "type": "string", "description": "document id" },
                  "source": { "type": "string", "default": "user-mount", "description": "origin tag: user-mount (default) or docs-sync; the backend rejects anything else with invalid_argument" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Mounted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocRef" } } } }
        }
      }
    },
    "/v1/bot/drive/blobs/im-transferred/batch": {
      "post": {
        "operationId": "drive.im-transfer.lookup",
        "summary": "Check which IM attachments are already saved in the caller's drive spaces",
        "description": "Looks each IM message up by its source key (channelType#channelID#msgID) across every drive space the caller belongs to in its verified Octo Space; personal wins over shared, then the most recently updated. Items with an empty im_group_no or im_msg_id are skipped, duplicates are collapsed, and only the first 100 distinct keys are checked. As a side effect the caller's personal drive space is created if it does not exist yet.",
        "x-octo-risk": "write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "description": "IM messages to check, pass via --data",
                    "items": {
                      "type": "object",
                      "properties": {
                        "im_group_no": { "type": "string", "description": "channel id of the source message" },
                        "im_channel_type": { "type": "integer", "minimum": 0, "maximum": 255, "description": "channel kind of the source message (1=DM, 2=group, 5=thread); must match the value used at transfer time" },
                        "im_msg_id": { "type": "string", "description": "message id as a string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hits keyed by source key; messages not saved anywhere are absent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "file_id": { "type": "integer", "format": "uint64" },
                          "space_id": { "type": "string" },
                          "parent_id": { "type": "integer", "format": "uint64", "description": "0 is the space root" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/shares/{share_token}/transfer": {
      "post": {
        "operationId": "drive.share.transfer",
        "summary": "Save a copy of a shared blob into a drive space",
        "description": "Validates the share token, expiry and password like share access, then inserts a fresh copy of the blob (every call creates a new copy). Membership in the source space is not required. The caller needs uploader_downloader or higher in the target space; an omitted target_space_id saves into the caller's personal space root in its verified Octo Space. Only blob shares transfer.",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["file_id", "parent_id"],
        "parameters": [
          { "name": "share_token", "in": "path", "required": true, "schema": { "type": "string" }, "x-octo-secret": true, "x-octo-flag": "share-token", "description": "share token parsed out of the share URL. base64url tokens may start with \"-\": pass --share-token <token>, or put the value after a \"--\" separator" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": { "type": "string", "writeOnly": true, "description": "share password when the share is password-protected. writeOnly: masked in --verbose / --dry-run body traces whether it arrives as a flag or through --data" },
                  "target_space_id": { "type": "string", "description": "destination drive space id; omit to use the caller's personal space" },
                  "target_parent_id": { "type": "integer", "format": "uint64", "default": 0, "description": "destination folder id; ignored when target_space_id is omitted" },
                  "name": { "type": "string", "description": "name for the copy; defaults to the shared file's name" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Copied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "file_id": { "type": "string", "description": "new drive node id, decimal string" },
                    "space_id": { "type": "string" },
                    "parent_id": { "type": "string", "description": "decimal string" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/shares/{share_token}/existing-copies": {
      "get": {
        "operationId": "drive.share.existing-copies",
        "summary": "List copies of a shared blob the caller already holds",
        "description": "No share password is needed: the reply only covers the caller's own drive spaces in its verified Octo Space that hold the same stored object. Unknown, revoked or expired shares still fail (not_found / share_expired). An empty list means no copy.",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["existing_copies[].file_id"],
        "parameters": [
          { "name": "share_token", "in": "path", "required": true, "schema": { "type": "string" }, "x-octo-secret": true, "x-octo-flag": "share-token", "description": "share token parsed out of the share URL. base64url tokens may start with \"-\": pass --share-token <token>, or put the value after a \"--\" separator" }
        ],
        "responses": {
          "200": {
            "description": "Existing copies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "existing_copies": { "type": "array", "items": { "$ref": "#/components/schemas/ExistingCopy" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/trash": {
      "get": {
        "operationId": "drive.trash.list",
        "summary": "List recycle-bin entries the caller may see",
        "description": "scope=all (default without space_id) returns rows the caller deleted plus every tombstone in drive spaces the caller is super_admin of; scope=mine only the caller's own deletions; scope=space (default when space_id is set) every tombstone in one drive space and requires super_admin there. Paged by an opaque cursor; pass next_cursor back to continue.",
        "x-octo-risk": "read",
        "x-octo-lossless-id-fields": ["items[].id", "items[].parent_id"],
        "parameters": [
          { "name": "scope", "in": "query", "schema": { "type": "string" }, "description": "view: all, mine or space (the backend rejects anything else with invalid_argument); defaults to space when space_id is set, otherwise all" },
          { "name": "space_id", "in": "query", "schema": { "type": "string" }, "description": "drive space id (personal:<octo-space>:<uid> or shared:<uuid>); required for scope=space" },
          { "name": "cursor", "in": "query", "schema": { "type": "string" }, "description": "next_cursor from the previous page" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50, "maximum": 100 }, "description": "page size; values <= 0 use 50 and values above 100 are clamped to 100" }
        ],
        "responses": {
          "200": {
            "description": "Recycle-bin page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "description": "tombstoned node id, decimal string; pass to trash restore / trash delete" },
                          "name": { "type": "string" },
                          "type": { "type": "string", "enum": ["doc", "blob", "folder"] },
                          "size": { "type": "integer" },
                          "space_id": { "type": "string" },
                          "space_name": { "type": "string" },
                          "parent_id": { "type": "string", "description": "original parent folder id, decimal string" },
                          "parent_alive": { "type": "boolean", "description": "false means a restore lands at the space root" },
                          "orig_path": { "type": "array", "items": { "type": "string" }, "description": "original folder names from the space root" },
                          "deleted_by": { "type": "string" },
                          "deleted_by_name": { "type": "string" },
                          "deleted_at": { "type": "string" },
                          "owner_uid": { "type": "string" },
                          "source": { "type": "string" }
                        }
                      }
                    },
                    "next_cursor": { "type": "string", "description": "absent on the last page" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/trash/{file_id}/restore": {
      "post": {
        "operationId": "drive.trash.restore",
        "summary": "Restore a recycle-bin entry",
        "description": "Allowed for the space's super_admin, or for the member who deleted it while still a member of the space. A folder restores with the subtree deleted in the same batch. When the original parent is gone the entry lands at the space root; a name clash gets a numeric suffix.",
        "x-octo-risk": "write",
        "x-octo-lossless-id-fields": ["id", "parent_id"],
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "tombstoned node id from trash list" }
        ],
        "responses": {
          "200": {
            "description": "Restored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "description": "restored node id, decimal string" },
                    "parent_id": { "type": "string", "description": "parent the node was restored under, decimal string" },
                    "name": { "type": "string", "description": "final name after conflict resolution" },
                    "restored_to_root": { "type": "boolean" },
                    "restored_name_conflict": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/drive/trash/{file_id}": {
      "delete": {
        "operationId": "drive.trash.delete",
        "summary": "Permanently delete a recycle-bin entry (irreversible)",
        "description": "Same permission as restore (space super_admin, or the deleter while still a member). Hard-deletes the tombstone and the subtree deleted in the same batch, then removes stored objects that no other row references. Cannot be undone.",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          { "name": "file_id", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" }, "description": "tombstoned node id from trash list" }
        ],
        "responses": { "204": { "description": "Permanently deleted" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Role": {
        "type": "string",
        "enum": ["preview_only", "downloader", "uploader_downloader", "editor", "admin", "super_admin", "custom"],
        "description": "drive space role. Grantability differs per surface: member add / member set-role accept preview_only, downloader, uploader_downloader, editor, admin and custom (custom is the lowest rank, below preview_only); invite create accepts the same set except custom, which carries no invite-link semantics. super_admin is never grantable through either — it is bound to the space creator at space creation. Granting admin is super_admin-only on both surfaces."
      },
      "Page": {
        "type": "object",
        "description": "shared page envelope. Drive v1 has no CLI auto-pagination; several endpoints return the full list alongside this envelope.",
        "properties": {
          "page_index": { "type": "integer", "description": "1-based page number" },
          "page_size": { "type": "integer", "description": "page size" },
          "total": { "type": "integer", "description": "total row count" },
          "data": { "type": "array", "items": { "type": "object" }, "description": "this page's rows" }
        }
      },
      "Space": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "drive space id: personal:<octo-space>:<uid> or shared:<uuid>" },
          "type": { "type": "string", "enum": ["personal", "shared"] },
          "octo_space_id": { "type": "string", "description": "owning Octo Space tenant id — a different scope from id; never interchange them" },
          "name": { "type": "string" },
          "super_admin_uid": { "type": "string" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "Member": {
        "type": "object",
        "properties": {
          "space_id": { "type": "string" },
          "uid": { "type": "string" },
          "name": { "type": "string", "description": "display name resolved via octo-server; absent means fall back to uid" },
          "role": { "$ref": "#/components/schemas/Role" },
          "granted_by": { "type": "string", "description": "uid that granted the role, or \"system\"" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "SearchResult": {
        "type": "object",
        "description": "drive search response. items is this page's hits; total is a lower-bound estimate of the union count (name index + body index deduped), suitable for a 'N results' label but not an exact count.",
        "properties": {
          "total": { "type": "integer", "description": "lower-bound estimate of total matches across the caller's visible spaces" },
          "truncated": { "type": "boolean", "description": "true when an internal cap (visible-doc set or an index page) was hit and some body hits may be missing" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "one search hit. file_id and parent_id are emitted as decimal strings (see x-octo-lossless-id-fields) because the backend uses uint64; size is a plain integer (files are capped well below 2^53). Display names for owner/updater/space are NOT included — resolve uid via octo-server the same way browse does.",
              "properties": {
                "file_id": { "type": "string", "description": "unified drive node id, decimal string" },
                "space_id": { "type": "string", "description": "drive space id the hit lives in" },
                "parent_id": { "type": "string", "description": "immediate parent folder id, decimal string; \"0\" is the space root" },
                "path": { "type": "array", "items": { "type": "string" }, "description": "breadcrumb of folder names from the space root to the immediate parent, exclusive of the item itself; [] for root-level hits" },
                "name": { "type": "string" },
                "type": { "type": "string", "enum": ["folder", "doc", "blob"] },
                "ext": { "type": "string", "description": "file extension, when known" },
                "size": { "type": "integer", "format": "uint64", "description": "byte count; absent/0 for folders and docs. uint64 on the wire but files are capped well below 2^53, so it is emitted as a plain JSON number (not a lossless decimal string)" },
                "owner_uid": { "type": "string" },
                "updater_uid": { "type": "string", "description": "uid of last editor; empty string means never edited" },
                "created_at": { "type": "string" },
                "updated_at": { "type": "string" },
                "highlights": {
                  "type": "object",
                  "description": "matched fragments with <mark>…</mark> around hits",
                  "properties": {
                    "name": { "type": "array", "items": { "type": "string" } },
                    "body": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "content_meta": {
                  "type": "object",
                  "description": "present on body hits: how the searched text was extracted",
                  "properties": {
                    "extractor": { "type": "string" },
                    "truncated": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      },
      "DriveEntry": {
        "type": "object",
        "description": "unified file-tree node. id and parent_id are emitted as decimal strings (see x-octo-lossless-id-fields) because the backend uses uint64.",
        "properties": {
          "id": { "type": "string", "description": "node id, decimal string" },
          "space_id": { "type": "string", "description": "drive space id" },
          "parent_id": { "type": "string", "description": "parent folder id, decimal string; \"0\" is the space root" },
          "name": { "type": "string" },
          "is_folder": { "type": "boolean" },
          "type": { "type": "string", "enum": ["doc", "blob", "folder"] },
          "ref_type": { "type": "string", "description": "underlying reference kind; present on some endpoints" },
          "ref_id": { "type": "string", "description": "doc id for type=doc, object-storage key for type=blob" },
          "doc_space_id": { "type": "string", "description": "type=doc only: the document's real Octo Space. Build document links from this — never substitute space_id, which is the drive space." },
          "size": { "type": "integer", "description": "byte count; 0 for folders and documents" },
          "content_type": { "type": "string" },
          "source": { "type": "string", "enum": ["user-upload", "im-transfer", "user-mount", "docs-sync"] },
          "owner_uid": { "type": "string" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "FileNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "node id, decimal string" },
          "space_id": { "type": "string" },
          "parent_id": { "type": "string", "description": "parent folder id, decimal string" },
          "name": { "type": "string" },
          "is_folder": { "type": "boolean" },
          "type": { "type": "string", "enum": ["doc", "blob", "folder"] },
          "ref_id": { "type": "string" }
        }
      },
      "Blob": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "blob node id, decimal string" },
          "space_id": { "type": "string" },
          "parent_id": { "type": "string", "description": "parent folder id, decimal string" },
          "name": { "type": "string" },
          "object_path": { "type": "string", "description": "object-storage key" },
          "size": { "type": "integer" },
          "content_type": { "type": "string" },
          "source": { "type": "string", "enum": ["user-upload", "im-transfer"] },
          "status": { "type": "string", "enum": ["pending", "confirmed"] },
          "owner_uid": { "type": "string" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "DocRef": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "mount node id, decimal string. Use this for doc unmount — not doc_id." },
          "space_id": { "type": "string", "description": "destination drive space id" },
          "parent_id": { "type": "string", "description": "parent folder id, decimal string" },
          "doc_id": { "type": "string", "description": "document id in the docs backend" },
          "doc_space_id": { "type": "string", "description": "the document's real Octo Space id; absent on rows mounted before drive captured it" },
          "title": { "type": "string", "description": "authoritative title read from the document metadata" },
          "source": { "type": "string" },
          "owner_uid": { "type": "string" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "MountableDoc": {
        "type": "object",
        "properties": {
          "doc_id": { "type": "string" },
          "title": { "type": "string" },
          "doc_type": { "type": "string", "description": "doc / sheet / board / html" },
          "owner_id": { "type": "string" },
          "space_id": { "type": "string", "description": "the document's real Octo Space id" },
          "octo_doc_slug": { "type": "string", "description": "slug for HTML documents" },
          "access_type": { "type": "string", "enum": ["owner", "member"] },
          "granted_role": { "type": "integer", "description": "docs-backend numeric role" },
          "updated_at": { "type": "string" }
        }
      },
      "PrepareUpload": {
        "type": "object",
        "properties": {
          "file_id": { "type": "string", "description": "pending drive file id, decimal string" },
          "status": { "type": "string", "enum": ["pending"] },
          "upload_mode": { "type": "string", "enum": ["single", "multipart"], "description": "server-selected upload mode; the client must not request or override a mode" },
          "upload_url": { "type": "string", "x-octo-secret": true, "description": "presigned single-part PUT URL, present only for the single branch. Never send a caller credential to it or log it." },
          "upload_id": { "type": "string", "description": "object-storage multipart upload id, present only for the multipart branch; this is not a credential and cannot be used as a signature" },
          "part_size": { "type": "integer", "format": "uint64", "description": "server-computed part size in bytes for the multipart branch; the server has already converted KiB to bytes, so the client slices by bytes directly and must not convert again; the client must execute this value and must not override it" },
          "part_count": { "type": "integer", "format": "uint64", "description": "server-computed multipart part count, at most 10000; the client must not override it" },
          "max_concurrent_parts": { "type": "integer", "format": "uint64", "description": "server-recommended maximum concurrent parts; the client may be more conservative but must not exceed it" },
          "object_path": { "type": "string", "description": "final object-storage key" },
          "content_type": { "type": "string", "description": "must be echoed as the PUT Content-Type" },
          "content_disposition": { "type": "string", "description": "when present, must be echoed on the PUT verbatim" },
          "max_file_size": { "type": "integer", "description": "exact byte count the signature allows" },
          "expires_at": { "type": "string" }
        }
      },
      "DownloadURL": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "short-lived signed GET URL" },
          "filename": { "type": "string", "description": "suggested download file name" },
          "expires_at": { "type": "string" }
        }
      },
      "Share": {
        "type": "object",
        "description": "The backend returns one opaque `id` that is both the management handle and the access token. The CLI splits it into share_id (revoke) and share_token (access/download) via x-octo-response-fields so a future token rotation cannot silently break callers.",
        "properties": {
          "share_id": { "type": "string", "description": "share record id; pass to share revoke" },
          "share_token": { "type": "string", "description": "access token embedded in the share URL. Equal to share_id today — do not rely on that." },
          "drive_file_id": { "type": "string", "description": "shared drive file node id, decimal string" },
          "creator_uid": { "type": "string" },
          "permission": { "type": "string", "enum": ["view", "download"] },
          "expires_at": { "type": "string" },
          "password_set": { "type": "boolean", "description": "true when a password is required; the password itself is never returned" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "ShareAccess": {
        "type": "object",
        "properties": {
          "permission": { "type": "string", "enum": ["view", "download"] },
          "expires_at": { "type": "string" },
          "file_id": { "type": "string", "description": "shared file node id, decimal string" },
          "file_name": { "type": "string" },
          "file_size": { "type": "integer" },
          "content_type": { "type": "string" },
          "ref_id": { "type": "string", "description": "object-storage key; callers normally do not need it" },
          "existing_copies": {
            "type": "array",
            "description": "best-effort hint: copies of the same blob the caller already holds in drive spaces of its current Octo Space. Omitted when there are none or the lookup failed.",
            "items": { "$ref": "#/components/schemas/ExistingCopy" }
          }
        }
      },
      "ExistingCopy": {
        "type": "object",
        "properties": {
          "file_id": { "type": "string", "description": "drive node id of the caller's existing copy, decimal string" },
          "space_id": { "type": "string", "description": "drive space id holding the copy" },
          "space_name": { "type": "string" }
        }
      },
      "ShareDownload": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "object-storage download URL, released only after this authenticated endpoint validated identity + token + password" },
          "filename": { "type": "string" },
          "content_type": { "type": "string" }
        }
      },
      "Invite": {
        "type": "object",
        "description": "invite_id and invite_token are deliberately distinct names: revoke takes the id, accept takes the token. The backend field names (id / token) are aliased by x-octo-response-fields.",
        "properties": {
          "invite_id": { "type": "string", "description": "invite record id; pass to invite revoke" },
          "drive_space_id": { "type": "string", "description": "target shared drive space id" },
          "role": { "$ref": "#/components/schemas/Role" },
          "invite_token": { "type": "string", "description": "invite token; pass to invite accept. Treat as a secret." },
          "expires_at": { "type": "string" },
          "creator_uid": { "type": "string" },
          "created_at": { "type": "string" }
        }
      },
      "TransferResult": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "drive node id, decimal string; usable directly with file / download / share commands" },
          "space_id": { "type": "string" },
          "parent_id": { "type": "string", "description": "decimal string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["blob"] },
          "ref_id": { "type": "string" },
          "size": { "type": "integer" },
          "content_type": { "type": "string" },
          "source": { "type": "string", "enum": ["im-transfer"] },
          "owner_uid": { "type": "string" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" },
          "idempotent": { "type": "boolean", "description": "true when a pre-existing row was returned instead of a new one" }
        }
      }
    }
  }
}
{
  "openapi": "3.1.0",
  "info": {
    "title": "Octo HTML Docs API",
    "version": "1.0.0",
    "description": "Agent-facing surface for octo-doc — the self-hosted, prompt-native interactive HTML document service (distinct from the CRDT docs-backend behind the `docs` domain). Covers the document lifecycle (publish/list/get/versions/delete), author drafts, per-doc share codes, media assets, inline comments, and the agent element read/replace + reply paths. All paths are under the `/docs-html/v1` prefix. CLI success output uses the `{ok, identity, data, ...}` envelope; failures use `{ok:false, error:{...}}`."
  },
  "x-octo-service": "html",
  "x-octo-base-url": "OCTO_API_BASE_URL",
  "x-octo-space-header": false,
  "x-octo-response-unwrap": "data",
  "paths": {
    "/docs-html/v1/docs": {
      "get": {
        "operationId": "html.list",
        "summary": "List documents (owner-scoped index)",
        "description": "Owner-scoped document index. The backend returns offset pagination metadata; generic cursor-based --page-all does not apply.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number; the backend defaults to 1 when omitted.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Items per page; the backend defaults to 20 when omitted and clamps values above 100.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "x-octo-risk": "read",
        "x-octo-response-unwrap": null,
        "responses": {
          "200": {
            "description": "A list of documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string",
                        "description": "Document reference: canonical doc_id for a new canonical document, or the legacy slug for an old document."
                      },
                      "title": {
                        "type": "string"
                      },
                      "latest": {
                        "type": "integer"
                      },
                      "updated": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "html.publish",
        "summary": "Create an HTML document or publish a later version",
        "description": "Create by omitting slug; the CLI generates a fresh idempotency_key unless one is supplied explicitly. Every new document receives a canonical doc_id whether mounted or unmounted; response data.slug is the document reference and equals data.doc_id. To publish a later version, first run html source <doc-ref> and retain data.html with data.version, edit that source, then pass the previously returned data.slug, set version to the source version plus one, and omit idempotency_key. On version_conflict or version_required, the bot must autonomously reread the latest source, reapply only the intended changes while preserving other edits, and republish to the same slug within the same task, up to three recovery attempts; do not end the task by forwarding a routine version error to the user. Never only increase version and resend stale HTML. Pass only a slug the server returned earlier: an unregistered slug does not create a canonical document, it produces a legacy unregistered one that never appears in the file list. Old legacy documents continue to use their legacy slug as that reference. A display name is metadata, not identity: publishing the same name without the saved reference creates a different document, so same-name republish is not supported. Do not infer identity mode from mount_type or from whether doc_id is non-empty. Requires the write token (Bearer). The server stamps commentable artifacts and reconciles existing comment anchors.",
        "x-octo-risk": "write",
        "x-octo-auto-idempotency-key": "idempotency_key",
        "x-octo-body-variants-hint": "create without slug (the CLI generates a key when omitted), or republish an existing slug without idempotency_key",
        "x-octo-body-variants": [
          {
            "name": "create",
            "required": [
              "html",
              "idempotency_key"
            ],
            "forbidden": [
              "slug"
            ]
          },
          {
            "name": "republish",
            "required": [
              "html",
              "slug"
            ],
            "forbidden": [
              "idempotency_key"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "html"
                ],
                "properties": {
                  "slug": {
                    "type": "string",
                    "description": "Legacy wire name for an existing document reference. Omit when creating. For every later publish pass the prior response data.slug: it is the canonical doc_id for a new document or the legacy slug for an old document. Never pass a display name as identity."
                  },
                  "html": {
                    "type": "string",
                    "description": "the full self-contained HTML document body"
                  },
                  "idempotency_key": {
                    "type": "string",
                    "description": "Optional caller key for retrying this exact creation operation; otherwise the CLI generates a cryptographically random key once per invocation and reuses it for transport retries. Omit when republishing an existing slug."
                  },
                  "version": {
                    "type": "integer",
                    "description": "New output version: for updates send the source version read before editing plus one. On servers with octo-docs-html#34 deployed, the server requires current latest+1 for bot updates (428 version_required if missing/zero, 409 version_conflict if mismatched). The HTML backend will be deployed and verified on every serving instance before this CLI workflow is released. Omit for first publication. Do not increase this value without rereading and editing the latest source."
                  },
                  "meta": {
                    "type": "object",
                    "description": "optional metadata (e.g. {\"title\":\"...\"})",
                    "properties": {
                      "title": {
                        "type": "string"
                      }
                    }
                  },
                  "mount_type": {
                    "type": "string",
                    "enum": [
                      "group",
                      "space",
                      "thread"
                    ],
                    "description": "Optional placement in docs-backend and the file sidebar; 'group', 'space', and 'thread' are supported. Mounting does not determine document identity."
                  },
                  "group_no": {
                    "type": "string",
                    "description": "group number; supply when mount_type=group"
                  },
                  "thread_id": {
                    "type": "string",
                    "description": "thread id; supply when mount_type=thread"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Publish result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "doc_id",
                    "slug"
                  ],
                  "properties": {
                    "doc_id": {
                      "type": "string",
                      "description": "Canonical document identifier for every newly created document. Read it at data.doc_id; do not use its presence to infer a mode."
                    },
                    "slug": {
                      "type": "string",
                      "description": "Document reference for all later operations. Read data.slug and persist it; for every newly created document it is equal to doc_id, while an old legacy document retains its legacy slug."
                    },
                    "version": {
                      "type": "integer"
                    },
                    "url": {
                      "type": "string"
                    },
                    "share_url": {
                      "type": "string",
                      "description": "Share URL when supplied by the server."
                    },
                    "size": {
                      "type": "integer"
                    },
                    "aids": {
                      "type": "integer"
                    },
                    "merged_comments": {
                      "type": "integer"
                    },
                    "registered": {
                      "type": "boolean",
                      "description": "Whether docs-backend registration is active; operational status only, not an identity-mode discriminator."
                    },
                    "status": {
                      "type": "string",
                      "description": "Server publish/registration status; operational status only, not a document-reference discriminator."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs-html/v1/docs/draft": {
      "post": {
        "operationId": "html.draft.create",
        "summary": "Create a canonical HTML draft",
        "description": "Create a new draft without a document reference. The CLI generates a fresh idempotency_key unless one is supplied explicitly; the response data.slug is the canonical document reference for later draft save/promote and publish operations.",
        "x-octo-risk": "write",
        "x-octo-auto-idempotency-key": "idempotency_key",
        "x-octo-body-variants-hint": "create a draft with non-empty html; the CLI generates idempotency_key when omitted; slug is not accepted on this endpoint",
        "x-octo-body-variants": [
          {
            "name": "create",
            "required": [
              "html",
              "idempotency_key"
            ],
            "forbidden": [
              "slug"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "html"
                ],
                "properties": {
                  "html": {
                    "type": "string",
                    "description": "Initial draft HTML body."
                  },
                  "idempotency_key": {
                    "type": "string",
                    "description": "Optional caller key for retrying the same creation operation; otherwise the CLI generates one per invocation."
                  },
                  "meta": {
                    "type": "object",
                    "description": "Optional document metadata such as display title.",
                    "properties": {
                      "title": {
                        "type": "string"
                      }
                    }
                  },
                  "mount_type": {
                    "type": "string",
                    "enum": [
                      "group",
                      "space",
                      "thread"
                    ],
                    "description": "Optional placement; does not identify the document."
                  },
                  "group_no": {
                    "type": "string",
                    "description": "Group number when mount_type=group."
                  },
                  "thread_id": {
                    "type": "string",
                    "description": "Thread id when mount_type=thread."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Canonical draft created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "doc_id",
                    "slug"
                  ],
                  "properties": {
                    "doc_id": {
                      "type": "string"
                    },
                    "slug": {
                      "type": "string",
                      "description": "Canonical document reference; equal to doc_id."
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs-html/v1/docs/{doc_id}": {
      "get": {
        "operationId": "html.get",
        "summary": "Fetch one document's metadata (needs reader)",
        "description": "Return a single document's metadata (slug, title, latest version, timestamps). Backend endpoint GET /docs-html/v1/docs/{doc_id} — added to octo-doc to back this command.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "description": "Document reference returned as data.slug: canonical doc_id for a new document, or the retained legacy slug for an old document.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string",
                      "description": "Document reference: canonical doc_id for a new document, or the retained legacy slug for an old document. The wire name remains slug for server compatibility."
                    },
                    "title": {
                      "type": "string"
                    },
                    "latest": {
                      "type": "integer"
                    },
                    "created": {
                      "type": "string"
                    },
                    "updated": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "html.rm",
        "summary": "Delete a document (forbidden for bots, including author/owner/admin)",
        "description": "Bots must not invoke this operation, even for documents they authored, own, or administer. Ask a human with document admin permission to delete it in Octo; do not use docs.delete or raw API calls as a workaround. This command targets the HTML service, not the docs-backend bot deletion route, so enforcement must be verified for that service separately. If bot_delete_forbidden is returned, stop without retrying or changing identity/Space. Publishing and editing remain governed by their existing permissions.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "description": "Document reference returned as data.slug: canonical doc_id for a new document, or the retained legacy slug for an old document.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/docs-html/v1/docs/{doc_id}/versions": {
      "get": {
        "operationId": "html.versions",
        "summary": "List a document's versions (needs reader)",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "description": "Document reference returned as data.slug: canonical doc_id for a new document, or the retained legacy slug for an old document.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Version list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "n": {
                        "type": "integer"
                      },
                      "created": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs-html/v1/docs/{doc_id}/draft": {
      "put": {
        "operationId": "html.draft.save",
        "summary": "Save the author draft (author-only)",
        "description": "Write the author-only draft slot for a document reference. Does not mint an immutable version until promoted.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "description": "Document reference returned as data.slug: canonical doc_id for a new document, or the retained legacy slug for an old document.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "html"
                ],
                "properties": {
                  "html": {
                    "type": "string",
                    "description": "the draft HTML body"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/docs-html/v1/docs/{doc_id}/draft/promote": {
      "post": {
        "operationId": "html.draft.promote",
        "summary": "Promote the author draft to an immutable version (author-only)",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "description": "Document reference returned as data.slug: canonical doc_id for a new document, or the retained legacy slug for an old document.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Promoted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string",
                      "description": "Document reference: canonical doc_id for a new document, or the retained legacy slug for an old document. The wire name remains slug for server compatibility."
                    },
                    "version": {
                      "type": "integer"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs-html/v1/docs/{doc_id}/share": {
      "post": {
        "operationId": "html.share",
        "summary": "Mint / rotate a per-doc read+comment share code (author-only)",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "description": "Document reference returned as data.slug: canonical doc_id for a new document, or the retained legacy slug for an old document.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Share code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
