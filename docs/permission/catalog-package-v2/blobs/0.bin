    "/v1/bot/docs/{docId}/sheet/deduplicate": {
      "post": {
        "x-octo-strict-request-schema": true,
        "operationId": "docs.sheet.deduplicate",
        "summary": "Preview or apply duplicate removal inside a selection (needs writer)",
        "description": "Defaults to server-side preview; --dry-run only prints the HTTP request and is not a data preview. Read a fresh baseVersion, preview, then apply with --preview=false and that same token. Both input and output are bounded to 20000 cells (or the lower deployed write limit). Active filters, source formulas, intersecting merges, drawings, hyperlinks, validations and comments are refused; protection and authorization are checked server-side. Apply is one atomic guarded sheet edit with an automatic safety snapshot. Compares all selected columns, keeps the first record and blank rows, compacts only selected values and clears trailing contents. Does not delete whole rows; destination formatting stays fixed.",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "x-octo-flag": "base-version",
            "schema": {
              "type": "string"
            },
            "description": "base-version token from 'docs sheet get' (sent as the If-Match header; required)"
