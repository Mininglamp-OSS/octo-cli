            "x-octo-secret": true
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "documentName": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "principalSpaceId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/published": {
      "post": {
        "operationId": "docs.published",
        "summary": "Notify docs-backend that an HTML document was durably published (owner bot only)",
        "description": "Bot-token only. The document must be in the bot's Space (else 404 not_found) and owned by the calling bot (else 403 forbidden). Only doc_type html is accepted: an archived document returns 409 document_archived, another type 409 wrong_document_type, and a deleted one 410 canonical_document_deleted. An optional title renames the registered document. When search indexing is enabled the document is queued for re-indexing (indexed=true).",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 512,
                    "description": "optional new title (at most 512 characters)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Publish recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "indexed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/view": {
