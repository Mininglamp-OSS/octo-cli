              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/invites": {
      "post": {
        "operationId": "docs.invites.create",
        "summary": "Create a link invite token for a document (needs admin)",
        "description": "The returned inviteToken lets anyone holding it join the document with the invite role, so treat it as a credential. role defaults to writer. expiresInDays is clamped to 1-7 (missing or non-integer: 3). maxUses is a non-negative integer; 0 (the default, also used for invalid values) means unlimited. The share URL is built by the client; the backend returns only the token, role and expiry.",
        "x-octo-risk": "high-risk-write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "reader",
                      "commenter",
                      "writer",
                      "admin"
                    ],
                    "default": "writer",
                    "description": "role granted on accept"
                  },
                  "expiresInDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7,
                    "default": 3,
                    "description": "lifetime in days (clamped to 1-7, default 3)"
                  },
                  "maxUses": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "maximum accepts; 0 means unlimited"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invite created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "inviteToken": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "docs.invites.list",
        "summary": "List a document's active link invites (needs admin)",
        "description": "Response items include the invite tokens, which are credential-equivalent.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active invites",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "inviteToken": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string"
                          },
                          "maxUses": {
                            "type": "integer"
                          },
                          "usedCount": {
                            "type": "integer"
                          },
                          "expiresAt": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/invites/{inviteToken}": {
      "delete": {
        "operationId": "docs.invites.revoke",
        "summary": "Revoke a document link invite (needs admin)",
        "description": "404 not_found when the token does not exist or belongs to another document.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inviteToken",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "invite token (credential-equivalent; masked in traces)",
            "x-octo-secret": true
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/attachments/copy": {
      "post": {
        "operationId": "docs.attachments.copy",
        "summary": "Copy stored attachments from other documents into this document (needs writer)",
        "description": "Writer on the target document and reader on every source document; bot callers may only copy from documents in their own Space. Each source attachment must belong to its claimed source document and pass the current MIME allow/deny lists and size caps. Sources are de-duplicated; a failing source is reported in notCopied (source_not_found, source_forbidden, mime_not_allowed, size_too_large, copy_failed) without failing the batch. The batch is capped by ATTACHMENT_MAX_RESOLVE_BATCH (default 200; 400 sources_too_many).",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sources"
                ],
                "properties": {
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "description": "source attachments (non-empty; capped by the backend batch limit, default 200)",
                    "items": {
                      "type": "object",
                      "required": [
                        "docId",
                        "attachId"
                      ],
                      "properties": {
                        "docId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "source document id"
                        },
                        "attachId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "source attachment id"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Copied attachments and per-source failures",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mappings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sourceDocId": {
                            "type": "string"
                          },
                          "sourceAttachId": {
                            "type": "string"
                          },
                          "attachId": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "mime": {
                            "type": "string"
                          },
                          "sizeBytes": {
                            "type": "integer"
                          },
                          "fileName": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "notCopied": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sourceDocId": {
                            "type": "string"
                          },
                          "sourceAttachId": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/attachments/ingest": {
      "post": {
        "operationId": "docs.attachments.ingest",
        "summary": "Fetch external URLs server-side and store them as document attachments (needs writer)",
        "description": "Every URL is fetched through the backend SSRF guard (http/https and allow-listed ports only; loopback, private, link-local, CGNAT and metadata addresses are refused; the connection is pinned to the validated IP). Bytes are validated by magic number, not by Content-Type or extension, and SVG is sanitized. Non-PPT documents accept allowed images within the image size tier; html_ppt documents accept image, audio or video (at most 10 URLs and 100 MiB per batch) and return ppt-media refs. Failures are reported per URL in notIngested (for example ssrf_blocked, fetch_failed, not_an_image, mime_not_allowed, size_too_large) without failing the batch. The batch is capped by ATTACHMENT_MAX_RESOLVE_BATCH (default 200; 400 urls_too_many).",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "urls"
                ],
                "properties": {
                  "urls": {
                    "type": "array",
                    "minItems": 1,
                    "description": "public http(s) URLs to ingest (duplicates are ignored)",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ingested attachments and per-URL failures",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mappings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sourceUrl": {
                            "type": "string"
                          },
                          "attachId": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "ref": {
                            "type": "string"
                          },
                          "mime": {
                            "type": "string"
                          },
                          "sizeBytes": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "notIngested": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sourceUrl": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/link-card": {
      "post": {
        "operationId": "docs.link-card",
        "summary": "Resolve an Open Graph link preview card for a URL (needs reader)",
        "description": "Fetches the page server-side through the SSRF guard and caches the result; no document state changes. Errors: 400 url_required/url_invalid/scheme_not_allowed, 403 ssrf_blocked, 413 response_too_large, 415 unsupported_content_type, 502 fetch_failed.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "description": "http(s) URL to preview"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Link card",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "siteName": {
                      "type": "string"
                    },
                    "fetchedAt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/comment-task/events": {
      "get": {
        "operationId": "docs.comment-task.events",
        "summary": "Read the public tool-event transcript of a comment task (needs reader)",
        "description": "Finite JSON poll, not a stream. Returns events after the since sequence for the task's current attempt, plus cursor, availability and completion flags. 400 bad_request for invalid query values.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "comment id the task was created for"
          },
          {
            "name": "botUid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "uid of the bot handling the task"
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "doc",
                "html",
                "ppt"
              ],
              "default": "doc"
            },
            "description": "comment surface"
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,4}$",
              "default": "0"
            },
            "description": "return events with seq greater than this value (0-1000)"
          }
        ],
        "responses": {
          "200": {
            "description": "Task events page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "cursor": {
                      "type": "integer"
                    },
                    "available": {
                      "type": "boolean"
                    },
                    "attemptId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "expectedCount": {
                      "type": "integer"
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "terminal": {
                      "type": "boolean"
                    },
                    "complete": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/comment-task": {
      "get": {
        "operationId": "docs.comment-task.get",
        "summary": "Read the progress record of a bot comment task (needs reader)",
        "description": "Returns {task} for the (document, kind, commentId, botUid) tuple; task is null when none exists. 400 bad_request for invalid query values.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "comment id the task was created for"
          },
          {
            "name": "botUid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "uid of the bot handling the task"
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "doc",
                "html",
                "ppt"
              ],
              "default": "doc"
            },
            "description": "comment surface"
          }
        ],
        "responses": {
          "200": {
            "description": "Task record",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task": {
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "docs.comment-task.report",
        "summary": "Report progress and public tool events for the bot's own comment task",
        "description": "Bot-token only (403 forbidden otherwise). The task is looked up by idempotencyKey and must belong to the calling bot (else 404 not_found); the bot needs reader on the task's document. The path docId must be the task's source id: the doc_id for doc and ppt tasks, but the document's octo_doc_slug for html tasks (otherwise 404 not_found). The body accepts only idempotencyKey, progress and events (unknown keys: 400 bad_request). A report for a stale attempt returns 409 stale_task_attempt. Only public process metadata belongs here, never tool arguments, raw output or model reasoning.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "doc_id for doc and ppt tasks; octo_doc_slug for html tasks"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idempotencyKey",
                  "progress"
                ],
                "additionalProperties": false,
                "properties": {
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "description": "task key delivered with the comment task"
                  },
                  "progress": {
                    "type": "object",
                    "required": [
                      "attemptId",
                      "sequence",
                      "state",
                      "phase",
                      "steps",
                      "omittedSteps",
                      "replyDelivered"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "attemptId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[a-zA-Z0-9_.:/-]+$"
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "waiting",
                          "running",
                          "finished",
                          "failed",
                          "unknown"
                        ]
                      },
                      "phase": {
                        "type": "string",
                        "enum": [
                          "received",
                          "model",
                          "tool",
                          "ended"
                        ],
                        "description": "waiting requires received; running requires model or tool; every other state requires ended"
                      },
                      "steps": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "tool",
                            "state",
                            "startedAt"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[a-zA-Z0-9_.:/-]+$"
                            },
                            "tool": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120,
                              "pattern": "^[a-zA-Z0-9_.:/-]+$"
                            },
                            "state": {
                              "type": "string",
                              "enum": [
                                "running",
                                "finished",
                                "failed",
                                "unknown"
                              ]
                            },
                            "startedAt": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "finishedAt": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "durationMs": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 604800000
                            },
                            "exitCode": {
                              "type": "integer",
                              "minimum": -2147483648,
                              "maximum": 2147483647
                            }
                          }
                        }
                      },
                      "omittedSteps": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "replyDelivered": {
                        "type": "boolean"
                      },
                      "errorCode": {
                        "type": "string",
                        "enum": [
                          "dispatch_failed",
                          "delivery_failed",
                          "permission_denied",
                          "interrupted"
                        ]
                      },
                      "eventCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      "detailsTruncated": {
                        "type": "boolean"
                      }
                    }
                  },
                  "events": {
                    "type": "array",
                    "maxItems": 10,
                    "description": "up to 10 new events with strictly increasing seq",
                    "items": {
                      "type": "object",
                      "required": [
                        "seq",
                        "stepId",
                        "tool",
                        "type",
                        "content",
                        "at",
                        "truncated",
                        "redacted",
                        "failed"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "seq": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000,
                          "description": "strictly increasing within the request"
                        },
                        "stepId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[a-zA-Z0-9_.:/-]+$"
                        },
                        "tool": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "pattern": "^[a-zA-Z0-9_.:/-]+$"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "tool_use",
                            "tool_result",
                            "error"
                          ]
                        },
                        "content": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "at": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "truncated": {
                          "type": "boolean"
                        },
                        "redacted": {
                          "type": "boolean"
                        },
                        "failed": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/comments/markers": {
      "get": {
        "operationId": "docs.comments.markers",
        "summary": "List unresolved comment markers of a whiteboard (needs reader)",
        "description": "Board documents only (409 unsupported_doc_type otherwise). Lightweight feed of unresolved thread roots; pass --cursor with the returned nextCursor for the next page (400 invalid_cursor if malformed).",
        "x-octo-risk": "read",
