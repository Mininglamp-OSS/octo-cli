    "/v1/bot/docs/{docId}/sheet/split": {
      "post": {
        "x-octo-strict-request-schema": true,
        "operationId": "docs.sheet.split",
        "summary": "Preview or apply literal text-to-columns (needs writer)",
        "description": "Defaults to server-side preview; --dry-run only prints the HTTP request and is not a data preview. Read a fresh baseVersion, preview, then apply with --preview=false and that same token. Both input and output are bounded to 20000 cells (or the lower deployed write limit). Active filters, source formulas, intersecting merges, drawings, hyperlinks, validations and comments are refused; protection and authorization are checked server-side. Apply is one atomic guarded sheet edit with an automatic safety snapshot. Preserves leading zeros, long numbers, empty fields and formula-looking text; writes strings with text number format @, while retaining destination styles. Overwriting nonempty destinations requires --overwrite.",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "x-octo-flag": "base-version",
            "schema": {
              "type": "string"
            },
            "description": "base-version token from 'docs sheet get' (sent as the If-Match header; required)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "logicalId",
                  "range",
                  "delimiter"
                ],
                "properties": {
                  "logicalId": {
                    "type": "string",
                    "x-octo-flag": "logical-id",
                    "description": "Required logical worksheet ID from docs sheet get."
                  },
                  "range": {
                    "type": "object",
                    "description": "Zero-based source rectangle; split accepts exactly one column. Pass the structured range via --data.",
                    "required": [
                      "startRow",
                      "startColumn",
                      "endRow",
                      "endColumn"
                    ],
                    "properties": {
                      "startRow": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "startColumn": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "endRow": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "endColumn": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "preview": {
                    "type": "boolean",
                    "default": true,
                    "description": "Defaults to true: return planned cells and counts without writing. Explicitly pass --preview=false to apply with the same base-version."
                  },
                  "delimiter": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16,
                    "description": "Literal delimiter, not CSV quoting or displayed number formatting."
                  },
                  "overwrite": {
                    "type": "boolean",
                    "default": false,
                    "description": "Explicit consent to replace nonempty cells to the right; inspect the server preview first."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only preview or atomic application result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "preview": {
                      "type": "boolean"
                    },
                    "baseVersion": {
                      "type": "string"
                    },
                    "range": {
                      "type": "object",
                      "description": "Zero-based affected rectangle of the planned or applied output.",
                      "required": [
                        "startRow",
                        "startColumn",
                        "endRow",
                        "endColumn"
                      ],
                      "properties": {
                        "startRow": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "startColumn": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "endRow": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "endColumn": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "rows": {
                      "type": "integer"
                    },
                    "columns": {
                      "type": "integer"
                    },
                    "removedRows": {
                      "type": "integer"
                    },
                    "overwrittenCells": {
                      "type": "integer"
                    },
                    "cells": {
                      "type": "object",
                      "description": "Planned replacement cells, returned in preview mode only, keyed by logicalId!row:column (zero-based). Values are complete cell objects, or null to clear the cell."
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "newDocVersionSeq": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "x-octo-risk": "write"
