      "post": {
        "operationId": "html.comment.add",
        "summary": "Create an anchored root comment or reply (requires commenter capability or higher)",
        "description": "Create an optionally anchored root comment, or reply when parent_id names a thread root. Requires CapComment or higher (commenter, writer, admin, or owner); read-only share-code access is insufficient and lower-capability callers receive a hidden 404. Optional version accepts a non-negative JSON integer or decimal string, a v-prefixed decimal string, or the literal string latest.",
        "x-octo-risk": "write",
