        "x-octo-response-fields": { "id": ["invite_id"], "space_id": ["drive_space_id"], "token": ["invite_token"] },
        "parameters": [
          { "name": "space_id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "shared drive space id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
