    "/v1/bot/docs/{docId}/import/docx": {
      "post": {
        "operationId": "docs.raw-import.docx",
        "summary": "Import a .docx file into a doc document (writer)",
        "description": "Sends the .docx bytes as the raw request body. With X-Octo-Import-Apply: true the converted content replaces the document atomically; without it the backend only parses and returns the converted document. Doc documents only (409 unsupported_doc_type). The backend limit is DOCX_IMPORT_MAX_UPLOAD_BYTES (default 200 MiB); 422 import_failed for an unreadable file. The `docs import --file` command wraps the same route with extra local checks.",
        "x-octo-risk": "high-risk-write",
        "x-octo-raw-body": true,
        "x-octo-raw-body-max-bytes": 209715200,
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Octo-Import-Apply",
            "in": "header",
            "required": false,
            "x-octo-flag": "apply",
            "schema": {
              "type": "string"
            },
            "description": "send true to replace the document content atomically; omit to only parse and return the converted document without writing"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied import, or the parsed document when not applied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "baseVersion": {
                      "type": "integer"
                    },
                    "newDocVersionSeq": {
                      "type": "integer"
                    },
                    "doc": {
                      "type": "object"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/import/markdown": {
      "post": {
