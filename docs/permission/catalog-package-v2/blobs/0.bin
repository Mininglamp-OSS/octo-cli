                  "slug",
                  "text"
                ],
                "properties": {
                  "slug": {
                    "type": "string",
                    "description": "Document reference: canonical doc_id for a new document, or the retained legacy slug for an old document. The wire name remains slug for server compatibility."
                  },
                  "text": {
                    "type": "string",
                    "description": "comment body"
                  },
                  "parent_id": {
                    "type": "string",
                    "x-octo-flag": "parent-id",
                    "description": "Optional comment thread root id; when supplied, creates a reply instead of a root comment."
                  },
                  "version": {
                    "type": [
                      "string",
                      "integer"
                    ],
                    "x-octo-flag": "version",
                    "description": "Optional selector for the version on which to stamp the comment: non-negative decimal value, decimal string, v-prefixed decimal string, or literal latest. The CLI flag accepts these as text; --data also accepts a JSON integer."
                  },
                  "anchor": {
                    "type": "object",
                    "description": "optional anchor (text or element by aid); omit for an unanchored comment"
                  }
