      "CapabilityEnvironmentVariables": {
        "type": "object",
        "description": "Environment variables. Names must match ^[A-Za-z_][A-Za-z0-9_]*$; values are sensitive.",
        "x-octo-secret": true,
        "maxProperties": 100,
        "propertyNames": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "CapabilityMCPStdioServer": {
        "type": "object",
        "description": "MCP server launched as a local child process.",
        "additionalProperties": false,
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string"
            }
          },
          "env": {
            "$ref": "#/components/schemas/CapabilityEnvironmentVariables"
          }
        }
      },
      "CapabilityMCPRemoteServer": {
        "type": "object",
        "description": "MCP server reached through HTTP streaming or SSE. Omitted type defaults to http.",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "http",
              "sse",
              "streamable-http"
            ],
            "default": "http"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "x-octo-secret": true
          },
          "headers": {
            "type": "object",
            "x-octo-secret": true,
            "maxProperties": 100,
            "propertyNames": {
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "CapabilityMCPConfig": {
        "type": "object",
        "description": "Portable MCP configuration persisted per expert. Environment values, headers, and embedded credentials are sensitive.",
        "additionalProperties": false,
        "required": [
          "mcpServers"
        ],
        "properties": {
          "mcpServers": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 100,
            "propertyNames": {
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CapabilityMCPStdioServer"
                },
                {
                  "$ref": "#/components/schemas/CapabilityMCPRemoteServer"
                }
              ]
            }
          }
        }
      },
      "CapabilitySkill": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "content"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 512
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          },
          "config": {},
          "files": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "source"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "content"
                  ],
                  "properties": {
                    "type": {
                      "const": "inline_text"
                    },
                    "content": {
                      "type": "string",
                      "maxLength": 1048576
                    }
                  }
                }
              }
            }
          }
        }
      },
      "CapabilityExpert": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 255
          },
          "instructions": {
            "type": "string",
            "maxLength": 1048576
          },
          "avatar_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "runtime_config": {},
          "custom_env": {
            "$ref": "#/components/schemas/CapabilityEnvironmentVariables"
          },
          "custom_args": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string"
            }
          },
          "mcp_config": {
            "$ref": "#/components/schemas/CapabilityMCPConfig"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "workspace"
            ],
            "default": "workspace",
            "description": "Retained for compatibility. Installed experts always have workspace visibility."
          },
          "max_concurrent_tasks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 6
          },
          "model": {
            "type": "string"
          },
          "thinking_level": {
            "type": "string",
            "description": "Must be supported by the bound runtime's provider."
          },
          "skill_names": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      },
      "CapabilityExpertTeam": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "members"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 255
          },
          "instructions": {
            "type": "string",
            "maxLength": 1048576
          },
          "avatar_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expert_name",
                "is_leader"
              ],
              "properties": {
                "expert_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "default": "member"
                },
                "is_leader": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "CapabilityDefinition": {
        "type": "object",
        "description": "Portable declaration of skills, experts, and an optional expert team (schema_version 1.0). At least one of skills or experts must be non-empty.",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "name"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "skills": {
            "type": "array",
            "maxItems": 600,
            "items": {
              "$ref": "#/components/schemas/CapabilitySkill"
            }
          },
          "experts": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/CapabilityExpert"
            }
          },
          "expert_team": {
            "$ref": "#/components/schemas/CapabilityExpertTeam"
          }
        },
        "anyOf": [
          {
            "required": [
              "skills"
            ],
            "properties": {
              "skills": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "experts"
            ],
            "properties": {
              "experts": {
                "minItems": 1
              }
            }
          }
        ]
      },
      "CapabilityInstallationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition"
        ],
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/CapabilityDefinition"
          },
          "bindings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "experts": {
                "type": "array",
                "description": "Runtime selection for every expert in the definition. Omit for skill-only definitions.",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "expert_name",
                    "runtime_id"
                  ],
                  "properties": {
                    "expert_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "description": "References exactly one expert in definition.experts."
                    },
                    "runtime_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "CapabilityInstallation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "experts",
          "skills"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "skills",
              "expert",
              "expert_team"
            ]
          },
          "expert_id": {
            "type": "string",
            "format": "uuid"
          },
          "expert_team_id": {
            "type": "string",
            "format": "uuid"
          },
          "leader_expert_id": {
            "type": "string",
            "format": "uuid"
          },
          "experts": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expert_id",
                "name",
                "skill_ids"
              ],
              "properties": {
                "expert_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "is_leader": {
                  "type": "boolean"
                },
                "skill_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          },
          "skills": {
            "type": "array",
            "maxItems": 600,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill_id",
                "name",
                "created"
              ],
              "properties": {
                "skill_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "created": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "ProjectResourceCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_type",
          "resource_ref"
        ],
        "properties": {
          "resource_type": {
            "type": "string",
            "description": "Resource kind.",
            "enum": [
              "github_repo",
              "local_directory"
            ],
            "x-octo-flag": "type"
          },
          "resource_ref": {
            "type": "object",
            "minProperties": 1,
            "description": "Complete resource_ref object: github_repo needs url and optional default_branch_hint; local_directory needs absolute local_path and daemon_id, with optional label. Use --data or --ref JSON."
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable resource label; null clears it."
          },
          "position": {
            "type": "integer",
            "description": "Display position."
          }
        }
      },
      "ProjectResourceUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "resource_ref": {
            "type": "object",
            "minProperties": 1,
            "description": "Complete resource_ref object: github_repo needs url and optional default_branch_hint; local_directory needs absolute local_path and daemon_id, with optional label. Use --data or --ref JSON."
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable resource label; null clears it."
          },
          "position": {
            "type": "integer",
            "description": "Display position."
          }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Project title.",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Project description."
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "description": "Project icon, such as an emoji."
          },
          "status": {
            "type": "string",
            "description": "Project lifecycle status.",
            "enum": [
              "planned",
              "in_progress",
              "paused",
              "completed",
              "cancelled"
            ]
          },
          "priority": {
            "type": "string",
            "description": "Project priority.",
            "enum": [
              "urgent",
              "high",
              "medium",
              "low",
              "none"
            ]
          },
          "lead_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Project lead type. Public expert maps to Fleet agent; expert teams cannot lead projects.",
            "enum": [
              "member",
              "expert",
              null
            ]
          },
          "lead_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Fleet member or expert UUID. Mutually exclusive with --lead-member-id.",
            "format": "uuid",
            "minLength": 1
          },
          "lead_octo_uid": {
            "type": "string",
            "description": "Case-sensitive Project member ID; use with --lead-type member instead of --lead-id.",
            "x-octo-flag": "lead-member-id",
            "minLength": 1,
            "maxLength": 128
          },
          "resources": {
            "type": "array",
            "description": "Resources to create atomically with the project. Supply via --data.",
            "items": {
              "$ref": "#/components/schemas/ProjectResourceCreate"
            }
          }
        }
      },
      "ProjectUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "description": "Project title.",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Project description."
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "description": "Project icon, such as an emoji."
          },
          "status": {
            "type": "string",
            "description": "Project lifecycle status.",
            "enum": [
              "planned",
              "in_progress",
              "paused",
              "completed",
              "cancelled"
            ]
          },
          "priority": {
            "type": "string",
            "description": "Project priority.",
            "enum": [
              "urgent",
              "high",
              "medium",
              "low",
              "none"
            ]
          },
          "lead_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Project lead type. Public expert maps to Fleet agent; expert teams cannot lead projects.",
            "enum": [
              "member",
              "expert",
              null
            ]
          },
          "lead_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Fleet member or expert UUID. Mutually exclusive with --lead-member-id.",
            "format": "uuid",
            "minLength": 1
          },
          "lead_octo_uid": {
            "type": "string",
            "description": "Case-sensitive Project member ID; use with --lead-type member instead of --lead-id.",
            "x-octo-flag": "lead-member-id",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  },
  "x-octo-source": "octo-fleet/openapi/public-v1.yaml",
  "x-octo-service": "loop",
  "x-octo-base-url": "OCTO_API_BASE_URL",
  "x-octo-space-header": false
}
{
  "openapi": "3.1.0",
  "info": {
    "title": "Octo Docs Bot API",
    "version": "1.0.0",
    "description": "Bot-facing document metadata surface under /v1/bot/docs: doc lifecycle, members, sharing, comments, versions, and attachment metadata. Live document body/outline editing is a Yjs websocket path and is NOT part of this REST surface."
  },
  "x-octo-service": "docs",
  "x-octo-base-url": "OCTO_API_BASE_URL",
  "x-octo-space-header": false,
  "paths": {
    "/v1/bot/docs/{docId}/ppt/export": {
      "get": {
        "operationId": "docs.ppt.export",
        "summary": "Save the live PPT as a self-contained HTML presentation (reader or higher)",
        "description": "Pass --output slides.html to save the actual file bytes. Without --output, only response metadata is printed. HTML is an offline player, not editable PPTX or PDF. On a compatible backend, document-owned ppt-media: attachments are embedded into the export without changing the saved deck. Arbitrary external URLs are not fetched and collaboration credentials are not included. Missing, unauthorized or oversized media causes export failure.",
        "x-octo-risk": "read",
        "x-octo-binary-response": true,
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "x-octo-flag": "file-format",
            "schema": {
              "type": "string",
              "enum": [
                "html"
              ],
              "default": "html"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Offline presentation file",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/ppt": {
      "get": {
        "operationId": "docs.ppt.get",
        "summary": "Read the current PPT deck and its base revision",
        "description": "Reader or higher. Returns authoritative Bento JSON and baseRevision. Use docs.ppt.edit, not the document/sheet/scene or draft endpoints, to edit an html_ppt document. The HTTP response uses a data envelope; the CLI unwraps it once. Shared Docs lifecycle endpoints return flat JSON.",
        "x-octo-risk": "read",
        "x-octo-response-unwrap": "data",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Live deck",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docId": {
                      "type": "string"
                    },
                    "deck": {
                      "type": "object",
                      "description": "Authoritative Bento deck. The current backend format contract is format=bento/slides and version=1 (BENTO_FORMAT_VERSION). Release probes reject unknown versions; a format upgrade requires a coordinated contract/probe update."
                    },
                    "baseRevision": {
                      "type": "integer"
                    },
                    "contentHash": {
                      "type": "string",
                      "description": "Advisory content digest; may be absent or empty. Use revision fields for concurrency control."
                    }
                  },
                  "required": [
                    "docId",
                    "deck",
                    "baseRevision"
                  ]
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "docs.ppt.edit",
        "x-octo-strict-request-schema": true,
        "summary": "Apply a PPT edit under a mandatory base revision",
        "description": "Writer or higher; changing title requires admin. Send only {baseRevision,deck} from a fresh get. Preserve deck.docId, unknown fields inside deck, and stable slide/element IDs; do not copy the response's top-level docId or contentHash into the request. The backend compiles the JSON difference to normal collaboration operations. A 409 CONFLICT means reread and reapply the intended change, never blindly resubmit the stale deck. Members and permissions cannot be supplied in deck JSON. The HTTP response uses a data envelope; the CLI unwraps it once. Shared Docs lifecycle endpoints return flat JSON.",
        "x-octo-risk": "write",
        "x-octo-response-unwrap": "data",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "baseRevision",
                  "deck"
                ],
                "additionalProperties": false,
                "properties": {
                  "baseRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "The baseRevision returned by the immediately preceding PPT get"
                  },
                  "deck": {
                    "type": "object",
                    "description": "The edited bento/slides JSON; preserve document identity and stable slide/element IDs. Text elements use html; code elements use content (never code), grammarName (js/ts/py), fontSize, align, valign and lineHeight. Read back the actual rendered fields."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durably committed edit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revision": {
                      "type": "integer"
                    },
                    "contentHash": {
                      "type": "string",
                      "description": "Advisory content digest; may be absent or empty. Use revision fields for concurrency control."
                    },
                    "changed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "revision",
                    "changed"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs": {
      "post": {
        "operationId": "docs.create",
        "summary": "Create a document, empty or initialized from a PPT template; the caller becomes owner/admin",
        "description": "Create a document in the verified caller Space. Use docType=html_ppt, title, optional templateId (blank by default), and Idempotency-Key for PPT. Content initialization, metadata and member grants commit atomically.",
        "x-octo-risk": "write",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "initial title (optional; defaults to empty)"
                  },
                  "folderId": {
                    "type": "string",
                    "description": "target folder id (optional; defaults to the space default folder)"
                  },
                  "docType": {
                    "type": "string",
                    "description": "document type (optional; defaults to 'doc')"
                  },
                  "templateId": {
                    "type": "string",
                    "x-octo-enum-hint": "The CLI retires pitch/report/lesson for new creation by product policy; existing presentations remain readable/editable. Deploy the matching backend catalogue before using signal/terra/orbital/picnic; until then only blank is compatible. A timed-out create with a retired template cannot be replayed through this CLI: reconcile with docs list / docs search first; do not automatically create with a new key. Run octo-cli skills octo-docs and read ppt.md for rollout prerequisites.",
                    "description": "PPT template: blank (server default) or signal, terra, orbital, picnic. The four gallery choices require the matching backend catalogue to be deployed first. The CLI rejects pitch/report/lesson for new creation by product policy (octo-cli issue #174); this is not a claim that a deployed backend rejects them. Existing presentations can still be read and edited.",
                    "enum": [
                      "blank",
                      "signal",
                      "terra",
                      "orbital",
                      "picnic"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created document metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Flat creation receipt, not wrapped in data. PPT-specific fields are optional on this shared endpoint. The example is a synthetic fixture of the backend PPT creation contract; see docs/ppt-release-gate.md for source provenance.",
                  "properties": {
                    "docId": {
                      "type": "string",
                      "description": "Server-generated document ID. New PPT IDs have the form d_ followed by 24 hexadecimal characters; existing document IDs remain opaque to callers."
                    },
                    "docType": {
                      "type": "string",
                      "description": "Document type; html_ppt for PPT creation."
                    },
                    "templateId": {
                      "type": "string",
                      "description": "PPT only: the selected template ID. Historical Idempotency-Key replay may return a retired ID; this response field is not constrained by the new-creation enum."
                    },
                    "draftRevision": {
                      "type": "integer",
                      "description": "PPT only: initial draft revision (0 on creation)."
                    },
                    "snapshotVersion": {
                      "type": "integer",
                      "description": "PPT only: initial snapshot version (0 on creation)."
                    },
                    "documentName": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "spaceId": {
                      "type": "string"
                    },
                    "folderId": {
                      "type": "string"
                    },
                    "ownerId": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "editorUrl": {
                      "type": "string",
                      "description": "Editor URL; returned for html_ppt only."
                    },
                    "shareUrl": {
                      "type": "string",
                      "description": "Presentation URL subject to document access rules; returned for html_ppt only."
                    }
                  },
                  "example": {
                    "docId": "d_000000000000000000000001",
                    "docType": "html_ppt",
                    "templateId": "blank",
                    "draftRevision": 0,
                    "snapshotVersion": 0,
                    "documentName": "octo:acceptance-space:f_default:ppt:d_000000000000000000000001",
                    "title": "CLI contract probe",
                    "spaceId": "acceptance-space",
                    "folderId": "f_default",
                    "ownerId": "release_probe_bot",
                    "role": "admin",
                    "createdAt": "2026-01-01T00:00:00.000Z",
                    "editorUrl": "https://octo.example/d/d_000000000000000000000001",
                    "shareUrl": "https://octo.example/d/d_000000000000000000000001"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "x-octo-flag": "idempotency-key",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "description": "Required for PPT creation, comments and version writes; preserve on an uncertain retry."
          }
        ]
      },
      "get": {
        "operationId": "docs.list",
        "summary": "List documents the bot owns or is a member of (page-based)",
        "description": "Page-based listing scoped to the bot's server-resolved space. Response is {total, items}; there is no cursor, so --page-all does not apply — walk pages with --page/--pageSize.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "folderId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "filter to a single folder"
          },
          {
            "name": "owner",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "me"
              ]
            },
            "description": "Set to me to restrict results to documents owned by the authenticated bot, excluding documents shared with it."
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filename substring search."
          },
          {
            "name": "type",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "doc",
                  "sheet",
                  "board",
                  "html",
                  "html_ppt"
                ]
              }
            },
            "description": "Document types: doc, sheet, board, html, or html_ppt. Repeat --type to include multiple types, encoded as repeated type query keys."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "1-based page number"
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            },
            "description": "items per page (1-100, default 20)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "updatedAt:desc",
                "updatedAt:asc"
              ],
              "default": "updatedAt:desc"
            },
            "description": "sort order by last update"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "docId": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "ownerId": {
                            "type": "string"
                          },
                          "docType": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/search": {
      "post": {
        "operationId": "docs.search",
        "summary": "Search accessible documents by full-text content",
        "description": "Full-text search across documents the bot can access. Use --keyword for the query and repeat --doc-type to restrict results to doc, sheet, board, html, or html_ppt. HTML results cover documents registered into docs-backend by a mounted octo-doc publish; docs-backend computes the caller's authoritative visible doc-id set before OpenSearch returns metadata or body highlights. The default response preserves the backend {total, items, nextCursor} object; --page-all follows nextCursor and emits the merged items array.",
        "x-octo-risk": "read",
        "x-octo-pagination": {
          "cursorParam": "cursor",
          "itemsField": "items",
          "cursorField": "nextCursor",
          "inferHasMore": true,
          "rejectCursorRepeats": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "q"
                ],
                "properties": {
                  "q": {
                    "type": "string",
                    "x-octo-flag": "keyword",
                    "description": "full-text search keyword"
                  },
                  "docType": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "doc",
                        "sheet",
                        "board",
                        "html",
                        "html_ppt"
                      ]
                    },
                    "x-octo-flag": "doc-type",
                    "description": "document type filter; repeat for multiple types (doc, sheet, board, html, html_ppt)"
                  },
                  "cursor": {
                    "type": "string",
                    "description": "opaque cursor from the previous page"
                  },
                  "pageSize": {
                    "type": "integer",
                    "x-octo-flag": "page-size",
                    "description": "items per page"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "docId": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "docType": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "spaceId": {
                            "type": "string"
                          },
                          "highlight": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "nextCursor": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/docs/{docId}": {
      "get": {
        "operationId": "docs.get",
