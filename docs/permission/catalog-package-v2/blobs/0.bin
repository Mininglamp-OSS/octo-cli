          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "uid",
                  "role"
                ],
                "properties": {
                  "uid": {
                    "type": "string",
                    "description": "target user uid"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "reader",
                      "commenter",
                      "writer"
                    ],
                    "description": "role to grant (grant-only, never downgrades). Matches octo-docs-backend isForwardGrantRole (src/permission/role.ts) = the member roles minus admin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grant result (final role + changed flag)"
          }
        }
      }
    },
    "/v1/bot/docs/{docId}/comments": {
      "get": {
        "operationId": "docs.comments.list",
        "summary": "List comment thread roots with their replies (needs reader)",
        "description": "Returns {items, nextCursor}; there is no {data, pagination} envelope, so --page-all does not apply — pass --cursor with the returned nextCursor to walk pages.",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeResolved",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "set to 1 to include resolved threads"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "id cursor from a previous page's nextCursor"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 100
            },
            "description": "page size (1-100, default 50)"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of comment threads",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "nextCursor": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "docs.comments.add",
        "summary": "Add an anchored root or reply (commenter or higher)",
        "description": "A reply sets parentId and omits anchors. A root comment needs an anchor. For boards, `docs comments add` accepts --body plus exactly one of --point X,Y or repeatable --element-id; these board anchor flags are mutually exclusive with --data and the reply/rich-document anchor flags, and element-anchor dry runs still read the live scene. Other callers, replies, and advanced scenarios use --data with opaque base64 anchorStart/anchorEnd from a live editor selection, or anchorText for rich documents; ambiguous text anchors fail with 422 ambiguous_anchor and can be narrowed with blockPath/occurrence. For sheets, pass the base64 cell key as both anchors. PPT roots use anchor {kind,versionSeq,baseRevision?,slideId?,elementId?,elementIds?,x?,y?}; replies use parentId only. PPT writes require Idempotency-Key.",
        "x-octo-risk": "write",
        "parameters": [
          {
            "name": "docId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "x-octo-flag": "idempotency-key",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            "description": "Required for PPT comments: 1–128 printable ASCII characters without spaces. Preserve the identical key and body on an uncertain retry. The CLI rejects an explicitly blank key; length and character bounds are backend-enforced."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "body"
                ],
                "properties": {
                  "body": {
                    "type": "string",
                    "description": "comment text"
                  },
                  "parentId": {
                    "type": "integer",
                    "description": "thread root id to reply to (omit for a root comment)"
                  },
                  "anchorStart": {
                    "type": "string",
                    "description": "root only: opaque base64 anchor start; accepts a Yjs editor position, sheet cell key, or canonical versioned Board anchor"
                  },
                  "anchorEnd": {
                    "type": "string",
                    "description": "root only: opaque base64 anchor end; accepts a Yjs editor position, sheet cell key, or canonical versioned Board anchor"
                  },
                  "anchorText": {
                    "type": "string",
                    "description": "root only: the exact selected text; the backend resolves it to an anchor. Use instead of anchorStart/anchorEnd when you have no live editor positions (e.g. a bot)"
                  },
                  "blockPath": {
                    "type": "string",
                    "description": "root only: disambiguate anchorText by block, as a comma-separated child-index path from the doc root (e.g. 0,2)"
                  },
                  "occurrence": {
                    "type": "integer",
                    "description": "root only: disambiguate anchorText by picking the Nth match (1-based) among the remaining candidates"
                  },
                  "anchor": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "document",
                          "slide",
                          "element",
                          "point"
                        ]
                      },
                      "slideId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "versionSeq": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Explicit null for live; positive integer for fixed version"
                      },
                      "baseRevision": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "elementId": {
                        "type": "string"
                      },
                      "elementIds": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "description": "PPT anchor contract. The CLI checks required fields and enums; coordinate bounds, identifiers, version/revision values and unknown fields are validated by the backend."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created (returns the new comment id)"
          }
        }
      }
    },
