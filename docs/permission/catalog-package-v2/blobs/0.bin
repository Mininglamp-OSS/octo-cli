      "TaskCreate": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Task title."
          },
          "description": {
            "type": "string",
            "description": "Task description."
          },
          "parent_task_id": {
            "type": "string",
            "format": "uuid",
            "description": "Parent task UUID in this workspace."
          },
          "assignee_type": {
            "type": "string",
            "enum": [
              "expert",
              "expert_team",
              "member"
            ],
            "description": "Public assignee type. Use with --assignee-id or --assignee-member-id."
          },
          "assignee_id": {
            "type": "string",
            "format": "uuid",
            "description": "Expert or expert-team UUID, or a native Workspace member user UUID with assignee_type=member. Project members use --assignee-member-id."
          },
          "assignee_octo_uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-octo-flag": "assignee-member-id",
            "description": "Exact Project member ID from the member list; pair with assignee_type=member and do not combine with assignee_id."
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "todo",
              "in_progress",
              "in_review",
              "done",
              "blocked",
              "cancelled"
            ],
            "description": "Initial task lifecycle status."
          },
          "priority": {
            "type": "string",
            "enum": [
              "urgent",
              "high",
              "medium",
              "low",
              "none"
            ],
            "description": "Task priority.",
            "x-octo-enum-hint": "Use urgent, high, medium, low, or none."
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Optional scheduled start date in YYYY-MM-DD format."
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "Optional due date in YYYY-MM-DD format."
          },
          "attachment_ids": {
            "type": "array",
            "description": "Attachment UUIDs to associate with the new task.",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "project_id": {
            "type": "string",
            "description": "Loop project UUID in the selected workspace. Independent of --workspace-id; null clears an existing association.",
            "format": "uuid",
            "minLength": 1
          }
        }
      },
      "TaskUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Replacement task title."
          },
          "description": {
            "type": "string",
            "description": "Replacement task description."
          },
          "parent_task_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Parent task UUID; explicit null in --data clears the parent."
          },
          "assignee_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "expert",
              "expert_team",
              "member",
              null
            ],
            "description": "Public assignee type. Use with --assignee-id or --assignee-member-id; to clear, pass --data '{\"assignee_type\":null,\"assignee_id\":null}' or use task assign --unassign."
          },
          "assignee_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Expert or expert-team UUID, or a native Workspace member user UUID with assignee_type=member. Project members use --assignee-member-id."
          },
          "assignee_octo_uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-octo-flag": "assignee-member-id",
            "description": "Exact Project member ID from the member list; pair with assignee_type=member and do not combine with assignee_id."
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "todo",
              "in_progress",
              "in_review",
              "done",
              "blocked",
              "cancelled"
            ],
            "description": "Move the task to a lifecycle status. in_review means the work is awaiting review."
          },
          "priority": {
            "type": "string",
            "enum": [
              "urgent",
              "high",
              "medium",
              "low",
              "none"
            ],
            "description": "Task priority.",
            "x-octo-enum-hint": "Use urgent, high, medium, low, or none."
          },
          "position": {
            "type": "number",
            "description": "Position for manual task ordering."
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Scheduled start date in YYYY-MM-DD format; explicit null in --data clears it."
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Due date in YYYY-MM-DD format; explicit null in --data clears it."
          },
          "attachment_ids": {
            "type": "array",
            "description": "Attachment UUIDs for the task update.",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "suppress_run": {
            "type": "boolean",
            "description": "Suppress the run created by this write; this does not stop existing executions from being cancelled by reassignment."
          },
          "handoff_note": {
            "type": "string",
            "description": "Optional note supplied to Fleet's handoff path for this update."
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Loop project UUID in the selected workspace. Independent of --workspace-id; null clears an existing association.",
            "format": "uuid",
            "minLength": 1
          }
        }
      },
