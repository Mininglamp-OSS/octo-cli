            }
          },
          {
            "name": "X-File-Name",
            "in": "header",
            "required": false,
            "x-octo-flag": "file-name",
            "schema": {
              "type": "string",
              "maxLength": 1024
            },
            "description": "optional file name, URI-encoded (encodeURIComponent); the backend keeps the last path segment and sanitizes it"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
