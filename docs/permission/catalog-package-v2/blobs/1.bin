y","user_bot","app_bot"],"base_url_env":"OCTO_API_BASE_URL","id":"drervice":"drive","skill":{"name":"octo-drive","resource_uri":"octo://skills/octo-drive/SKILL.md","summary":"Octo Drive: spaces, folders, upload/download, doc mounts, share links, invites, IM-attachment transfer.","level":"recommended","etag":"1896bcb730a8"},"space_header_set":true,"summary":"List folders, mounted documents and blobs in one directory"}{"allowed_token_kinds":["user_key","user_bot","app_bot"],"base_urid":"drive.invite.create","method":"POST","mount_by_token_kind":{"app_bot":"/v1/bot/drive","user_bot":"/v1/bot/drive","user_key":"/v1/user/drive"},"parameters":[{"description":"shared drive space id","in":"path","name":"space_id","required":true,"type":"string"}],"path":"/v1/bot/drive/spaces/{space_id}/invites","request_body":{"properties":{"expires_in_seconds":{"description":"0 uses the backend default (7 days)","type":"integer"},"role":{"description":"drive s,"enum":["preview_only","downloader","uploader_downloader","editor","admin","super_admin","custom"],"type":"string"}},"required":["role"],"type":"object"},"request_body_required":true,"response_field_aliases":{"id":["invite_id"],"space_id":["drive_space_id"],"token":["invite_token"]},"response_schema":{"description":"invite_id and invite_token are deliberately distinct names: revoke takes the id, accept takes the token. The backend field names (id / token) are aliased by x-octo-response-fields.","properties":{"created_at":{"type":"string"},"creator_uid":{"type":"string"},"drive_space_id":{"description":"target shared drive space id","type":"string"},"expires_at":{"type":"string"},"invite_id":{"description":"invite record id; pass to invite revoke","type":"string"},"invite_token":{"description":"invite token; pass to invite accept. Treat as a secret.","type":"string"},"role":{"description":"drive s,"enum":["preview_only","downloader","uploader_downloader","editor","admin","super_admin","custom"],"type":"string"}},"type":"object"},"risk":"write","schema_fingerprint":"sha256:4d7a39b1e6e12243","service":"drive","skill":{"name":"octo-drive","resource_uri":"octo://skills/octo-drive/SKILL.md","summary":"Octo Drive: spaces, folders, upload/download, doc mounts, share links, invites, IM-attachment transfer.","level":"recommended","etag":"1896bcb730a8","hint":{"$octo_slot":"resource_hint"}},"space_header_set":true,"summary":"Create a shared-space invite (admin+)"}{"base_url_env":"OCTO_API_BASE_URL","description":"Add a member"id":"worervice":"{"const},"summary":"Group tasks"}package client

