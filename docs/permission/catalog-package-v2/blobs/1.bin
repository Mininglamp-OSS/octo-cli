tag":"831dfd8fc808"},"space_header_set":true,"strict_request_schema":true,"summary":"Insert columns after an existing spreadsheet column (needs writer)"}{"base_url_env":"OCTO_API_BASE_URL","description":"Returns "id> doc + sheet maps), 'board' (whiteboard -> scene), or 'ppt' (html_ppt -> ervice":"docs","space_header_set":true,"summary":"Read a version's decoded content snapshot (read-only preview; needs reader)"}{"allowed_token_kinds":["user_key","user_bot","app_bot"],"base_urscope=all (defa},"space_header_set":true,"summary":"List recycle-bin entries the caller may see"}{"base_urReturn an elem"id":"html.diff","method":"GET","parameters":[{"description":"Document reference returned as data.slug: canonical doc_id for a new document, or the retained legacy slug for an old document.","in":"path","name":"doc_id","required":true,"type":"string"},{"description":"Base published version.","in":"query","name":"from","required":true,"type":"integer"},{"description":"Target published version.","in":"query","name":"to","required":true,"type":"integer"}],"path":"/docs-html/v1/docs/{doc_id}/diff","response_schema":{"properties":{"changes":{"items":{"properties":{"after_aid":{"type":"string"},"after_html":{"type":"string"},"after_path":{"type":"string"},"before_aid":{"type":"string"},"before_html":{"type":"string"},"before_path":{"type":"string"},"dom_path":{"type":"string"},"kind":{"enum":["added","removed","modified"],"type":"string"}},"type":"object"},"type":"array"},"code_hunks":{"items":{"properties":{"lines":{"items":{"type":"string"},"type":"array"},"new_lines":{"type":"integer"},"new_start":{"type":"integer"},"old_lines":{"type":"integer"},"old_start":{"type":"integer"}},"type":"object"},"type":"array"},"from":{"type":"integer"},"summary":{"properties":{"added":{"type":"integer"},"modified":{"type":"integer"},"removed":{"type":"integer"}},"type":"object"},"to":{"type":"integer"},"truncated":{"type":"boolean"}},"type":"object"},"response_unwrap":"data","risk":"read","schema_fingerprint":"sha256:684b8b1bc8db61f2","serCompare two published versions of a document (needs reader)"}{"allowed_token_kinds":["user_key","user_bot","app_bot"],"base_ur"id":"drivice":"drive","skill":{"name":"octo-drive","resource_uri":"octo://skills/octo-drive/SKILL.md","summary":"Octo Drive: spaces, folders, upload/download, doc mounts, share links, invites, IM-attachment transfer.","level":"recommended","etag":"1896bcb730a8"},"space_header_set":true,"summary":"Mount an online document after checking the caller's docs-backend admin role"}{"base_url_env":"OCTO_API_BASE_URL","},"required":["data"],"type":"object"},"risk":"write","service":"loop","skill":{"name":"octo-loop","resource_uri":"octo://skills/octo-loop/SKILL.md","summary":"Octo Loop control plane: tasks, comments, metadata, projects, labels; dispatch to experts and expert-teams.","level":"recommended","etag":"30874f4e8195","hint":{"$octo_slot":"resource_hint"}},"space_header_set":true,"summary":"Update autopilot trigger"}package cmd

import (
	"encoding/json"
	"errors"
	"fmt"
	"net/http"
	"net/url"

	"github.com/spf13/cobra"

	"github.com/Mininglamp-OSS/octo-cli/internal/client"
	"github.com/Mininglamp-OSS/octo-cli/internal/cmdutil"
)

type sceneSnapshot struct {
	Elements    []map[string]any `json:"elements"`
	Files       map[string]any   `json:"files"`
	AppState    map[string]any   `json:"appState"`
	BaseVersion string           `json:"baseVersion"`
}

func commandAt(root *cobra.Command, names ...string) *cobra.Command {
	current := root
	for _, name := range names {
		var next *cobra.Command
		for _, child := range current.Commands() {
			if child.Name() == name {
				next = child
				break
			}
		}
		if next == nil {
			return nil
		}
		current = next
	}
	return current
}

func getScene(cmd *cobra.Command, f *cmdutil.Factory, docID string) (*sceneSnapshot, error) {
	path, err := scenePath(docID)
	if err != nil {
		return nil, err
	}
	cfg, err := f.Config()
	if err != nil {
		return nil, err
	}
	cred, err := f.Credential()
	if err != nil {
		return nil, err
	}
	var options client.Options
	if f.Globals != nil {
		options.NoRetry = f.Globals.NoRetry
		options.Timeout = f.Globals.Timeout
		options.Verbose = f.Globals.Verbose
	}
	options.ErrOut = f.ErrOut()
	readClient := client.New(cfg, cred, options)
	raw, err := readClient.Do(cmd.Context(), &client.Request{
		Method:              http.MethodGet,
		Path:                path,
		SuppressSpaceHeader: true,
	})
	if err != nil {
		return nil, err
	}
	var snapshot sceneSnapshot
	if err := json.Unmarshal(raw, &snapshot); err != nil {
		return nil, fmt.Errorf("decode scene: %w", err)
	}
	if snapshot.BaseVersion == "" {
		return nil, errors.New("scene response has no baseVersion")
	}
	if err := checkDuplicateLiveSceneIDs(snapshot.Elements); err != nil {
		return nil, err
	}
	if snapshot.Files == nil {
		snapshot.Files = map[string]any{}
	}
	if snapshot.AppState == nil {
		snapshot.AppState = map[string]any{}
	}
	return &snapshot, nil
}

func opaquePathSegment(value, name string) (string, error) {
	if value == "" {
		return "", fmt.Errorf("%s must not be empty", name)
	}
	if value == "." || value == ".." {
		return "", fmt.Errorf("%s must not be a dot path segment", name)
	}
	return url.PathEscape(value), nil
}

func scenePath(docID string) (string, error) {
	segment, err := opaquePathSegment(docID, "docId")
	if err != nil {
		return "", err
	}
	return "/v1/bot/docs/" + segment + "/scene", nil
}

func cloneMap(in map[string]any) map[string]any {
	out := make(map[string]any, len(in))
	for key, value := range in {
		out[key] = value
	}
	return out
}

func checkDuplicateLiveSceneIDs(elements []map[string]any) error {
	seen := make(map[string]bool, len(elements))
	for _, element := range elements {
		if element["isDeleted"] == true {
			continue
		}
		id, ok := element["id"].(stri