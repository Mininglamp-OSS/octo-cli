        "x-octo-binary-response": true,
        "parameters": [
          { "name": "path", "in": "path", "required": true, "schema": { "type": "string" }, "description": "storage key path (URL-encoded)" },
          { "name": "filename", "in": "query", "schema": { "type": "string" }, "description": "Override the filename used to generate the download URL." }
        ],
        "responses": { "302": { "description": "Redirect to presigned URL" } }
      }
