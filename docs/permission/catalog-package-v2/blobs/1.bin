import (
	"encoding/json"
	"io"
	"net/url"
	"strings"

	"github.com/spf13/cobra"

	"github.com/Mininglamp-OSS/octo-cli/internal/output"
	"github.com/Mininglamp-OSS/octo-cli/internal/registry"
)

// Reuse the generated operations so aliases retain workspace scope, validation,
// risk handling and public API routing.
func attachLoopProjectAliases(loop *cobra.Command) {
	project := findChild(loop, "project")
	if project == nil {
		return
	}
	resources := findChild(project, "resource")
	if resources == nil {
		return
	}
	for _, pair := range [][2]string{{"create", "add"}, {"delete", "remove"}} {
		if command := findChild(resources, pair[0]); command != nil {
			command.Aliases = []string{pair[1]}
		}
	}
}

func registerLoopProjectFlags(cmd *cobra.Command, d *registry.OperationDetail) {
	if d.Service != "loop" {
		return
	}
	switch d.ID {
	case "task.create", "task.update", "task.quick_create", "autopilot.create", "autopilot.update", "task.list", "task.group":
		description := "Loop project UUID within --workspace-id; alias for --project-id (not a workspace selector)"
		if d.ID == "task.update" || d.ID == "autopilot.update" {
			description += "; an empty value clears the association"
		}
		cmd.Flags().String("project", "", description)
	case "project.resource.create", "project.resource.update":
		cmd.Flags().String("ref", "", "Complete resource_ref JSON object; do not combine with resource_ref in --data")
	}
}

func applyLoopProjectQuery(cmd *cobra.Command, rt *operationRuntime, query url.Values) *output.ExitError {
	if rt.detail.Service != "loop" || (rt.detail.ID != "task.list" && rt.detail.ID != "task.group") {
		return nil
	}
	if cmd.Flags().Changed("project") {
		if query.Has("project_id") || query.Has("project_ids") {
			return output.ErrValidation("--project cannot be combined with --project-id or --project-ids", "use one project selector")
		}
		query.Set("project_id", cmd.Flags().Lookup("project").Value.String())
	}
	if query.Has("project_id") && query.Has("project_ids") {
		return output.ErrValidation("--project-id and --project-ids are mutually exclusive", "use --project-ids for multiple projects")
	}
	for _, key := range []string{"project_id", "project_ids"} {
		if query.Has(key) && strings.TrimSpace(query.Get(key)) == "" {
			return output.ErrValidation("project selector is empty", "use --include-no-project to select tasks without a project")
		}
	}
	return nil
}

func applyLoopProjectBody(cmd *cobra.Command, rt *operationRuntime, body map[string]any) error {
	if rt.detail.Service != "loop" {
		return nil
	}
	switch rt.detail.ID {
	case "task.create", "task.update", "task.quick_create", "autopilot.create", "autopilot.update":
		return applyProjectAssociation(cmd, rt.detail.ID, body)
	case "project.create", "project.update":
		_, hasID := body["lead_id"]
		_, hasUID := body["lead_octo_uid"]
		if hasID && hasUID {
			return output.ErrValidation("lead_id and lead_octo_uid are mutually exclusive", "use one lead identity field")
		}
	case "project.resource.create", "project.resource.update":
		return applyProjectResourceRef(cmd, body)
	}
	return nil
}

func applyProjectAssociation(cmd *cobra.Command, operation string, body map[string]any) error {
	if !cmd.Flags().Changed("project") {
		return nil
	}
	if _, exists := body["project_id"]; exists {
		return output.ErrValidation("--project cannot be combined with project_id", "use --project, --project-id or project_id in --data")
	}
	value := cmd.Flags().Lookup("project").Value.String()
	if value != "" {
		body["project_id"] = value
		return nil
	}
	if operation != "task.update" && operation != "autopilot.update" {
		return output.ErrValidation("--project is empty", "omit --project when creating without a project")
	}
	body["project_id"] = nil
	return nil
}

func applyProjectResourceRef(cmd *cobra.Command, body map[string]any) error {
	if !cmd.Flags().Changed("ref") {
		return nil
	}
	if _, exists := body["resource_ref"]; exists {
		return output.ErrValidation("--ref cannot be combined with resource_ref in --data", "use one resource reference input")
	}
	var ref map[string]any
	decoder := json.NewDecoder(strings.NewReader(cmd.Flags().Lookup("ref").Value.String()))
	decoder.UseNumber()
	if err := decoder.Decode(&ref); err != nil || ref == nil {
		return output.ErrValidation("--ref must be a JSON object", "use --ref '{\"url\":\"https://github.com/org/repo\"}' or --data")
	}
	if err := decoder.Decode(new(any)); err != io.EOF {
		return output.ErrValidation("--ref must contain one JSON object", "remove trailing JSON or text")
	}
	body["resource_ref"] = ref
	return nil
}
# octo-docs — Document body (`doc_type: doc`)

Read this when the target is a **rich-text document** (`doc_type: doc`) and you
need to read or edit its live body. Only `doc_type: doc` bodies are editable this
way; a **spreadsheet** (`sheet`) uses `sheet.md` and a **whiteboard** (`board`)
uses `board.md` — both return `409 unsupported_doc_type` from `content`.

> **Import warning:** `docs import` with a `.md`, `.markdown`, or `.docx` file atomically replaces existing document content; it does not apply the incremental ops below. `.excalidraw` board imports use a different contract and default to merge; see `board.md`.

Read the live body and its base-version token, then apply a batch of incremental
block ops guarded by that token. A newly-created doc is **empty** — seed its text
with a first `docs content edit`.

```bash
# Read the LIVE body + baseVersion (reader). Response:
#   { docId, doc: <ProseMirror JSON>, schemaVersion, baseVersion }
octo-cli docs content get <docId>

# Apply an incremental edit (writer). --base-version is REQUIRED and is sent as
# the If-Match header; the request body is a JSON object with a required "ops" array.
octo-cli docs content edit <docId> --base-version "<token>" --data @ops.json

# Export the rendered document. The output extension must match the format.
octo-cli docs export <docId> --export-format md -o document.md
octo-cli docs export <docId> --export-format docx -o document.docx
octo-cli docs export <docId> --export-format pdf -o document.pdf
```

Ops are addressed by **block path** (child indices from the doc root) and come
in three shapes — this is not a whole-body replace:

- `insert` — `{"type":"insert","at":{"path":[i,...],"position":"before|after|inside_start|inside_end"},"content":[<block nodes>]}`. Use `path: []` with `inside_start`/`inside_end` to write the first block of an empty doc.
- `replace` — `{"type":"replace","range":{"from":{"path":[...]},"to":{"path":[...]}},"content":[<block nodes>]}`
- `delete` — `{"type":"delete","range":{"from":{"path":[...]},"to":{"path":[...]}}}`

Range endpoints must share a parent. Each op may carry `"expect":{"type":"<nodeType>"}` to assert the addressed node type. On success the response returns a **new** `baseVersion` — use it for the next edit.

## Worked example: read, then append a paragraph

```bash
# 1. Read the current body and capture the base version.
BV=$(octo-cli docs content get d_123 --format json | jq -r '.data.baseVersion')

# 2. Append a paragraph at the end of the doc, guarded by that base version.
octo-cli docs content edit d_123 --base-version "$BV" --data '{
  "ops": [
    {
      "type": "insert",
      "at": { "path": [], "position": "inside_end" },
      "content": [
        { "type": "paragraph", "content": [ { "type": "text", "text": "Appended by the bot." } ] }
      ]
    }
  ]
}'
```

**Concurrency / errors.** The base version is optimistic-concurrency: if the
live body changed since your `docs content get`, the edit is rejected with
`412 base_version_stale` — re-read to get a fresh token and rebuild your ops.
Other backend gates surface unchanged: `409 unsupported_doc_type` (target is a
board/whiteboard/sheet), `413 too_many_ops` / `413 op_content_too_large` /
`413 doc_too_large` (size caps), `400 path_too_deep` or `400 invalid_body`
(missing base version or malformed shape), and `422` for a bad anchor
(`anchor_not_found` / `anchor_mismatch`), invalid ops (`invalid_ops`), an
attachment that is not this doc's (`attachment_not_found`), or content the
schema rejects (`schema_incompatible`).

## Image nodes

Do not write a third-party image URL as the image node's only `src`: the Octo
client rejects off-whitelist asset hosts and displays **Image unavailable**.
First upload local bytes or ingest a public HTTP(S) URL into the target document
as described in `common.md` (Attachments), then use the returned document-scoped
`attachId` in the body edit:

```json
{
  "type": "insert",
  "at": { "path": [], "position": "inside_end" },
  "content": [
    {
      "type": "image",
      "attrs": {
        "attachId": "att_xxx",
        "width": 300,
        "alt": "Diagram"
      }
    }
  ]
}
```

The durable reference is `attachId`; omit `src` (or set it to `null`) so the
client resolves a fresh signed display URL. Supply the real positive pixel width
when known; otherwise use `300` as a compatibility default because current
clients can lay out an agent-created image with `width: null` as `0x0`.

## Schema lookup

```bash
octo-cli schema docs.content.get
octo-cli schema docs.content.edit
```
