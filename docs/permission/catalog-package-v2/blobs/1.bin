only: opaque base64 anchor start; accepts a Yjs editor position, sheet cell key, or canonical versioned Board anchor","type":"string"},"anchorText":{"description":"root only: the exact selected text; the backend resolves it to an anchor. Use instead of anchorStart/anchorEnd when you have no live editor positions (e.g. a bot)","type":"string"},"blockPath":{"description":"root only: disambiguate anchorText by block, as a comma-separated child-index path from the doc root (e.g. 0,2)","type":"string"},"body":{"description":"comment text","type":"string"},"occurrence":{"description":"root only: disambiguate anchorText by picking the Nth match (1-based) among the remaining candidates","type":"integer"},"parentId":{"description":"thread root id to reply to (omit for a root comment)","type":"integer"}},"required":["body"],"type":"object"},"request_body_required":true,"risk":"write","schema_fingerprint":"sha256:8f1536afb662ee34","service":"docs","skill":{"name":"octo-docs","resource_uri":"octo://skills/octo-docs/SKILL.md","summary":"Docs, sheets, whiteboards, and PPT: create and govern, members and sharing, comments and versions.","section":"common.md","reference_uri":"octo://skills/octo-docs/common.md","level":"recommended","etag":"831dfd8fc808","hint":{"$octo_slot":"resource_hint"}},"space_header_set":true,"summary":"Add an anchored root or reply (commenter or higher)"}{"base_url_env":"OCTO_API_BASE_URL","description":"Returns one workspace-scoped page of autopilots.","id":"autopilot.list","method":"GEFilter autopilots by lifecycle status.","in":"query","name":"status","type":"string"}],"path":"/fleet/api/v1/autopilots","response_schema":{"additional_properties":false,"properties":{"data":{"items":{"addition,"type":"array"},"pagination":{"properties":{"page":{"minimum":1,"type":"integer"},"page_size":{"maximum":100,"minimum":1,"type":"integer"},"total":{"minimum":0,"type":"integer"}},"required":["total","page","page_size"],"type":"object"}},"required":["data","pagination"],"type":"object"},"risk":"read","service":"loop","skill":{"name":"octo-loop","resource_uri":"octo://skills/octo-loop/SKILL.md","summary":"Octo Loop control plane: tasks, comments, metadata, projects, labels; dispatch to experts and expert-teams.","level":"recommended","etag":"30874f4e8195","hint":{"$octo_slot":"resource_hint"}},"space_header_set":true,"summary":"List autopilots"}// Package mcp implements the octo-cli MCP (Model Context Protocol) server: a
// thin JSON-RPC transport layer over the existing metadata-driven engine.
//
// The server exposes three meta-tools — search_ops, describe_op, call_op —
// rather than one MCP tool per operation, so a client's tools/list stays a few
// hundred tokens instead of the ~60k-150k tokens a full 342-operation expansion
// would cost. search_ops and describe_op read the registry directly; call_op
// drives the generated cobra command tree in-process so every request reuses
// the CLI's identity routing, request assembly, validation, transport, secret
// masking, and JSON envelope unchanged (no second copy of parameter truth).
//
// Skill navigation (which business Skill to read for an operation) rides in the
// tool *return values*, never in the constant tool inputSchema, so it adds zero
// resident context. The service->Skill and operation->advice mapping is built
// from each SKILL.md's frontmatter `services:` line plus skills/manifest.json,
// merged and validated fail-fast at startup.
package mcp

import (
	"encoding/json"
	"errors"
	"time"

	"github.com/Mininglamp-OSS/octo-cli/internal/foldkey"
)

// JSON-RPC 2.0 wire types. MCP is JSON-RPC 2.0 over stdio (newline-delimited)
// or HTTP (JSON-RPC over POST).

const jsonrpcVersion = "2.0"

// rpcRequest is an inbound JSON-RPC request or notification. A notification has
// no id; requests carry one that must be echoed on the response.
type rpcRequest struct {
	receivedAt time.Time
	Jsonrpc    string          `json:"jsonrpc"`
	ID         json.RawMessage `json:"id,omitempty"`
	Method     string          `json:"method"`
	Params     json.RawMessage `json:"params,omitempty"`
}

// decodeRPCRequest rejects repeated logical members before they can overwrite
// one another. Both transports cap raw at 8 MiB. Key escapes are decoded and
// nested values retain their original JSON without repeated grammar scans.
// Keep the existing decoder's case aliases, extension fields and shape rules.
func decodeRPCRequest(raw []byte, req *rpcRequest) error {
	req.receivedAt = time.Now()
	if !isJSONObject(raw) {
		return json.Unmarshal(raw, req)
	}
	seen := map[string]bool{}
	return visitObjectMembers(raw, func(key string, value json.RawMessage) error {
		switch folded := foldkey.Key(key); folded {
		case "JSONRPC", "ID", "METHOD", "PARAMS":
			key = folded
		}
		if seen[key] {
			return errors.New("duplicate JSON-RPC envelope member")
		}
		seen[key] = true
		switch key {
		case "JSONRPC":
			return json.Unmarshal(value, &req.Jsonrpc)
		case "ID":
			req.ID = value
		case "METHOD":
			return json.Unmarshal(value, &req.Method)
		case "PARAMS":
			req.Params = value
		}
		return nil
	})
}

// isNotification reports whether the message omits an id (JSON-RPC
// notifications get no response).
func (r *rpcRequest) isNotification() bool {
	return len(r.ID) == 0
}

// rpcResponse is an outbound JSON-RPC response. Exactly one of Result / Error
// is set.
type rpcResponse struct {
	Jsonrpc string          `json:"jsonrpc"`
	ID      json.RawMessage `json:"id,omitempty"`
	Result  json.RawMessage `json:"result,omitempty"`
	Error   *rpcError       `json:"error,omitempty"`
}

// rpcError is the JSON-RPC error object.
type rpcError struct {
	Code    int    `json:"code"`
	Message string `json:"message"`
	Data    any    `json:"data,omitempty"`
}

// Standard JSON-RPC error codes (JSON-RPC 2.0 spec).
const (
	codeParseError     = -32700
	codeInvalidRequest = -32600
	codeMethodNotFound = -32601
	codeInvalidParams  = -32602
	codeInternalError  = -32603
)

func newResultResponse(id json.RawMessage, result any) rpcResponse {
	raw, err := json.Marshal(result)
	if err != nil {
		return newErrorResponse(id, codeInternalError, "marshal result: "+err.Error())
	}
	return rpcResponse{Jsonrpc: jsonrpcVersion, ID: id, Result: raw}
}

func newErrorResponse(id json.RawMessage, code int, message string) rpcResponse {
	if len(id) == 0 {
		id = json.RawMessage("null")
	}
	return rpcResponse{
		Jsonrpc: jsonrpcVersion,
		ID:      id,
		Error:   &rpcError{Code: code, Message: message},
	}
}
