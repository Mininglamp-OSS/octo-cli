gnee_id","required":false,"type":"string"},{"in":"query","name":"assignee_ids","required":false,"type":"string"},{"in":"query","name":"assignee_octo_uid","required":false,"type":"string"},{"in":"query","name":"assignee_octo_uids","required":false,"type":"string"},{"in":"query","name":"assignee_filters","required":false,"type":"string"},{"in":"query","name":"creator_id","required":false,"type":"string"},{"in":"query","name":"creator_ids","required":false,"type":"string"},{"in":"query","name":"creator_octo_uid","required":false,"type":"string"},{"in":"query","name":"creator_octo_uids","required":false,"type":"string"},{"in":"query","name":"creator_filters","required":false,"type":"string"},{"in":"query","name":"label_ids","required":false,"type":"string"},{"in":"query","name":"include_no_assignee","required":false,"type":"boolean"},{"in":"query","name":"involves_user_id","required":false,"type":"string"},{"in":"query","name":"metadata","required":false,"type":"string"},{"enum":["created_at","updated_at"],"in":"query","name":"date_field","required":false,"type":"string"},{"in":"query","name":"date_start","required":false,"type":"string"},{"in":"query","name":"date_end","required":false,"type":"string"},{"enum":["position","title","created_at","start_date","due_date","priority"],"in":"query","name":"sort","required":false,"type":"string"},{"in":"query","name":"direction","required":false,"type":"string"},{"enum":["assignee"],"in":"query","name":"group_by","required":false,"type":"string"},{"enum":["none","member","expert","expert_team"],"in":"query","name":"group_assignee_type","required":false,"type":"string"},{"in":"query","name":"group_assignee_id","required":false,"type":"string"},{"in":"query","name":"project_id","required":false,"type":"string"},{"in":"query","name":"project_ids","required":false,"type":"string"},{"in":"query","name":"include_no_project","required":false,"type":"boolean"}],"path":"/fleet/api/v1/tasks/_grouped","risk":"read","schema_fingerprint":"sha256:8e793fc6dfd97c38","service":"loop","skill":{"name":"octo-loop","resource_uri":"octo://skills/octo-loop/SKILL.md","summary":"Octo Loop control plane: tasks, comments, metadata, projects, labels; dispatch to experts and expert-teams.","level":"recommended","etag":"30874f4e8195","hint":{"$octo_slot":"resource_hint"}},"summary":"Group tasks"}{
  "openapi": "3.1.0",
  "info": {
    "title": "Octo Bot Event API",
    "version": "1.0.0",
    "description": "Bot event queue endpoints under dmworkim /v1/bot. Events are held in a Redis sorted set until ACK'd."
  },
  "x-octo-service": "event",
  "x-octo-base-url": "OCTO_API_BASE_URL",
  "x-octo-space-header": false,
  "paths": {
    "/v1/bot/events": {
      "post": {
        "operationId": "event.list",
        "summary": "Poll pending events (server-side cursor by event_id)",
        "description": "Uses POST despite being a read; event_id cursor, limit, and optional wait are carried in the request body.",
        "x-octo-risk": "read",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event_id": { "type": "integer", "description": "exclusive lower bound; 0 for initial poll" },
                  "limit": { "type": "integer", "default": 20, "maximum": 100, "description": "Maximum events to return; defaults to 20 and is capped at 100." },
                  "wait": { "type": "integer", "description": "Optional server-side wait in seconds when no visible events are pending; absent or 0 polls immediately, and the server clamps the hold to 30 seconds." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event batch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "event_id": { "type": "integer" },
                          "event_type": { "type": "string" },
                          "event_data": { "type": "object" },
                          "message": {
                            "type": "object",
                            "properties": {
                              "message_id": { "type": "integer" },
                              "message_seq": { "type": "integer" },
                              "from_uid": { "type": "string" },
                              "channel_id": { "type": "string" },
                              "channel_type": { "type": "integer" },
                              "timestamp": { "type": "integer" },
                              "payload": { "type": "object" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/events/{event_id}/ack": {
      "post": {
        "operationId": "event.ack",
        "summary": "Acknowledge (remove) an event from the queue",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "event_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Acknowledged" } }
      }
    }
  }
}
