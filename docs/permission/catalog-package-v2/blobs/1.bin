)","type":"object"},"sheetDims":{"description":"document/sheet only: column-width / row-height overrides (empty {} for a text document)","type":"object"},"sheetFilters":{"description":"document/sheet only: shared filter range and criteria keyed by logicalId (empty {} for a text document)","type":"object"},"sheetFreeze":{"description":"document/sheet only: freeze panes keyed by logicalId (empty {} for a text document)","type":"object"},"sheetList":{"description":"document/sheet only: sheet tabs keyed by logicalId with {name,order,rowCount?,columnCount?}; rowCount is 1..10000 and columnCount is 1..100, with missing counts meaning a legacy 1000-row by 100-column tab. It is empty {} for a text document or a legacy single-sheet document; an empty sheetList does not mean sheetDataValidations should be filtered out","type":"object"}},"type":"object"},"risk":"read","schema_fingerprint":"sha256:7276b42957e618a9"Read a version's decoded content snapshot (read-only preview; needs reader)"}{"Applies the supplied mutable task fields.","id":"task.update","method":"PATCH","parameters":[{"description":"Stable task identifier.","format":"uuid","in":"path","name":"task_id","required":true,"type":"string"},{"description":"Workspace UUID for workspace-scoped Loop requests.","flag_name":"workspace-id","format":"uuid","in":"header","name":"X-Workspace-ID","required":true,"type":"string"}],"path":"/fleet/api/v1/tasks/{task_id}","request_body":{"min_properties":1,"properties":{"assignee_id":{"description":"Expert or expert-team UUID, or a native Workspace member user UUID with assignee_type=member. Project members use --assignee-member-id.","format":"uuid","nullable":true,"type":"string"},"assignee_octo_uid":{"description":"Exact Project member ID from the member list; pair with assignee_type=member and do not combine with assignee_id.","flag_name":"assignee-member-id","max_length":128,"min_length":1,"type":"string"},"assignee_type":{"description":"Public assignee type. Use with --assignee-id or --assignee-member-id; to clear, pass --data '{\"assignee_type\":null,\"assignee_id\":null}' or use task assign --unassign.","enum":["expert","expert_team","member",null],"nullable":true,"type":"string"},"attachment_ids":{"description":"Attachment UUIDs for the task update.","items":{"format":"uuid","type":"string"},"type":"array"},"description":{"description":"Replacement task description.","type":"string"},"due_date":{"description":"Due date in YYYY-MM-DD format; explicit null in --data clears it.","format":"date","nullable":true,"type":"string"},"handoff_note":{"description":"Optional note supplied to Fleet's handoff path for this update.","type":"string"},"parent_task_id":{"description":"Parent task UUID; explicit null in --data clears the parent.","format":"uuid","nullable":true,"type":"string"},"position":{"description":"Position for manual task ordering.","type":"number"},"priority":{"description":"Task priority.","enum":["urgent","high","medium","low","none"],"enum_hint":"Use urgent, high, medium, low, or none.","type":"string"},"project_id":{"description":"Loop project UUID in the selected workspace. Independent of --workspace-id; null clears an existing association.","format":"uuid","min_length":1,"nullable":true,"type":"string"},"start_date":{"description":"Scheduled start date in YYYY-MM-DD format; explicit null in --data clears it.","format":"date","nullable":true,"type":"string"},"status":{"description":"Move the task to a lifecycle status. in_review means the work is awaiting review.","enum":["backlog","todo","in_progress","in_review","done","blocked","cancelled"],"type":"string"},"suppress_run":{"description":"Suppress the run created by this write; this does not stop existing executions from being cancelled by reassignment.","type":"boolean"},"title":{"description":"Replacement task title.","min_length":1,"type":"string"}},"type":"object"},"request_body_required":true,"response_schema":{"properties":{"data":{"additional_properties":true,"type"