import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/Mininglamp-OSS/octo-cli/cmd/service"
	"github.com/Mininglamp-OSS/octo-cli/internal/cmdutil"
	"github.com/Mininglamp-OSS/octo-cli/internal/output"
	"github.com/Mininglamp-OSS/octo-cli/internal/registry"
)

// planUploadDryRun describes a multipart operation's planned request WITHOUT any
// filesystem or network side effect (B1): the file at file_path is never opened
// or read, its bytes never appear in the result, and the multipart body is not
// materialized. Secret-flagged form fields and parameters are masked. The
// credential and the operation's token-kind gate are resolved and the lexical
// upload policy is checked during planning; descriptor confinement and
// transport run only on a real call. The limitation is stated in the note
// rather than silently implied.
func planUploadDryRun(ctx context.Context, f *cmdutil.Factory, detail *registry.OperationDetail, args map[string]any, pol execPolicy) (envelope []byte, ok bool, exitErr *output.ExitError) {
	if err := validateMultipartDryRun(ctx, detail, args, pol); err != nil {
		ee := output.AsExitError(cmdutil.WrapCLIError(err))
		return synthErrorEnvelope(ee), false, ee
	}
	if err := service.ResolveOperationIdentity(f, detail); err != nil {
		ee := output.AsExitError(err)
		if ee == nil {
			ee = output.ErrAuth(err.Error(), "")
		}
		return synthErrorEnvelope(ee), false, ee
	}

	formFields, queryFields, headerFields, filePath := uploadPlanFields(detail, args)
	data := map[string]any{
		"dry_run": true,
		"method":  detail.Method,
		"path":    fillPathParams(detail.Path, args),
	}
	if len(queryFields) > 0 {
		data["query"] = queryFields
	}
	if len(headerFields) > 0 {
		data["headers"] = headerFields
	}
	if detail.RawBody {
		// The file is the whole body: describe its media type and limit, never
		// its bytes. Header arguments (e.g. X-Media-Type) are listed as such.
		data["raw_body"] = true
		data["content_type"] = detail.RawBodyContentType
		if detail.RawBodyMaxBytes > 0 {
			data["max_bytes"] = detail.RawBodyMaxBytes
		}
		if filePath != "" {
			data["file_path"] = filePath
		}
		note := "raw-body dry-run: metadata-only. The credential and token-kind gate were resolved, and required path/query/header arguments and the file binding were validated; file_path is NOT opened or read and its bytes are never returned; nothing is sent. Descriptor-based upload-root containment, the size limit, and transport are enforced only on a real (non-dry-run) call."
		data["dry_run_note"] = note
		return marshalUploadPlan(data)
	}
	data["multipart"] = true
	data["form_fields"] = formFields
	if filePath != "" {
		data["file_field"] = binaryFileField(detail)
		data["file_path"] = filePath
	}
	note := "multipart dry-run: metadata-only. The credential and token-kind gate were resolved, and required path/query/header/body fields and the multipart file binding were validated; file_path is NOT opened or read and its bytes are never returned; the multipart body is not materialized and nothing is sent. Descriptor-based upload-root containment and transport are enforced only on a real (non-dry-run) call."
	data["dry_run_note"] = note
	return marshalUploadPlan(data)
}

// uploadPlanFields classifies and masks argument values without resolving files.
func uploadPlanFields(detail *registry.OperationDetail, args map[string]any) (formFields, queryFields, headerFields map[string]any, filePath string) {
	pathSet := map[string]bool{}
	for _, n := range extractPathParams(detail.Path) {
		pathSet[n] = true
	}
	params := map[string]*registry.ParamInfo{}
	for i := range detail.Parameters {
		if p := &detail.Parameters[i]; p.In == "query" || p.In == "header" {
			params[p.Name] = p
		}
	}
	formFields = map[string]any{}
	queryFields = map[string]any{}
	headerFields = map[string]any{}
	for _, k := range sortedKeys(args) {
		if k == "file_path" {
			filePath = fmt.Sprint(args[k]) // the PATH string only; contents are never read
			continue
		}
		if pathSet[k] || k == "page_all" {
			continue
		}
		v := args[k]
		if p := params[k]; p != nil {
			if v == nil {
				continue // a null query/header argument is omitted, as on a real call
			}
			if p.Secret {
				v = "***"
			}
			if p.In == "query" {
				queryFields[k] = v
			} else {
				headerFields[k] = v
			}
			continue
		}
		if detail.RequestBody != nil {
			prop := detail.RequestBody.Properties[k]
			if registry.RequestSensitive(prop.Secret, prop.WriteOnly) {
				v = "***"
			}
		}
		formFields[k] = v
	}
	return formFields, queryFields, headerFields, filePath
}

func marshalUploadPlan(data map[string]any) (envelope []byte, ok bool, exitErr *output.ExitError) {
	raw, err := json.Marshal(map[string]any{"ok": true, "data": data})
	if err != nil {
		ee := output.ErrValidation("encode upload plan: "+err.Error(), "")
		return synthErrorEnvelope(ee), false, ee
	}
	return raw, true, nil
}
{"base_url_env":"OCTO_API_BASE_URL",ervice":"loop","skill":{"name":"octo-loop","resource_uri":"octo://skills/octo-loop/SKILL.md","summary":"Octo Loop control plane: tasks, comments, metadata, projects, labels; dispatch to experts and expert-teams.","level":"recommended","etag":"30874f4e8195","hint":{"$octo_slot":"resource_hint"}},"space_header_set":true,"summary":"Update autopilot"}package mcp

import (
	"context"
	"encoding/json"
	"io"
	"net/http"
	"strconv"
	"strings"
	"time"

	"github.com/Mininglamp-OSS/octo-cli/internal/client"
	"github.com/Mininglamp-OSS/octo-cli/internal/cmdutil"
	"github.com/Mininglamp-OSS/octo-cli/internal/config"
	"github.com/Mininglamp-OSS/octo-cli/internal/credential"
	"github.com/Mininglamp-OSS/octo-cli/internal/output"
)

type admissionError struct {
	code   int
	reason string
}

func (e *admissionError) Error() string              { return e.reason }
func admissionFailure(code int, reason string) error { return &admissionError{code, reason} }
func policyFailure() error                           { return admissionFailure(-32003, "POLICY_UNAVAILABLE") }
func validMode(s string) bool                        { return s == "strict" || s == "compatible" }

func parsePolicy(raw json.RawMessage) (string, error) { //nolint:gocyclo // validate each policy algebra invariant without defaulting malformed fields
	p, err := strictObject(raw, "version", "context_mode", "override", "stage_default", "source", "generation", "bot_revision")
	if err != nil {
		return "", policyFailure()
	}
	var mode, stage, source, generation string
	for k, dst := range map[string]*string{"context_mode": &mode, "stage_default": &stage, "source": &source, "generation": &generation} {
		if json.Unmarshal(p[k], dst) != nil {
			return "", policyFailure()
		}
	}
	if string(p["version"]) != "1" || !validMode(mode) || !validMode(stage) || !positiveDecimal(generation, 64) {
		return "", policyFailure()
	}
	switch source {
	case "stage_default":
		if string(p["override"]) != "null" || string(p["bot_revision"]) != "null" || mode != stage {
			return "", policyFailure()
		}
	case "bot":
		var override, revision string
		if json.Unmarshal(p["override"], &override) != nil || json.Unmarshal(p["bot_revision"], &revision) != nil || !validMode(override) || override != mode || !positiveDecimal(revision, 64) {
			return "", policyFailure()
		}
		g, ge := strconv.ParseUint(generation, 10, 64)
		r, re := strconv.ParseUint(revision, 10, 64)
		if ge != nil || re != nil {
			return "", policyFailure()
		}
		if r > g {
			return "", policyFailure()
		}
	default:
		return "", policyFailure()
	}
	return mode, nil
}

// verifyMCPBot uses one bounded, read-only verification. No registration,
// identity cache, policy cache, retry, verbose output, or fallback is involved.
func verifyMCPBot(ctx context.Context, f *cmdutil.Factory, requestPolicy bool) (uid, origin, mode string, err error) { //nolint:gocyclo // one bounded verification maps distinct auth, transport and policy failures
	bot, e := f.Credential()
	if e != nil || bot == nil || bot.Token == "" {
		err = admissionFailure(-32001, "BOT_AUTH_REQUIRED")
		return
	}
	if !strings.HasPrefix(bot.Token, "bf_") {
		err = admissionFailure(-32001, "BOT_CREDENTIAL_UNSUPPORTED")
		return
	}
	cfg, e := f.Config()
	if e != nil || cfg == nil {
		err = admissionFailure(-32002, "BOT_VERIFICATION_UNAVAILABLE")
		return
	}
	origin, e = config.NormalizeAPIBaseURL(cfg.APIBaseURL)
	if e != nil {
		err = admissionFailure(-32002, "BOT_VERIFICATION_UNAVAILABLE")
		return
	}
	cc, bc := *cfg, *bot
	cc.APIBaseURL = origin
	f.ConfigFunc = func() (*config.Config, error) { c := cc; return &c, nil }
	f.CredentialFunc = func() (*credential.BotCredential, error) { c := bc; return &c, nil }
	body := map[string]any{"bot_token": bc.Token}
	if requestPolicy {
		body["include_mcp_policy"] = true
	}
	vctx, cancel := context.WithTimeout(ctx, 3*time.Second)
	defer cancel()
	c := client.New(&cc, &bc, client.Options{Timeout: "3s", NoRetry: true, ErrOut: io.Discard})
	raw, e := c.Do(vctx, &client.Request{Method: http.MethodPost, Path: "/v1/auth/verify-bot", Body: body, DisableRetry: true, SuppressSpaceHeader: true, SecretValues: []string{bc.Token}, SensitiveJSONFields: []string{"bot_token"}, MaxResponseBytes: 16 << 10})
	if e != nil {
		err = admissionFailure(-32002, "BOT_VERIFICATION_UNAVAILABLE")
		if ee := output.AsExitError(e); ee != nil {
			if ee.HTTPStatus == 401 || ee.Code == "HTTP_401" || ee.Code == "AUTH_ERROR" {
				err = admissionFailure(-32001, "BOT_AUTH_INVALID")
			}
			if ee.Code == "err.server.mcp.policy_unavailable" {
				err = policyFailure()
			}
		}
		return
	}
	p, e := strictObject(raw)
	if e != nil {
		err = admissionFailure(-32002, "BOT_VERIFICATION_UNAVAILABLE")
		return
	}
	if json.Unmarshal(p["bot_uid"], &uid) != nil || !validID(uid, 40) || strings.Contains(uid, bc.Token) {
		err = admissionFailure(-32002, "BOT_VERIFICATION_UNAVAILABLE")
		return
	}
	if e = f.BindVerifiedBotIdentity(bc.Token, origin, uid); e != nil {
		err = admissionFailure(-32001, "BOT_AUTH_INVALID")
		return
	}
	if requestPolicy {
		mode, err = parsePolicy(p["mcp_policy"])
	}
	return
}
