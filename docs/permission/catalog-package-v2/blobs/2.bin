ng)
		if !ok || id == "" {
			return errors.New("scene contains a live element with an invalid id")
		}
		if seen[id] {
			return fmt.Errorf("scene contains duplicate live element id %q", id)
		}
		seen[id] = true
	}
	return nil
}
