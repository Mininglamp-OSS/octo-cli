{
  "openapi": "3.1.0",
  "info": {
    "title": "Octo Bot Identity API",
    "version": "1.0.0",
    "description": "Bot registration, metadata and presence endpoints under dmworkim /v1/bot."
  },
  "x-octo-service": "bot",
  "x-octo-base-url": "OCTO_API_BASE_URL",
  "x-octo-space-header": false,
  "paths": {
    "/v1/bot/register": {
      "post": {
        "operationId": "bot.register",
        "summary": "Register (authenticate) the bot and obtain IM token + URLs",
        "description": "Routes by token prefix: app_* → App Bot, bf_* → User Bot. Agent runtime metadata is persisted only for User Bots; App Bots ignore it.",
        "x-octo-risk": "write",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agent_platform": { "type": "string", "description": "Agent platform name reported during User Bot registration." },
                  "agent_version": { "type": "string", "description": "Agent version reported during User Bot registration." },
                  "plugin_version": { "type": "string", "description": "Plugin version reported during User Bot registration." },
                  "agent_hosting": {
                    "type": "string",
                    "x-octo-flag": "agent-hosting",
                    "description": "User Bot runtime-hosting metadata, normalized to a lowercase ASCII slug of at most 64 bytes (first character a-z, followed by a-z, digits, or _). Open vocabulary, not an enum. \"none\" retracts the marker; omitted or empty means unchanged. Invalid metadata is ignored without failing registration. App Bots do not persist agent metadata."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bot identity + connection info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "robot_id": { "type": "string" },
                    "name": { "type": "string" },
                    "im_token": { "type": "string" },
                    "ws_url": { "type": "string" },
                    "api_url": { "type": "string" },
                    "owner_uid": { "type": "string" },
                    "owner_channel_id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/setCommands": {
      "post": {
        "operationId": "bot.set-commands",
        "summary": "Publish the bot's command list",
        "x-octo-risk": "write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["commands"],
                "properties": {
                  "commands": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "command": { "type": "string" },
                        "description": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Saved" } }
      }
    },
    "/v1/bot/user/info": {
      "get": {
        "operationId": "bot.user-info",
        "summary": "Look up a user by UID",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "uid", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "User info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uid": { "type": "string" },
                    "name": { "type": "string" },
                    "avatar": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/space/members": {
      "get": {
        "operationId": "bot.space-members",
        "summary": "List members of the bot's space",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "keyword", "in": "query", "schema": { "type": "string" }, "description": "optional LIKE filter on name" },
          { "name": "space_id", "in": "query", "schema": { "type": "string" }, "description": "override space (defaults to bot's space)" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50, "maximum": 200 }, "description": "Maximum members per page; defaults to 50 and the backend caps it at 200." },
          { "name": "page", "in": "query", "x-octo-flag": "page", "schema": { "type": "integer", "default": 1, "minimum": 1, "maximum": 1000000 }, "description": "1-based page number; defaults to 1. The backend caps page at 1,000,000." }
        ],
        "responses": {
          "200": {
            "description": "Members",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "uid": { "type": "string" },
                      "name": { "type": "string" },
                      "robot": { "type": "integer" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/typing": {
      "post": {
        "operationId": "bot.typing",
        "summary": "Send a typing indicator (throttled server-side)",
        "x-octo-risk": "write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["channel_id", "channel_type"],
                "properties": {
                  "channel_id": { "type": "string" },
                  "channel_type": { "type": "integer" },
                  "on_behalf_of": { "type": "string", "description": "OBO: send the typing indicator as this user persona" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Typing sent (or throttled)" } }
      }
    },
    "/v1/bot/heartbeat": {
      "post": {
        "operationId": "bot.heartbeat",
        "summary": "Report liveness (60s TTL in Redis)",
        "x-octo-risk": "write",
        "responses": { "200": { "description": "Heartbeat recorded" } }
      }
    },
    "/v1/bot/resolve/targets": {
      "get": {
        "operationId": "bot.resolve-targets",
        "summary": "Resolve groups and threads the bot belongs to by name",
        "description": "Substring (SQL LIKE) match on group and thread names, limited to groups where the calling bot is a non-deleted group member (no space filter, so cross-space external groups are included; team container groups (purpose ai_session_container) are excluded). Threads are returned only when active or archived. An exact name match sorts first. App Bot tokens pass authentication but have no group membership, so they always resolve to an empty list.",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "name", "in": "query", "required": true, "schema": { "type": "string" }, "description": "name fragment to match (blank is rejected)" },
          { "name": "kind", "in": "query", "schema": { "type": "string", "enum": ["all", "group", "thread"], "default": "all" }, "description": "restrict candidates to groups or threads" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 50 }, "description": "per-kind cap; values above 50 are clamped, missing or non-positive values use 20" }
        ],
        "responses": {
          "200": {
            "description": "Candidate targets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "candidates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kind": { "type": "string", "enum": ["group", "thread"] },
                          "channel_id": { "type": "string", "description": "group_no for a group; thread channel id for a thread" },
                          "channel_type": { "type": "integer", "description": "2=group, 5=thread" },
                          "name": { "type": "string" },
                          "group_no": { "type": "string" },
                          "short_id": { "type": "string", "description": "thread only" },
                          "parent_name": { "type": "string", "description": "thread only: parent group name" }
                        }
                      }
                    },
                    "total": { "type": "integer" },
                    "truncated": { "type": "boolean", "description": "true when more matches exist than the limit" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/users/batch": {
      "post": {
        "operationId": "bot.users-batch",
        "summary": "Resolve minimal identity info for a batch of user UIDs",
        "description": "Returns only uid, status, name and robot flag (no contact data). uids must be non-empty, unique, at most 200 entries and at most 64 characters each; the request body is capped at 32 KiB. Space-prefixed uids (s<digits>_<uid>) are resolved by their base uid and echoed back as sent. Unknown or non-live accounts are listed in missing_uids. Protected by an always-on per-IP rate limit in addition to the bot limiter.",
        "x-octo-risk": "read",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["uids"],
                "properties": {
                  "uids": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 64 }, "description": "unique user uids (duplicates are rejected)" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved users in request order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "users": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "uid": { "type": "string" },
                          "status": { "type": "integer" },
                          "name": { "type": "string" },
                          "robot": { "type": "integer", "description": "1 when the uid is a bot" }
                        }
                      }
                    },
                    "missing_uids": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/space/principals/{uid}": {
      "get": {
        "operationId": "bot.space-principal",
        "summary": "Resolve one principal inside an explicit space (User Bot only)",
        "description": "User Bot (bf_) only; App Bot tokens are rejected. space_id is mandatory and never inferred. The space must be active, the calling bot and its creator must be eligible members of that space, and the target must be a live human member or an active User Bot whose creator is a member. Every ineligible case returns the same user-not-found error.",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "uid", "in": "path", "required": true, "schema": { "type": "string" }, "description": "target principal uid" },
          { "name": "space_id", "in": "query", "required": true, "schema": { "type": "string" }, "description": "space to resolve the principal in" }
        ],
        "responses": {
          "200": {
            "description": "Principal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uid": { "type": "string" },
                    "principal_type": { "type": "string", "enum": ["human", "user_bot"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/card/profile": {
      "get": {
        "operationId": "bot.card-profile",
        "summary": "Read the card capability manifest and the bot's effective card settings",
        "description": "Returns 200 with the full manifest even when cards are disabled; enabled reflects the deployment card switch AND OCTO_BOT_CARD_ENABLED. config is the calling bot's effective card policy; a failure to read it returns 500 rather than defaults. The response is per-bot and sent with Cache-Control: private, no-store.",
        "x-octo-risk": "read",
        "responses": {
          "200": {
            "description": "Card capability manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "card_version": { "type": "string" },
                    "profiles": { "type": "array", "items": { "type": "string" } },
                    "elements": { "type": "array", "items": { "type": "string" } },
                    "inputs": { "type": "array", "items": { "type": "string" } },
                    "actions": { "type": "array", "items": { "type": "string" } },
                    "config": {
                      "type": "object",
                      "properties": {
                        "card_enabled": { "type": "boolean" },
                        "display_enabled": { "type": "boolean" },
                        "interaction_enabled": { "type": "boolean" },
                        "reasoning_enabled": { "type": "boolean" },
                        "reasoning_template_ref": { "type": ["object", "null"] }
                      }
                    },
                    "templating": { "type": "object" },
                    "limits": {
                      "type": "object",
                      "properties": {
                        "max_payload_bytes": { "type": "integer" },
                        "max_nodes": { "type": "integer" },
                        "max_depth": { "type": "integer" },
                        "max_input_text_bytes": { "type": "integer" },
                        "max_inputs_bytes": { "type": "integer" },
                        "max_copy_text_bytes": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/obo-grant": {
      "get": {
        "operationId": "bot.obo-grant",
        "summary": "Read the active on-behalf-of grant whose grantee is the calling bot",
        "description": "The bot uid is taken from the token only. Returns 404 when the bot has no usable grant (never granted, paused, revoked or expired); treat that as no persona to apply.",
        "x-octo-risk": "read",
        "responses": {
          "200": {
            "description": "Active grant",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "grantor_uid": { "type": "string" },
                    "persona_prompt": { "type": "string" },
                    "active": { "type": "boolean" },
                    "global_enabled": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/obo-grants/self": {
      "get": {
        "operationId": "bot.obo-grants-self",
        "summary": "Read the bot's policy grant status in one space (User Bot only, advisory)",
        "description": "User Bot (bf_) only; App Bot tokens get 401. space_id is a required query parameter (exact value, no surrounding whitespace); the X-Space-Id header is not consulted. The bot user must be active, the space active, and the bot an active member of that space, otherwise 401. Returns an empty array when the bot has no owner or no grant from its owner. Advisory only; the server re-checks grants on every OBO action.",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "space_id", "in": "query", "required": true, "schema": { "type": "string" }, "description": "space the bot acts in" }
        ],
        "responses": {
          "200": {
            "description": "Grant status list (zero or one entry)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "grantor_uid": { "type": "string" },
                      "grant_state": { "type": "string", "enum": ["ACTIVE", "PAUSED", "REVOKED", "EXPIRED"] },
                      "global_enabled": { "type": "boolean" },
                      "scopes": { "type": "array", "items": { "type": "string" } },
                      "policy_version": { "type": "integer" },
                      "expires_at": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
