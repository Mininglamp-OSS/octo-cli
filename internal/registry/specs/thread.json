{
  "openapi": "3.1.0",
  "info": {
    "title": "Octo Bot Thread API",
    "version": "1.0.0",
    "description": "Thread endpoints under dmworkim /v1/bot. All thread operations are rejected for App Bot."
  },
  "x-octo-service": "thread",
  "x-octo-base-url": "OCTO_API_BASE_URL",
  "x-octo-space-header": false,
  "paths": {
    "/v1/bot/groups/{group_no}/threads": {
      "post": {
        "operationId": "thread.create",
        "summary": "Create a thread in a group (User Bot only)",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "group_no", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 100 },
                  "source_message_id": { "type": "integer", "description": "Optional source message ID to associate with the new thread." },
                  "on_behalf_of": { "type": "string", "x-octo-flag": "on-behalf-of", "description": "Optional OBO creator identity. Requires an active grant and the grantor's parent-group read access; the backend checks authorization." }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Created thread" } }
      },
      "get": {
        "operationId": "thread.list",
        "summary": "List threads in a group (User Bot only)",
        "description": "Without page_index or page_size, returns a bare array for page 1 with up to 100 threads. Supplying either parameter returns {count,list}; paged mode defaults page_index to 1 and page_size to 15, and caps page_size at 100.",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "group_no", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page_index", "in": "query", "schema": { "type": "integer" }, "description": "Page index; paged mode defaults to 1 and clamps values below 1 to 1." },
          { "name": "page_size", "in": "query", "schema": { "type": "integer" }, "description": "Page size; with no pagination parameters the unpaged response contains up to 100 items. Paged mode defaults nonpositive values to 15 and caps values at 100." }
        ],
        "responses": {
          "200": {
            "description": "Without either page query parameter, returns a bare array (page 1, size 100). Supplying either parameter returns an object with count and list.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "type": "object" } },
                    {
                      "type": "object",
                      "required": ["count", "list"],
                      "properties": {
                        "count": { "type": "integer" },
                        "list": { "type": "array", "items": { "type": "object" } }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/bot/groups/{group_no}/threads/{short_id}": {
      "get": {
        "operationId": "thread.get",
        "summary": "Get thread detail (User Bot only)",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "group_no", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "short_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Thread detail" } }
      }
    },
    "/v1/bot/groups/{group_no}/threads/{short_id}/members": {
      "get": {
        "operationId": "thread.members",
        "summary": "List thread members (User Bot only)",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "group_no", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "short_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Members" } }
      }
    },
    "/v1/bot/groups/{group_no}/threads/{short_id}/join": {
      "post": {
        "operationId": "thread.join",
        "summary": "Bot joins a thread (User Bot only)",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "group_no", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "short_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Joined" } }
      }
    },
    "/v1/bot/groups/{group_no}/threads/{short_id}/leave": {
      "post": {
        "operationId": "thread.leave",
        "summary": "Bot leaves a thread (User Bot only)",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "group_no", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "short_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Left" } }
      }
    },
    "/v1/bot/groups/{group_no}/threads/{short_id}/md": {
      "get": {
        "operationId": "thread.md-get",
        "summary": "Read thread GROUP.md (User Bot only)",
        "x-octo-risk": "read",
        "parameters": [
          { "name": "group_no", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "short_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "GROUP.md",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": { "type": "string" },
                    "version": { "type": "integer" },
                    "updated_at": { "type": "string" },
                    "updated_by": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "thread.md-update",
        "summary": "Update thread GROUP.md (User Bot only; must be bot_admin)",
        "x-octo-risk": "write",
        "parameters": [
          { "name": "group_no", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "short_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": { "content": { "type": "string", "description": "Maximum size is the configured GROUP.md byte limit (10,240 bytes in the inspected default configuration; deployments may configure another limit). Whitespace-only content is rejected." } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "version": { "type": "integer" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
