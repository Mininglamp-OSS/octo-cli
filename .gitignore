# Binary (root only)
/octo-cli
/bin/
# npm publishes the checked-in Node shim from npm/bin/, but local packaging
# smoke tests may still place generated binaries there.
!/npm/bin/
/npm/bin/octo-cli
/npm/bin/octo-cli.exe
coverage.out

